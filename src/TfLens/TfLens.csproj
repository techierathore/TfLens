<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TfLens.Core\TfLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="TrBlazeUI.Components" Version="2.0.0" />
    <PackageReference Include="TrBlazeUI.Icons.Lucide" Version="2.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Lets a developer keep the connection string and the AppManager pair on their own machine
         (dotnet user-secrets) instead of in any committed file. -->
    <UserSecretsId>tflens-dev-secrets</UserSecretsId>
  </PropertyGroup>

</Project>
