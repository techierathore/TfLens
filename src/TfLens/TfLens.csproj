<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TfLens.Core\TfLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Central logging on the VPS (runbook v5.2 Part 6). The sink is only registered when Seq__Url is
         set, so this package costs local development nothing but a few KB in the image. -->
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <!-- 2.1.0-ci.10 is the release that closes every entry in docs/TfLens-TrBlazeUI-Feedback.md
         (TR-001 … TR-035). It comes from the private TrBlazeUI feed named in nuget.config, not
         from nuget.org, which still stops at 2.0.3. Upgrading from 2.0.0 let TfLens delete the
         workarounds those entries recorded; the CHANGELOG's "Behaviour changes to review before
         upgrading" list is what the deletions were checked against. -->
    <PackageReference Include="TrBlazeUI.Components" Version="2.1.0-ci.10" />
    <PackageReference Include="TrBlazeUI.Icons.Lucide" Version="2.1.0-ci.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The LOCAL DEVELOPMENT secrets path (REQ-NFR-011, BRD-8). This id is what makes Visual
         Studio's "Manage User Secrets" and `dotnet user-secrets` write to
         %APPDATA%\Microsoft\UserSecrets\tflens-dev-secrets\secrets.json — outside the repository,
         so a real AppManager key can never be committed. `.env` is NOT read by `dotnet run`; it
         exists only for `docker compose` variable substitution at deployment time.
         Removing this id silently breaks the documented F5 path, so a guardrail test pins it
         (DeveloperOnboardingTests.UserSecretsIdIsDeclaredSoTheF5PathKeepsWorking). -->
    <UserSecretsId>tflens-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The committed template a developer copies into their own secrets.json. It is documentation,
         not configuration: it must never be published, and the app must never read it. -->
    <Content Remove="secrets.example.json" />
    <None Include="secrets.example.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
