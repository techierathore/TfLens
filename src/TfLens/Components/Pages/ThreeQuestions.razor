@*
    REQ-UI-018 / REQ-UI-019 / REQ-UI-020 / REQ-UI-021 / REQ-UI-022 — the Three questions screen.

    The page the product exists for: first-pass rate, escape rate and failures scored, read one
    project_type at a time. There is deliberately no "all" tab and no total row — the engine's
    AnalysisResult cannot express a cross-type or cross-provenance number (ADR-007), and this page adds
    nothing that would. Backfilled figures are a labelled secondary line beside the live one, never added
    to it. Every figure reaches the screen through FigureText, so a segment below n=3 renders the literal
    text `insufficient data (n=…)` rather than a flattering number.
*@
@page "/three-questions"
@using TfLens.Components.Shared.Playbook
@implements IDisposable
@inject IMetricsEngine objMetricsEngine
@inject ITelemetryStore objStore
@inject ShellPreferences objPreferences

<PageTitle>Three questions · TfLens</PageTitle>

<div class="tflens-stack">

    @* TR-013 — the Typography components do not resolve in 2.0.0, so the heading is plain markup carrying
       the library's own utility classes. *@
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Three questions</h1>
        <p class="mt-1 text-sm text-muted-foreground">@Subtitle</p>
    </div>

    @if (!IsPlaybook)
    {
        @* REQ-UI-018 — the standing note, always visible on the TechieFlow axis. The Playbook state
           carries its own standing note (PlaybookAxisNote), which states the stronger rule. *@
        <Alert Variant="AlertVariant.Info" data-testid="schema-note">
            <LucideIcon Name="info" Size="16" />
            <AlertTitle>SCHEMA.md §6</AlertTitle>
            <AlertDescription>
                Figures are never combined across project_type or across live/backfilled (SCHEMA.md §6). There is no total.
            </AlertDescription>
        </Alert>
    }

    @if (IsPlaybook)
    {
        @* REQ-UI-034 — the Playbook framework state: the standing axis note, then the three questions
           keyed by `phase_gate` with their phase totals, or the Phase-3 empty state. Every key on this
           branch is a PhaseGateKey, which has no conversion to or from the plain strings the TechieFlow
           gate members use, so the two axes cannot share a table here (SCHEMA.md §11). *@
        <PlaybookState UserId="@objUserId">
            <ChildContent Context="vAnalysis">
                <PlaybookQuestionsSurface Analysis="@vAnalysis" />
            </ChildContent>
        </PlaybookState>
    }
    else if (!objIsLoaded)
    {
        <Card>
            <CardContent Class="p-6">
                <div class="flex flex-col gap-3">
                    <Skeleton Class="h-4 w-full" />
                    <Skeleton Class="h-4 w-3/4" />
                    <Skeleton Class="h-4 w-1/2" />
                </div>
            </CardContent>
        </Card>
    }
    else if (objLoadError is not null)
    {
        <Alert Variant="AlertVariant.Danger" data-testid="three-questions-error">
            <LucideIcon Name="triangle-alert" Size="16" />
            <AlertTitle>Couldn't compute the figures</AlertTitle>
            <AlertDescription>@objLoadError</AlertDescription>
        </Alert>
    }
    else if (objTypes.Count == 0)
    {
        <Empty Title="No gate records yet"
               Description="Run *verify on a connected repo — the three questions are computed from gate records only."
               Size="EmptySize.Default"
               data-testid="three-questions-empty">
            <Icon>
                <LucideIcon Name="list-checks" Size="40" />
            </Icon>
        </Empty>
    }
    else
    {
        @* REQ-UI-018 — one tab per project_type present; there is no "all" tab. *@
        <Tabs Value="@objSelectedType" ValueChanged="OnTypeSelectedAsync" data-testid="type-tabs">
            <TabsList>
                @foreach (var vType in objTypes)
                {
                    @* TR-010 (TabsTrigger attributes) — TabsTrigger captures no unmatched attributes, so
                       the test id lives on the span it renders around; a click on the span still activates
                       the trigger. *@
                    <TabsTrigger Value="@vType">
                        <span class="flex items-center gap-2" data-testid="@($"type-tab-{vType}")">
                            <span>@LabelFor(vType)</span>
                            <Badge Variant="BadgeVariant.Secondary">@LiveOf(vType).Records</Badge>
                        </span>
                    </TabsTrigger>
                }
            </TabsList>

            @foreach (var vType in objTypes)
            {
                var vLive = LiveOf(vType);
                var vBackfilled = BackfilledOf(vType);

                <TabsContent Value="@vType">
                    <div class="tflens-stack tflens-tab-body">

                        @* REQ-UI-018 / REQ-UI-019 — three live KPIs, each with its labelled backfilled line. *@
                        <StatGroup Columns="3" data-testid="@($"kpis-{vType}")">
                            @* StatTile's description slot is a <p>, and a Badge renders a <div>, which the
                               browser's parser hoists out of a paragraph — so the labelled backfilled line
                               lives in the value slot's <div> instead. It is still a separate, labelled
                               secondary line and is never added to the live figure. *@
                            <StatTile Title="First-pass rate"
                                      IconName="circle-check"
                                      Accent="StatAccent.Chart2"
                                      data-testid="@($"kpi-first-pass-{vType}")">
                                <ValueContent>
                                    <div class="flex flex-col gap-1">
                                        <span title="@FirstPassFormula">
                                            <FigureText Value="@vLive.FirstPassRate"
                                                        Class="@SmallWhenNoNumber(vLive.FirstPassRate)"
                                                        TestId="@($"live-first-pass-{vType}")" />
                                        </span>
                                        <div class="flex flex-wrap items-center gap-2 text-xs font-normal text-muted-foreground">
                                            <Badge Variant="BadgeVariant.Secondary">backfilled</Badge>
                                            <FigureText Value="@vBackfilled.FirstPassRate"
                                                        TestId="@($"backfilled-first-pass-{vType}")" />
                                        </div>
                                    </div>
                                </ValueContent>
                            </StatTile>

                            <StatTile Title="Escape rate"
                                      IconName="triangle-alert"
                                      Accent="StatAccent.Chart3"
                                      data-testid="@($"kpi-escape-{vType}")">
                                <ValueContent>
                                    <div class="flex flex-col gap-1">
                                        <span title="@EscapeFormula">
                                            <FigureText Value="@vLive.EscapeRate"
                                                        Class="@SmallWhenNoNumber(vLive.EscapeRate)"
                                                        TestId="@($"live-escape-{vType}")" />
                                        </span>
                                        <div class="flex flex-wrap items-center gap-2 text-xs font-normal text-muted-foreground">
                                            <Badge Variant="BadgeVariant.Secondary">backfilled</Badge>
                                            <FigureText Value="@vBackfilled.EscapeRate"
                                                        TestId="@($"backfilled-escape-{vType}")" />
                                        </div>
                                    </div>
                                </ValueContent>
                            </StatTile>

                            <StatTile Title="Failures scored"
                                      IconName="x"
                                      Accent="StatAccent.Chart4"
                                      Sparkline="@(objFailureSeries.IsPlottable ? objFailureSeries.Values : null)"
                                      SparklineLabel="@objFailureSeries.Label"
                                      data-testid="@($"kpi-failures-{vType}")">
                                <ValueContent>
                                    <div class="flex flex-col gap-1">
                                        <span title="@FailuresFormula"
                                              data-testid="@($"live-failures-{vType}")">@vLive.GateDistributionN</span>
                                        <div class="flex flex-wrap items-center gap-2 text-xs font-normal text-muted-foreground">
                                            <Badge Variant="BadgeVariant.Secondary">backfilled</Badge>
                                            <span data-testid="@($"backfilled-failures-{vType}")">@vBackfilled.GateDistributionN</span>
                                        </div>
                                    </div>
                                </ValueContent>
                            </StatTile>
                        </StatGroup>

                        @* REQ-UI-018 — the segment-facts line. *@
                        <p class="text-sm text-muted-foreground" data-testid="@($"segment-facts-{vType}")">
                            @SegmentFacts(vLive, vBackfilled)
                        </p>

                        @* REQ-UI-020 — the gate catch distribution, in the reference's gate order. *@
                        <Card>
                            <CardHeader Class="flex flex-row flex-wrap items-start justify-between gap-3">
                                <div>
                                    <CardTitle Class="text-base">Gate distribution — @LabelFor(vType)</CardTitle>
                                    <CardDescription>
                                        Which gate caught each failure; escaped = no gate caught it
                                    </CardDescription>
                                </div>
                                <Badge Variant="BadgeVariant.Outline">
                                    live @vLive.GateDistributionN · backfilled @vBackfilled.GateDistributionN
                                </Badge>
                            </CardHeader>
                            <CardContent Class="pt-0">
                                @if (vLive.GateDistributionNote is not null || vBackfilled.GateDistributionNote is not null)
                                {
                                    <p class="mb-3 text-xs italic text-muted-foreground"
                                       data-testid="@($"gate-dist-note-{vType}")">
                                        @DistributionNote(vLive, vBackfilled)
                                    </p>
                                }
                                <div class="overflow-x-auto">
                                    <DataTable TData="GateRow"
                                               Data="@GateRowsOf(vType)"
                                               ShowToolbar="false"
                                               ShowPagination="false"
                                               InitialPageSize="32"
                                               AriaLabel="@($"Gate catch distribution for {vType}")"
                                               data-testid="@($"gate-dist-{vType}")">
                                        <Columns>
                                            <DataTableColumn TData="GateRow" TValue="string"
                                                             Property="@(aRow => aRow.Gate)" Header="Gate">
                                                <CellTemplate Context="vRow">
                                                    <span class="flex flex-wrap items-center gap-2">
                                                        @if (vRow.IsEscaped)
                                                        {
                                                            <span class="font-semibold">@vRow.Gate</span>
                                                            <Badge Variant="BadgeVariant.Destructive">no gate caught it</Badge>
                                                        }
                                                        else if (vRow.IsLateGate)
                                                        {
                                                            <span>@vRow.Gate</span>
                                                            <Badge Variant="BadgeVariant.Outline">see coverage</Badge>
                                                        }
                                                        else
                                                        {
                                                            <span>@vRow.Gate</span>
                                                        }
                                                    </span>
                                                </CellTemplate>
                                            </DataTableColumn>

                                            <DataTableColumn TData="GateRow" TValue="int"
                                                             Property="@(aRow => aRow.LiveCount)" Header="Live count">
                                                <CellTemplate Context="vRow">
                                                    <span class="tabular-nums">@vRow.LiveCount</span>
                                                </CellTemplate>
                                            </DataTableColumn>

                                            <DataTableColumn TData="GateRow" TValue="string"
                                                             Property="@(aRow => aRow.LiveShare)" Header="Live share">
                                                <CellTemplate Context="vRow">
                                                    <span class="flex items-center gap-2">
                                                        <span class="tflens-share-bar">
                                                            <Progress Value="@vRow.LiveSharePercent"
                                                                      Class="h-2"
                                                                      IndicatorClass="@(vRow.IsEscaped ? "bg-destructive" : null)" />
                                                        </span>
                                                        <span class="text-xs tabular-nums">@vRow.LiveShare</span>
                                                    </span>
                                                </CellTemplate>
                                            </DataTableColumn>

                                            <DataTableColumn TData="GateRow" TValue="int"
                                                             Property="@(aRow => aRow.BackfilledCount)" Header="Backfilled count">
                                                <CellTemplate Context="vRow">
                                                    <span class="tabular-nums">@vRow.BackfilledCount</span>
                                                </CellTemplate>
                                            </DataTableColumn>

                                            <DataTableColumn TData="GateRow" TValue="string"
                                                             Property="@(aRow => aRow.BackfilledShare)" Header="Backfilled share">
                                                <CellTemplate Context="vRow">
                                                    <span class="flex items-center gap-2">
                                                        <span class="tflens-share-bar">
                                                            <Progress Value="@vRow.BackfilledSharePercent"
                                                                      Class="h-2"
                                                                      IndicatorClass="@(vRow.IsEscaped ? "bg-destructive" : null)" />
                                                        </span>
                                                        <span class="text-xs tabular-nums">@vRow.BackfilledShare</span>
                                                    </span>
                                                </CellTemplate>
                                            </DataTableColumn>
                                        </Columns>
                                    </DataTable>
                                </div>
                                @if (UnlistedNote(vLive, vBackfilled) is { } vUnlisted)
                                {
                                    <p class="mt-3 text-xs text-muted-foreground"
                                       data-testid="@($"gate-dist-unlisted-{vType}")">@vUnlisted</p>
                                }
                            </CardContent>
                        </Card>

                        @* REQ-UI-022 — late-gate coverage: ran beside caught, never a share read as a catch rate. *@
                        <div data-testid="@($"late-gate-{vType}")">
                        <Card>
                            <CardHeader Class="flex flex-row flex-wrap items-start justify-between gap-3">
                                <div>
                                    <CardTitle Class="text-base">Late-gate coverage</CardTitle>
                                    <CardDescription>
                                        Gates added after the data started — coverage is partial by construction
                                    </CardDescription>
                                </div>
                                <Badge Variant="BadgeVariant.Secondary">live records only</Badge>
                            </CardHeader>
                            <CardContent Class="pt-0">
                                <div class="flex flex-col gap-2">
                                    @if (vLive.LateGateCoverage.Count == 0)
                                    {
                                        <span class="text-sm text-muted-foreground">
                                            No late-added gate applies to this segment.
                                        </span>
                                    }
                                    @foreach (var vGate in vLive.LateGateCoverage)
                                    {
                                        <div class="flex flex-wrap items-center gap-2 text-sm"
                                             data-testid="@($"late-gate-{vType}-{vGate.Gate}")">
                                            <Badge Variant="BadgeVariant.Outline">@vGate.Gate</Badge>
                                            @if (vGate.Ran == 0 && vGate.Caught == 0)
                                            {
                                                <span class="text-muted-foreground">
                                                    not yet run on this data (gate added @vGate.Since)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @vGate.Gate gate: ran on @vGate.Ran records, caught @vGate.Caught →
                                                    <FigureText Value="@vGate.CatchRate"
                                                                TestId="@($"late-gate-rate-{vType}-{vGate.Gate}")" />
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </CardContent>
                        </Card>
                        </div>
                    </div>
                </TabsContent>
            }
        </Tabs>

        @* REQ-UI-021 — every REQ the engine dropped from the live first-pass rate, in full. *@
        <Collapsible @bind-Open="objIsTaintOpen">
            <Card>
                <CardHeader Class="pb-2">
                    @* The library's Button centres its content; the trigger reads as a disclosure row, so the
                       scoped rule below pins it left. *@
                    <div class="tflens-taint-trigger">
                        <CollapsibleTrigger AsChild="true">
                            <Button Variant="ButtonVariant.Ghost"
                                    Class="w-full px-2"
                                    data-testid="taint-trigger">
                                <LucideIcon Name="@(objIsTaintOpen ? "chevron-down" : "chevron-right")" Size="16" />
                                <span>@TaintTriggerText</span>
                            </Button>
                        </CollapsibleTrigger>
                    </div>
                </CardHeader>
                <CollapsibleContent>
                    <CardContent Class="pt-0">
                        <div class="flex flex-col gap-3">
                            <p class="text-sm text-muted-foreground">
                                Backfill taint — the REQ had a backfilled verdict before its first live verdict, so it
                                cannot count as a first pass.
                            </p>
                            <div class="flex flex-wrap items-center gap-2" data-testid="taint-list">
                                @if (objTaintedReqs.Count == 0)
                                {
                                    <span class="text-sm text-muted-foreground">none</span>
                                }
                                @foreach (var vReq in objTaintedReqs)
                                {
                                    <Badge Variant="BadgeVariant.Outline" Class="font-mono">@vReq</Badge>
                                }
                            </div>
                        </div>
                    </CardContent>
                </CollapsibleContent>
            </Card>
        </Collapsible>
    }
</div>

@code {
    /// <summary>The SCHEMA.md §8 formula behind the first-pass tile.</summary>
    private const string FirstPassFormula =
        "gates where attempt=1 AND verdict=Verified ÷ distinct req_id, live-only, per project_type (SCHEMA.md §8)";

    /// <summary>The SCHEMA.md §8 formula behind the escape-rate tile.</summary>
    private const string EscapeFormula =
        "REQs with a gate=\"escaped\" record ÷ REQs with any failure record, live-only, per project_type (SCHEMA.md §8)";

    /// <summary>The SCHEMA.md §8 formula behind the failures-scored tile.</summary>
    private const string FailuresFormula =
        "count of gate values across all verdict != Verified records, per project_type (SCHEMA.md §8)";

    /// <summary>The figures a project type has when the engine reported none for that provenance.</summary>
    private static readonly SegmentFigures objEmptySegment = new()
    {
        Records = 0,
        ReqsScored = 0,
        ReqsExcludedBackfillTaint = 0,
        FirstPassN = 0,
        FirstPassRate = Figure.NotApplicable(),
        GateDistribution = [],
        GateDistributionN = 0,
        GateDistributionNote = null,
        LateGateCoverage = [],
        EscapeRate = Figure.NotApplicable()
    };

    /// <summary>Failure records per day, backing the Failures-scored tile's sparkline.</summary>
    private DailySeries objFailureSeries = DailySeries.Empty;

    private AnalysisResult? objResult;
    private IReadOnlyList<string> objTypes = [];
    private IReadOnlyList<string> objTaintedReqs = [];
    private string? objSelectedType;
    private string? objLoadError;
    private string objFramework = string.Empty;
    private bool objIsLoaded;
    private bool objIsTaintOpen = true;
    private int? objUserId;

    /// <summary>The signed-in principal, cascaded by <c>AddCascadingAuthenticationState</c>.</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>True when the header Framework switch is on the Playbook axis (REQ-UI-034).</summary>
    private bool IsPlaybook => objPreferences.Framework == FrameworkNames.Playbook;

    /// <summary>The one line under the heading, which says which framework state the reader is looking at.</summary>
    private string Subtitle =>
        IsPlaybook
            ? "Playbook state — first-pass rate · escape rate · failures scored, keyed by phase_gate, never combined"
            : "First-pass rate · escape rate · failures scored — per project_type, never combined";

    /// <summary>The Collapsible's trigger line — REQ-UI-021's count of excluded REQs.</summary>
    private string TaintTriggerText =>
        $"{objTaintedReqs.Count} REQ{(objTaintedReqs.Count == 1 ? string.Empty : "s")} excluded from the live first-pass rate";

    /// <summary>Re-queries when the header Framework switch changes the provenance axis (ADR-016).</summary>
    protected override void OnInitialized()
    {
        objPreferences.Changed += OnPreferencesChanged;
    }

    /// <summary>
    /// Resolves the signed-in user and computes the figures for the selected framework.
    /// </summary>
    /// <returns>A task that completes when the tabs have their figures.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (objIsLoaded || AuthenticationStateTask is null)
        {
            return;
        }

        var vState = await AuthenticationStateTask;
        objUserId = ShellIdentity.UserId(vState.User);

        if (objUserId is null)
        {
            objIsLoaded = true;
            return;
        }

        await LoadAsync();
    }

    /// <summary>
    /// Runs the metrics engine for the signed-in user on the currently selected framework.
    /// </summary>
    /// <returns>A task that completes when the page has its analysis or its error.</returns>
    private async Task LoadAsync()
    {
        if (objUserId is null)
        {
            return;
        }

        objFramework = objPreferences.Framework;

        try
        {
            objResult = await objMetricsEngine.AnalyseAsync(objUserId.Value, objFramework);

            // Only the Failures-scored tile gets a sparkline. It states a COUNT of failure records, so
            // the line plots failure records per day — the same quantity. First-pass rate and escape
            // rate get none: a rate computed over one day is almost always below MinN, and a line
            // through a run of `insufficient data` would be precisely the plausible-but-unfounded
            // picture the provenance rules exist to prevent.
            objFailureSeries = await objStore.ReadDailySeriesAsync(
                objUserId.Value, objFramework, StreamKind.Gates, aFailuresOnly: true);
            objTypes = objResult.ProjectTypes;
            objTaintedReqs = objResult.TaintedReqs;
            objLoadError = null;
        }
        catch (Exception vEx)
        {
            objResult = null;
            objTypes = [];
            objTaintedReqs = [];
            objLoadError = vEx.Message;
        }

        if (objSelectedType is null || !objTypes.Contains(objSelectedType))
        {
            objSelectedType = objTypes.FirstOrDefault();
        }

        objIsLoaded = true;
    }

    /// <summary>
    /// Remembers the tab the user picked for the rest of the session.
    /// </summary>
    /// <param name="aType">The project type whose tab was selected.</param>
    /// <returns>A completed task — the figures are already in memory, so nothing is re-queried.</returns>
    private Task OnTypeSelectedAsync(string? aType)
    {
        if (!string.IsNullOrWhiteSpace(aType))
        {
            objSelectedType = aType;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The live figures for one project type, or an empty segment when the engine reported none.
    /// </summary>
    /// <param name="aType">The project type.</param>
    /// <returns>That type's live figures.</returns>
    private SegmentFigures LiveOf(string aType) =>
        objResult is not null && objResult.Live.TryGetValue(aType, out var vFigures) ? vFigures : objEmptySegment;

    /// <summary>
    /// The backfilled figures for one project type, or an empty segment when the engine reported none.
    /// </summary>
    /// <param name="aType">The project type.</param>
    /// <returns>That type's backfilled figures — never merged with the live ones.</returns>
    private SegmentFigures BackfilledOf(string aType) =>
        objResult is not null && objResult.Backfilled.TryGetValue(aType, out var vFigures) ? vFigures : objEmptySegment;

    /// <summary>
    /// The tab label for a project type.
    /// </summary>
    /// <param name="aType">The project type.</param>
    /// <returns>The type itself, or the inferred-provenance label for <c>unclassified</c>.</returns>
    private static string LabelFor(string aType) =>
        aType == MetricsConstants.Unclassified ? "unclassified (project_type inferred)" : aType;

    /// <summary>
    /// The muted line under the KPI row, stating each provenance's facts separately.
    /// </summary>
    /// <param name="aLive">The live figures.</param>
    /// <param name="aBackfilled">The backfilled figures.</param>
    /// <returns>The segment-facts sentence.</returns>
    private static string SegmentFacts(SegmentFigures aLive, SegmentFigures aBackfilled) =>
        $"live: {aLive.Records} records, {aLive.ReqsScored} REQs scored, " +
        $"{aLive.ReqsExcludedBackfillTaint} excluded by backfill taint · " +
        $"backfilled: {aBackfilled.Records} records, {aBackfilled.ReqsScored} REQs scored";

    /// <summary>
    /// The note shown when a provenance has too few failures for its shares to be read off.
    /// </summary>
    /// <param name="aLive">The live figures.</param>
    /// <param name="aBackfilled">The backfilled figures.</param>
    /// <returns>One sentence naming each provenance whose shares are unreadable.</returns>
    private static string DistributionNote(SegmentFigures aLive, SegmentFigures aBackfilled)
    {
        var vParts = new List<string>();

        if (aLive.GateDistributionNote is not null)
        {
            vParts.Add($"live shares: {aLive.GateDistributionNote}");
        }

        if (aBackfilled.GateDistributionNote is not null)
        {
            vParts.Add($"backfilled shares: {aBackfilled.GateDistributionNote}");
        }

        return string.Join(" · ", vParts);
    }

    /// <summary>
    /// Says how many of a provenance's failures name a gate the reference's order does not carry.
    /// </summary>
    /// <remarks>
    /// The engine reports only the gates in <c>GateOrder</c>, so a failure recorded against a gate outside
    /// it is absent from the table. Without this line the table would read as though it accounted for every
    /// failure the tile counts. Each provenance is stated on its own; the two are never added.
    /// </remarks>
    /// <param name="aLive">The live figures.</param>
    /// <param name="aBackfilled">The backfilled figures.</param>
    /// <returns>The sentence, or <c>null</c> when every failure is on the table.</returns>
    private static string? UnlistedNote(SegmentFigures aLive, SegmentFigures aBackfilled)
    {
        var vParts = new List<string>();

        var vLiveUnlisted = aLive.GateDistributionN - aLive.GateDistribution.Sum(aRow => aRow.Count);
        if (vLiveUnlisted > 0)
        {
            vParts.Add($"live: {vLiveUnlisted} of {aLive.GateDistributionN}");
        }

        var vBackfilledUnlisted =
            aBackfilled.GateDistributionN - aBackfilled.GateDistribution.Sum(aRow => aRow.Count);
        if (vBackfilledUnlisted > 0)
        {
            vParts.Add($"backfilled: {vBackfilledUnlisted} of {aBackfilled.GateDistributionN}");
        }

        return vParts.Count == 0
            ? null
            : $"{string.Join(" · ", vParts)} failures name a gate outside the reference's gate order and are not shown.";
    }

    /// <summary>
    /// Keeps a refusal-to-answer from being rendered at headline size.
    /// </summary>
    /// <param name="aFigure">The figure about to be rendered.</param>
    /// <returns>The shrinking classes when the figure carries no number, otherwise <c>null</c>.</returns>
    private static string? SmallWhenNoNumber(Figure aFigure) =>
        aFigure.HasValue ? null : "text-base font-normal";

    /// <summary>
    /// Builds the distribution rows for one project type, in the reference's gate order.
    /// </summary>
    /// <remarks>
    /// The engine omits a gate that caught nothing, but the screen shows the whole order so the reader can
    /// see a gate caught nothing rather than wonder whether it ran. Live and backfilled are separate
    /// columns on the row and are never added together.
    /// </remarks>
    /// <param name="aType">The project type.</param>
    /// <returns>One row per gate in <c>GateOrder</c>, with <c>unattributed</c> last.</returns>
    private IReadOnlyList<GateRow> GateRowsOf(string aType)
    {
        var vLive = LiveOf(aType);
        var vBackfilled = BackfilledOf(aType);
        var vRows = new List<GateRow>();

        foreach (var vGate in MetricsConstants.GateOrder.Append(MetricsConstants.Unattributed))
        {
            var vLiveCount = vLive.GateDistribution.FirstOrDefault(aRow => aRow.Gate == vGate)?.Count ?? 0;
            var vBackfilledCount = vBackfilled.GateDistribution.FirstOrDefault(aRow => aRow.Gate == vGate)?.Count ?? 0;

            vRows.Add(new GateRow
            {
                Gate = vGate,
                LiveCount = vLiveCount,
                LiveShare = MetricsConstants.Pct(vLiveCount, vLive.GateDistributionN),
                LiveSharePercent = SharePercent(vLiveCount, vLive.GateDistributionN),
                BackfilledCount = vBackfilledCount,
                BackfilledShare = MetricsConstants.Pct(vBackfilledCount, vBackfilled.GateDistributionN),
                BackfilledSharePercent = SharePercent(vBackfilledCount, vBackfilled.GateDistributionN),
                IsEscaped = vGate == MetricsConstants.Escaped,
                IsLateGate = MetricsConstants.LateGates.ContainsKey(vGate)
            });
        }

        return vRows;
    }

    /// <summary>
    /// The bar width for one share, within its own provenance's denominator.
    /// </summary>
    /// <param name="aCount">Failures the gate caught in that provenance.</param>
    /// <param name="aTotal">Failures that provenance scored.</param>
    /// <returns>A percentage between 0 and 100.</returns>
    private static double SharePercent(int aCount, int aTotal) =>
        aTotal == 0 ? 0d : 100.0 * aCount / aTotal;

    /// <summary>Re-queries the engine when the Framework switch changes the axis, rather than filtering.</summary>
    private void OnPreferencesChanged()
    {
        if (objPreferences.Framework == objFramework)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    /// <summary>Unsubscribes so the circuit does not leak a handler per navigation.</summary>
    public void Dispose()
    {
        objPreferences.Changed -= OnPreferencesChanged;
    }

    /// <summary>
    /// One row of the gate catch distribution, carrying each provenance in its own pair of cells.
    /// </summary>
    /// <remarks>
    /// There is deliberately no combined count or combined share on this type: the table has no total row
    /// and no column that adds live to backfilled (REQ-UI-019).
    /// </remarks>
    private sealed class GateRow
    {
        /// <summary>The gate name, or <c>unattributed</c> for a failure that named none.</summary>
        public required string Gate { get; init; }

        /// <summary>Live failures attributed to the gate.</summary>
        public required int LiveCount { get; init; }

        /// <summary>The gate's share of the live failures, as the reference prints it.</summary>
        public required string LiveShare { get; init; }

        /// <summary>The live share as a bar width between 0 and 100.</summary>
        public required double LiveSharePercent { get; init; }

        /// <summary>Backfilled failures attributed to the gate.</summary>
        public required int BackfilledCount { get; init; }

        /// <summary>The gate's share of the backfilled failures, as the reference prints it.</summary>
        public required string BackfilledShare { get; init; }

        /// <summary>The backfilled share as a bar width between 0 and 100.</summary>
        public required double BackfilledSharePercent { get; init; }

        /// <summary>True for the <c>escaped</c> row, which is never folded into a gate.</summary>
        public required bool IsEscaped { get; init; }

        /// <summary>True for a gate that entered the enum mid-stream, whose share is not its catch rate.</summary>
        public required bool IsLateGate { get; init; }
    }
}
