@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using TfLens.Core.AppManager
@using TrBlazeUI.Components.Typography

@inject IAppManagerClient objAppManagerClient
@inject ILogger<ResetPassword> objLogger

<PageTitle>Reset password · TfLens</PageTitle>

@*
    REQ-UI-004 / BRD-92. The token is read from the query string, held in a private field and never
    rendered — not in a value, not in a hidden input, not in a message. INVALID_RESET_TOKEN and
    APP_ID_MISMATCH deliberately collapse onto one sentence, so a wrong-tenant link is
    indistinguishable from a stale one.
*@

<Card>
    <CardHeader>
        <CardTitle>Reset password</CardTitle>
        <CardDescription>Choose a new password for your AppManager account</CardDescription>
    </CardHeader>

    @if (objIsDone)
    {
        <CardContent>
            <div class="flex flex-col gap-4">
                <Alert Variant="AlertVariant.Success" data-testid="reset-done">
                    <LucideIcon Name="circle-check-big" Size="16" />
                    <AlertTitle>Password updated.</AlertTitle>
                    <AlertDescription>Sign in with your new password.</AlertDescription>
                </Alert>
                <Button Href="/login" Class="w-full" data-testid="reset-signin">
                    <span>Sign in</span>
                    <LucideIcon Name="arrow-right" Size="16" />
                </Button>
            </div>
        </CardContent>
    }
    else if (objIsLinkDead)
    {
        <CardContent>
            <div class="flex flex-col gap-4">
                <Alert Variant="AlertVariant.Danger" data-testid="reset-invalid">
                    <LucideIcon Name="triangle-alert" Size="16" />
                    <AlertTitle>Link expired</AlertTitle>
                    <AlertDescription>@InvalidLinkMessage</AlertDescription>
                </Alert>
                <Button Variant="ButtonVariant.Outline" Href="/forgot-password" Class="w-full" data-testid="reset-request-new">
                    Request a new link
                </Button>
            </div>
        </CardContent>
    }
    else
    {
        <CardContent>
            <form id="@FormId"
                  class="flex flex-col gap-4"
                  @onsubmit="OnSubmitAsync"
                  @onsubmit:preventDefault>

                <Field IsInvalid="@(objPasswordError is not null)">
                    <FieldLabel For="reset-pass">New password</FieldLabel>
                    <FieldContent>
                        <Input Id="reset-pass"
                               Type="InputType.Password"
                               name="Password"
                               @bind-Value="objPassword"
                               Required="true"
                               data-testid="reset-pass" />
                        <PasswordStrengthMeter Password="@objPassword" />
                        <FieldDescription>
                            8+ chars, an uppercase letter, a number, a special character
                        </FieldDescription>
                        @if (objPasswordError is not null)
                        {
                            <FieldError data-testid="reset-pass-error">@objPasswordError</FieldError>
                        }
                    </FieldContent>
                </Field>

                <Field IsInvalid="@(objConfirmError is not null)">
                    <FieldLabel For="reset-confirm">Confirm password</FieldLabel>
                    <FieldContent>
                        <Input Id="reset-confirm"
                               Type="InputType.Password"
                               name="Confirm"
                               @bind-Value="objConfirm"
                               Required="true"
                               data-testid="reset-confirm" />
                        @if (objConfirmError is not null)
                        {
                            <FieldError data-testid="reset-confirm-error">@objConfirmError</FieldError>
                        }
                    </FieldContent>
                </Field>

                @if (objFormError is not null)
                {
                    <Alert Variant="AlertVariant.Danger" data-testid="reset-error">
                        <LucideIcon Name="triangle-alert" Size="16" />
                        <AlertTitle>Couldn't reset the password</AlertTitle>
                        <AlertDescription>@objFormError</AlertDescription>
                    </Alert>
                }

                <Button Type="ButtonType.Submit"
                        Class="w-full"
                        Disabled="@objIsSubmitting"
                        data-testid="reset-submit">
                    @if (objIsSubmitting)
                    {
                        <Spinner Size="SpinnerSize.Small" />
                        <span>Resetting…</span>
                    }
                    else
                    {
                        <span>Reset password</span>
                        <LucideIcon Name="arrow-right" Size="16" />
                    }
                </Button>
            </form>
        </CardContent>
    }

    <CardFooter Class="justify-center">
        <Button Variant="ButtonVariant.Link" Size="ButtonSize.Small" Href="/login" data-testid="reset-back">
            Back to sign in
        </Button>
    </CardFooter>
</Card>

<TypographyMuted Class="text-xs text-center">
    Identity by AppManager · public repos only in this release
</TypographyMuted>

@code {
    /// <summary>The one sentence an unusable link ever produces, whatever AppManager's reason was.</summary>
    private const string InvalidLinkMessage = "This reset link is invalid or has expired.";

    /// <summary>Shown when AppManager refused for a reason that is neither the link nor the rules.</summary>
    private const string GenericFailure =
        "Something went wrong talking to AppManager. Try the link again in a moment.";

    /// <summary>The field error a mismatched confirmation is reported as.</summary>
    private const string ConfirmMismatchError = "passwords differ";

    /// <summary>Id of the form; the success and dead-link states replace it entirely.</summary>
    private const string FormId = "tf-reset-form";

    private string objPassword = string.Empty;
    private string objConfirm = string.Empty;
    private string? objPasswordError;
    private string? objConfirmError;
    private string? objFormError;
    private bool objIsSubmitting;
    private bool objIsDone;
    private bool objIsLinkDead;

    /// <summary>The reset token from the emailed link; held only to post it, never rendered.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    /// <summary>The opaque reason <c>/auth/reset-password</c> redirected back with; never an AppManager code.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorReason { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // A link with no token cannot be completed, and says so in exactly the same words a rejected
        // token does — the page never distinguishes the two.
        if (string.IsNullOrWhiteSpace(Token))
        {
            objIsLinkDead = true;
            return;
        }

        if (ErrorReason == "expired")
        {
            objIsLinkDead = true;
        }
        else if (ErrorReason == "weak" && objPasswordError is null)
        {
            objPasswordError = "AppManager rejected that password. Use 8+ characters with an uppercase letter, a number and a special character.";
        }
        else if (!string.IsNullOrEmpty(ErrorReason) && objFormError is null)
        {
            objFormError = GenericFailure;
        }
    }

    /// <summary>
    /// Applies the local rules, then asks AppManager to complete the reset.
    /// </summary>
    /// <returns>A task that completes when the outcome is on screen.</returns>
    private async Task OnSubmitAsync()
    {
        if (objIsSubmitting)
        {
            return;
        }

        objPasswordError = PasswordRules.Describe(objPassword);
        objConfirmError = string.Equals(objPassword, objConfirm, StringComparison.Ordinal)
            ? null
            : ConfirmMismatchError;
        objFormError = null;

        if (objPasswordError is not null || objConfirmError is not null)
        {
            return;
        }

        objIsSubmitting = true;
        StateHasChanged();

        try
        {
            await objAppManagerClient.ResetPasswordAsync(Token ?? string.Empty, objPassword);
            objIsDone = true;
        }
        catch (AppManagerException vException)
        {
            objLogger.LogWarning("Password reset refused with {Code} ({Status}).", vException.Code, vException.StatusCode);

            if (vException.Code is AppManagerException.Codes.InvalidResetToken
                or AppManagerException.Codes.AppIdMismatch)
            {
                objIsLinkDead = true;
            }
            else
            {
                objFormError = GenericFailure;
            }
        }
        catch (Exception vException)
        {
            objLogger.LogError(vException, "Password reset could not be completed.");
            objFormError = GenericFailure;
        }

        objIsSubmitting = false;
    }
}
