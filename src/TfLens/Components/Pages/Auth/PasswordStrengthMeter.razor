@using TfLens.Core.AppManager

@*
    The password strength meter used by Register, Reset password and Profile.

    docs/TfLens-UIDesign.md §Library gaps calls for TrBlazeUI's `PasswordStrength` control, which the
    installed TrBlazeUI.Components 2.0.0 does not ship (TR-003) — so the meter is composed from the
    library's own `Progress`, which is the fallback the same section names.
*@

<div class="flex flex-col gap-1" data-testid="password-strength">
    <Progress Value="@Percentage" Class="h-1.5" IndicatorClass="@IndicatorClass" />
    <div class="flex justify-between text-xs text-muted-foreground">
        <span>Password strength</span>
        <span>@Label</span>
    </div>
</div>

@code {
    /// <summary>The password being measured; never logged and never echoed back to the page.</summary>
    [Parameter]
    public string? Password { get; set; }

    /// <summary>How many of AppManager's four rules the current password satisfies.</summary>
    private int Score
    {
        get
        {
            if (string.IsNullOrEmpty(Password))
            {
                return 0;
            }

            var vScore = 0;
            vScore += Password.Length >= PasswordRules.MinimumLength ? 1 : 0;
            vScore += Password.Any(char.IsUpper) ? 1 : 0;
            vScore += Password.Any(char.IsDigit) ? 1 : 0;
            vScore += Password.Any(aCharacter => !char.IsLetterOrDigit(aCharacter)) ? 1 : 0;
            return vScore;
        }
    }

    /// <summary>The meter's fill, as a percentage of the four rules.</summary>
    private double Percentage => Score * 25d;

    /// <summary>The word shown beside the meter.</summary>
    private string Label => Score switch
    {
        0 => "—",
        1 => "weak",
        2 => "fair",
        3 => "good",
        _ => "strong"
    };

    /// <summary>The bar's colour: destructive until every rule is satisfied, then the default fill.</summary>
    private string IndicatorClass => Score >= 4 ? "bg-primary" : "bg-destructive";
}
