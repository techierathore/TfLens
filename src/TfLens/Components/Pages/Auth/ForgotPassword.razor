@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using TrBlazeUI.Components.Typography

@inject IAppManagerClient objAppManagerClient
@inject ILogger<ForgotPassword> objLogger

<PageTitle>Forgot your password? · TfLens</PageTitle>

@* REQ-UI-003 / BRD-144 clause 2, 2026-08-30: below 768px the brand panel collapses to the 65px row
   docs/mockups/forgot-password.html draws, instead of the 399px desktop block that pushed this
   document 14px past the viewport at 390. Opt-in per page — see AuthCompactBrand.razor. *@
<AuthCompactBrand />

@*
    REQ-UI-003 / BRD-92. One outcome, always: whether or not the address is registered, the same
    sentence replaces the same form. Nothing on this page branches on the answer, so there is no
    wording, no layout and no code path a caller could use to learn that an account exists.
*@

<Card>
    <CardHeader>
        <CardTitle>Forgot your password?</CardTitle>
        <CardDescription>We'll email you a reset link</CardDescription>
    </CardHeader>

    @if (IsSent)
    {
        <CardContent>
            <Alert Variant="AlertVariant.Success" data-testid="forgot-sent">
                <LucideIcon Name="circle-check-big" Size="16" />
                <AlertTitle>Check your inbox</AlertTitle>
                <AlertDescription>If that address exists, a reset link is on its way.</AlertDescription>
            </Alert>
        </CardContent>
    }
    else
    {
        <CardContent>
            <form id="@FormId"
                  class="flex flex-col gap-4"
                  @onsubmit="OnSubmitAsync"
                  @onsubmit:preventDefault>

                <Field>
                    <FieldLabel For="forgot-email">Email</FieldLabel>
                    <FieldContent>
                        <Input Id="forgot-email"
                               Type="InputType.Email"
                               name="Email"
                               @bind-Value="objEmail"
                               Required="true"
                               Placeholder="you@example.com"
                               data-testid="forgot-email" />
                    </FieldContent>
                </Field>

                <Button Type="ButtonType.Submit"
                        Class="w-full"
                        Disabled="@objIsSubmitting"
                        data-testid="forgot-submit">
                    @if (objIsSubmitting)
                    {
                        <Spinner Size="SpinnerSize.Small" />
                        <span>Sending…</span>
                    }
                    else
                    {
                        <span>Send reset link</span>
                        <LucideIcon Name="arrow-right" Size="16" />
                    }
                </Button>
            </form>
        </CardContent>
    }

    <CardFooter Class="justify-center auth-card-footer">
        <Button Variant="ButtonVariant.Link" Size="ButtonSize.Small" Href="/login" data-testid="forgot-back">
            Back to sign in
        </Button>
    </CardFooter>
</Card>

<TypographyMuted Class="text-xs text-center">
    Identity by AppManager · public repos only in this release
</TypographyMuted>

@code {
    /// <summary>Id of the form, so the success state can replace exactly this element.</summary>
    private const string FormId = "tf-forgot-form";

    private string objEmail = string.Empty;
    private bool objIsSubmitting;
    private bool objIsSent;

    /// <summary>Set by <c>/auth/forgot-password</c> when the request was posted rather than sent from the circuit.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "sent")]
    public string? SentOutcome { get; set; }

    /// <summary>True once the request has been accepted — which it always is.</summary>
    private bool IsSent => objIsSent || SentOutcome == "1";

    /// <summary>
    /// Asks AppManager to send a reset link, then reports the one outcome this page has.
    /// </summary>
    /// <returns>A task that completes when the success state is on screen.</returns>
    /// <remarks>
    /// A failure is logged and swallowed on purpose: surfacing it would tell the caller something about
    /// the address, which is the exact leak BRD-92 forbids.
    /// </remarks>
    private async Task OnSubmitAsync()
    {
        if (objIsSubmitting || objIsSent)
        {
            return;
        }

        objIsSubmitting = true;
        StateHasChanged();

        try
        {
            await objAppManagerClient.ForgotPasswordAsync(objEmail.Trim());
        }
        catch (Exception vException)
        {
            objLogger.LogWarning(vException, "Forgot-password request could not be delivered to AppManager.");
        }

        objIsSubmitting = false;
        objIsSent = true;
    }
}
