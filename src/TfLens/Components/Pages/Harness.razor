@*
    REQ-UI-023 / REQ-UI-024 / REQ-UI-025 / REQ-UI-026 — the Harness comparison screen.

    The integrity rules are the feature here (ADR-017, SCHEMA.md §1 and §4):

      * the columns are the three detected harnesses in the fixed order claude-code · opencode · codex,
        and a harness that emitted nothing still gets a column showing `—` rather than disappearing;
      * `harness: null` is a footnote under the columns, never a fourth column and never dropped;
      * tokens may be compared across harness, dollars may not — the only measured `cost_usd` in the
        system belongs to OpenCode, and there is no cross-harness dollar total anywhere in this markup;
      * any figure below the minimum n renders as `insufficient data (n=…)` through FigureText.

    The bar chart is supplementary: TrBlazeUI's chart API carries no axis or label control, so every
    value it draws is also printed as text in the table beside it.
*@
@page "/harness"
@using System.Globalization
@using TrBlazeUI.Components.Chart
@using TrBlazeUI.Components.Empty
@using TrBlazeUI.Components.Typography
@using TfLens.Components.Shared.Playbook
@using ApexCharts
@implements IDisposable
@inject IExtraMetrics objExtraMetrics
@inject ShellPreferences objPreferences
@inject ShellState objShellState

<PageTitle>Harness comparison · TfLens</PageTitle>

<div class="tflens-stack">

    <div>
        <TypographyH2>Harness comparison</TypographyH2>
        <TypographyMuted>@Subtitle</TypographyMuted>
    </div>

    @* REQ-UI-023 — the standing note. It is not conditional: the rule holds on every framework. *@
    <Alert Variant="AlertVariant.Info" data-testid="harness-note">
        <LucideIcon Name="info" Size="18" />
        <AlertTitle>Compare tokens, not dollars</AlertTitle>
        <AlertDescription>
            Tokens may be compared across harness; dollars may not. Claude Code and Codex cost is null by design.
        </AlertDescription>
    </Alert>

    @if (IsPlaybook)
    {
        @* REQ-UI-034 — the Playbook framework state: the standing axis note, then the dimensions
           `events.ndjson` actually carries, or the Phase-3 empty state. The figures are read through
           IPlaybookReportBuilder, so no TechieFlow harness column can reach this branch and the two
           axes cannot be pooled (SCHEMA.md §11). *@
        <PlaybookState UserId="@objUserId">
            <ChildContent Context="vAnalysis">
                <PlaybookHarnessSurface Analysis="@vAnalysis" />
            </ChildContent>
        </PlaybookState>
    }
    else if (!objIsLoaded)
    {
        <Card>
            <CardContent Class="p-6">
                <div class="flex flex-col gap-3">
                    <Skeleton Class="h-4 w-full" />
                    <Skeleton Class="h-4 w-3/4" />
                    <Skeleton Class="h-4 w-1/2" />
                </div>
            </CardContent>
        </Card>
    }
    else if (objLoadError is not null)
    {
        <Alert Variant="AlertVariant.Danger" data-testid="harness-error">
            @* TR-008: 2.0.0 ships only the post-rename Lucide names — `alert-triangle` renders nothing. *@
            <LucideIcon Name="triangle-alert" Size="18" />
            <AlertTitle>Couldn't build the comparison</AlertTitle>
            <AlertDescription>@objLoadError</AlertDescription>
        </Alert>
    }
    else
    {
        @* REQ-UI-023 — three columns, always, in the detected order. *@
        <div class="tflens-harness-cols" data-testid="harness-columns">
            @foreach (var vColumn in objComparison.Columns)
            {
                <Card Class="h-full" data-testid="@($"harness-col-{vColumn.Harness}")">
                    <CardHeader>
                        <div class="flex items-center gap-3">
                            <span class="tflens-stat-chip @AccentClassFor(vColumn.Harness)">
                                <LucideIcon Name="git-compare" Size="16" />
                            </span>
                            <div>
                                <CardTitle Class="text-base">@vColumn.Harness</CardTitle>
                                <CardDescription>@SubtitleFor(vColumn)</CardDescription>
                            </div>
                        </div>
                    </CardHeader>
                    <CardContent Class="pt-0">
                        <div class="tflens-kv overflow-x-auto">
                            @* TR-009: ShowPagination="false" hides the pager but still truncates the data to
                               InitialPageSize (5), so the page size has to cover every row or rows vanish. *@
                            <DataTable TData="ColumnRow"
                                       Data="@RowsFor(vColumn)"
                                       ShowToolbar="false"
                                       ShowPagination="false"
                                       InitialPageSize="50"
                                       AriaLabel="@($"{vColumn.Harness} metrics")"
                                       data-testid="@($"harness-table-{vColumn.Harness}")">
                                <Columns>
                                    <DataTableColumn TData="ColumnRow" TValue="string"
                                                     Property="@(aRow => aRow.Label)" Header="Metric">
                                        <CellTemplate Context="vRow">
                                            <span class="text-muted-foreground">@vRow.Label</span>
                                        </CellTemplate>
                                    </DataTableColumn>
                                    <DataTableColumn TData="ColumnRow" TValue="string"
                                                     Property="@(aRow => aRow.Text)" Header="Value"
                                                     CellClass="text-right">
                                        <CellTemplate Context="vRow">
                                            @if (vRow.Value is { } vFigure)
                                            {
                                                @if (vFigure.HasValue)
                                                {
                                                    @* REQ-UI-024 — the mockup groups this figure's thousands
                                                       (`51,300`). The digits are the export's own, taken from
                                                       Figure.Display() and only punctuated, and the ungrouped
                                                       string stays reachable as the cell's title. *@
                                                    <span class="tabular-nums font-medium"
                                                          title="@vFigure.Display()"
                                                          data-testid="@vRow.TestId">@GroupedFigureText(vFigure.Display())</span>
                                                }
                                                else
                                                {
                                                    @* ADR-007 — `insufficient data (n=…)` and `—` are not numbers,
                                                       so they reach the screen through FigureText, unaltered. *@
                                                    @* REQ-UI-024 — the refusal string is this page's
                                                       other long cell, and it gets the design's own
                                                       answer to a long cell: the `sm` 13px the mockup
                                                       puts on `Runs by cmd`. At 14px
                                                       `insufficient data (n=0)` needs ~150px against
                                                       the 136px this column gives at 1280 and came out
                                                       over two lines, which is the owner's standing
                                                       finding on this row. The size lives on a wrapper
                                                       because `FigureText`'s root carries ITS scope
                                                       attribute, not this page's — `font-size`
                                                       inherits through it, a class would not
                                                       (REQ-NFR-021). *@
                                                    <span class="tflens-kv-small">
                                                        <FigureText Value="vFigure"
                                                                    Class="tabular-nums font-medium"
                                                                    TestId="@vRow.TestId" />
                                                    </span>
                                                }
                                            }
                                            else if (vRow.PassShare is { } vShare)
                                            {
                                                @* REQ-UI-023 — the mockup's pass-share bar. The verbatim
                                                   verdict list stays reachable as the title, so ranking
                                                   the figure never costs the reader the detail. *@
                                                <span class="tflens-verdict" title="@vRow.Text" data-testid="@vRow.TestId">
                                                    <span class="tflens-verdict-track">
                                                        <span class="tflens-verdict-fill"
                                                              style="width:@PercentCss(vShare)"></span>
                                                    </span>
                                                    <span class="tflens-verdict-pct">@PercentText(vShare) pass</span>
                                                </span>
                                            }
                                            else
                                            {
                                                @* REQ-UI-024 — an abbreviated token count carries the exact
                                                   number as its native tooltip, so nothing is lost by rounding
                                                   it on screen. `Exact` is null on every other row.

                                                   REQ-UI-023 — `IsSmall` is the mockup's own `sm` class, which
                                                   it puts on exactly one cell: the long `Runs by cmd` list. *@
                                                <span class="@ValueClassFor(vRow)"
                                                      title="@vRow.Exact"
                                                      data-testid="@vRow.TestId">@vRow.Text</span>
                                            }
                                        </CellTemplate>
                                    </DataTableColumn>
                                </Columns>
                            </DataTable>
                        </div>
                    </CardContent>
                </Card>
            }
        </div>

        @* REQ-UI-026 — undetected records are a footnote, never a column; hidden only at n = 0. *@
        @if (objComparison.NotDetectedRecords > 0)
        {
            <div class="tflens-footnote" data-testid="harness-null-footnote">
                <LucideIcon Name="info" Size="16" />
                <span class="text-sm text-muted-foreground">
                    @objComparison.NotDetectedRecords.ToString("N0", CultureInfo.InvariantCulture)
                    records with harness not detected — excluded from the columns above
                </span>
            </div>
        }

        <div class="tflens-harness-lower">

            @* REQ-UI-023 — the chart is supplementary; the table beside it carries the same numbers as text. *@
            <Card Class="h-full">
                <CardHeader>
                    @* No `flex-wrap`: the design puts the unit badge on the right of this header, and
                       wrapping dropped it onto a line of its own under the description. *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <CardTitle Class="text-base">Total tokens by harness</CardTitle>
                            <CardDescription>in + out + cache read + cache write</CardDescription>
                        </div>
                        @* The design's unit chip. The text differs — the mockup's `millions` is a single
                           unit, and these bars carry a unit each (`3.2B`, `814k`), so a global "millions"
                           would be a false statement about two of the three. It says what is true of all
                           three instead, which is also BRD-53's standing rule for this page. *@
                        <Badge Variant="BadgeVariant.Outline" Class="tflens-unit-badge">tokens, not dollars</Badge>
                    </div>
                </CardHeader>
                <CardContent Class="pt-0">
                    @if (objTokenRows.Any(aRow => aRow.Tokens > 0))
                    {
                        @* TR-005: the chart types carry no XValue/YValue and draw nothing from `Items` alone,
                           so the series is declared with the component the wrapper wraps.

                           TR-027 (raised 2026-09-01, REQ-UI-023): `BarChart` exposes ShowLegend / ShowTooltip /
                           ShowDataLabels and nothing else — no axis switch, no grid switch, and no way to reach
                           `ApexChartOptions`. It therefore CANNOT be made to match this screen's approved design,
                           which draws no y axis, no gridlines, and one value label above each bar. Left as it
                           shipped, the axis printed raw counts (`3000000000`) with no unit scaling and no labels,
                           and claude-code at 2.86B flattened the other two bars to nothing — the owner could not
                           read two of the three figures the card exists to compare. `ApexChart` is the component
                           `BarChart` wraps, so it is used directly here to reach `Options`; `ChartContainer` still
                           provides the sizing wrapper the design names. *@
                        <div class="tflens-chart" data-testid="tokens-chart">
                            <ChartContainer>
                                <ApexChart TItem="HarnessTokenTotal"
                                           Options="@objChartOptions"
                                           Height="260"
                                           Width="@("100%")">
                                    <ApexPointSeries TItem="HarnessTokenTotal"
                                                     Items="@objChartRows"
                                                     Name="Total tokens"
                                                     SeriesType="SeriesType.Bar"
                                                     ShowDataLabels="true"
                                                     XValue="@(aRow => aRow.Harness)"
                                                     YValue="@(aRow => (decimal)aRow.Tokens)"
                                                     PointColor="@(aRow => ChartColourFor(aRow.Harness))" />
                                </ApexChart>
                            </ChartContainer>
                        </div>

                        @* REQ-UI-023 — the bars carry SVG text, which a screen reader announces as a graphic.
                           The same three figures are repeated here as an off-screen list so the card is readable
                           without sight of it; this is not the `Harness | Total tokens` table the design does not
                           have, and it occupies no space. *@
                        <ul class="sr-only" data-testid="tokens-chart-values">
                            @foreach (var vRow in objTokenRows)
                            {
                                <li data-testid="@($"tokens-total-{vRow.Harness}")">
                                    @vRow.Harness: @vRow.Display tokens
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <Empty Title="No token data"
                               Description="No harness has captured token counts on this framework yet."
                               Size="EmptySize.Small"
                               data-testid="tokens-chart-empty">
                            <Icon>
                                <LucideIcon Name="bar-chart-3" Size="32" />
                            </Icon>
                        </Empty>
                    }

                    @* REQ-UI-023, removed 2026-09-01 — a `Harness | Total tokens` DataTable stood here,
                       repeating each bar's figure as a row. `docs/mockups/harness.html` has no such table:
                       its chart card is bars and nothing else, because the value is printed ABOVE the bar
                       it belongs to. The table was this page's own workaround for a chart that carried no
                       labels; the labels now exist, so the table is a second rendering of the same three
                       numbers, and the owner reported it as drift on 2026-08-30. The accessible list above
                       keeps the figures reachable without sight. *@
                </CardContent>
            </Card>

            @* REQ-UI-025 — the only dollars on the page, and only OpenCode's. *@
            <Card Class="h-full" data-testid="opencode-cost">
                <CardHeader>
                    <div class="flex items-start justify-between gap-3">
                        <div class="tflens-cost-heading">
                            <CardTitle Class="text-base">Measured dollars (OpenCode only)</CardTitle>
                            <CardDescription>
                                <Badge Variant="BadgeVariant.Secondary">the only measured dollars in the system</Badge>
                            </CardDescription>
                        </div>
                        <span class="tflens-stat-chip tflens-accent-2 shrink-0">
                            <LucideIcon Name="database" Size="16" />
                        </span>
                    </div>
                </CardHeader>
                <CardContent Class="pt-0">
                    @if (objComparison.OpenCodeCostUsd is { } vCost)
                    {
                        <div class="tflens-money tabular-nums" data-testid="opencode-cost-value">
                            @vCost.ToString("C2", CultureInfo.GetCultureInfo("en-US"))
                        </div>
                        <p class="mt-1 text-xs text-muted-foreground" data-testid="opencode-cost-basis">
                            @OpenCodeCostBasis
                        </p>
                    }
                    else
                    {
                        <div class="tflens-money-empty" data-testid="opencode-cost-value">no OpenCode records yet</div>
                    }

                    <div class="tflens-money-rule">
                        <Separator />
                    </div>

                    <p class="text-sm text-muted-foreground" data-testid="opencode-cost-note">
                        Claude Code and Codex: not measured (null by design)
                    </p>
                </CardContent>
            </Card>
        </div>
    }
</div>

@code {
    /// <summary>What a value reads when there is nothing to measure at all.</summary>
    private const string Dash = "—";

    /// <summary>What every harness other than OpenCode reports for measured dollars (BRD-53).</summary>
    private const string NotMeasured = "not measured (null by design)";

    /// <summary>The one harness that measures its own cost.</summary>
    private const string OpenCode = "opencode";

    /// <summary>
    /// The basis line under the measured-dollars figure — the stream and the record count it was
    /// actually summed over.
    /// </summary>
    /// <remarks>
    /// Built as one string rather than interleaved markup so the sentence cannot be split by Razor's
    /// whitespace handling: rendered as three fragments it silently truncated to "Σ cost_usd over 2",
    /// dropping the noun and leaving the reader to guess which stream the 2 counted. It names
    /// <b>sessions</b> because that is where <c>cost_usd</c> lives (SCHEMA.md §4); the earlier caption
    /// said "runs" and quoted the run count, naming the wrong stream and the wrong number under a
    /// figure that was itself correct.
    /// </remarks>
    private string OpenCodeCostBasis
    {
        get
        {
            var vCount = objComparison.OpenCodeCostSessions;
            var vNoun = vCount == 1 ? "session" : "sessions";
            return $"Σ cost_usd over {vCount.ToString("N0", CultureInfo.InvariantCulture)} opencode {vNoun}";
        }
    }

    /// <summary>
    /// The JavaScript the chart's value labels are rendered with — the browser-side twin of
    /// <see cref="TokenText"/>.
    /// </summary>
    /// <remarks>
    /// REQ-UI-023 — <c>docs/mockups/harness.html</c> prints one label above each bar (<c>68.6M</c>,
    /// <c>19.0M</c>, <c>0.61M</c>) and draws no axis at all. ApexCharts renders its data labels in the
    /// browser, so the abbreviation has to be expressed as JavaScript rather than as C#. The thresholds,
    /// the precision and the suffixes are the same ones <see cref="TokenText"/> applies to the column
    /// cells, so a bar and its column can never disagree about the same figure.
    /// </remarks>
    private const string TokenLabelFormatter = """
        function (aValue) {
            if (aValue === null || aValue === undefined) { return ''; }
            var vMagnitude = Math.abs(aValue);
            if (vMagnitude >= 1e9) { return (aValue / 1e9).toFixed(1) + 'B'; }
            if (vMagnitude >= 1e6) { return (aValue / 1e6).toFixed(1) + 'M'; }
            if (vMagnitude >= 1e3) { return Math.round(aValue / 1e3) + 'k'; }
            return String(aValue);
        }
        """;

    private HarnessComparison objComparison = new([], 0, null, 0);
    private IReadOnlyList<HarnessTokens> objTokenRows = [];
    private IReadOnlyList<HarnessTokenTotal> objChartRows = [];

    /// <summary>
    /// The chart's options — no y axis, no gridlines, one abbreviated value label above each bar.
    /// </summary>
    /// <remarks>
    /// REQ-UI-023, 2026-09-01. The shipped chart drew ApexCharts' defaults: a linear y axis printing raw
    /// token counts (<c>3000000000</c>), horizontal gridlines, and no labels. On this data — claude-code
    /// 2.86B against opencode's 814k — that made two of the three bars a sub-pixel line with no figure
    /// anywhere near them, on the one card whose whole job is to compare the three. The approved design
    /// answers exactly this: it drops the axis and puts the number on the bar, so a bar that is too short
    /// to see still states its own value.
    /// </remarks>
    private readonly ApexChartOptions<HarnessTokenTotal> objChartOptions = new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Background = "transparent",
            FontFamily = "inherit"
        },
        Theme = new Theme { Mode = Mode.Dark },
        Legend = new Legend { Show = false },
        Tooltip = new ApexCharts.Tooltip { Enabled = true },
        // The mockup draws neither, and both were actively harmful here: the gridlines carried the raw
        // counts that made the card unreadable.
        Grid = new Grid { Show = false, BorderColor = "transparent", Padding = new Padding { Left = 0, Right = 0 } },
        Yaxis = [new YAxis { Show = false }],
        Xaxis = new XAxis
        {
            AxisBorder = new AxisBorder { Show = false },
            AxisTicks = new AxisTicks { Show = false }
        },
        DataLabels = new DataLabels
        {
            Enabled = true,
            // Above the bar, as the design draws it — ApexCharts centres a bar's label inside it by
            // default, where a 3px bar has nowhere to put one.
            OffsetY = -20,
            Formatter = TokenLabelFormatter,
            Style = new DataLabelsStyle { FontSize = "12px", FontWeight = "600", Colors = ["#a1a1aa"] }
        },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { DataLabels = new PlotOptionsBarDataLabels { Position = BarDataLabelPosition.Top } }
        }
    };
    private string? objLoadError;
    private bool objIsLoaded;
    private int? objUserId;

    /// <summary>The signed-in principal, cascaded by <c>AddCascadingAuthenticationState</c>.</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>True when the header Framework switch is on the Playbook axis (REQ-UI-034).</summary>
    private bool IsPlaybook => objPreferences.Framework == FrameworkNames.Playbook;

    /// <summary>The one line under the heading, which says which framework state the reader is looking at.</summary>
    private string Subtitle =>
        IsPlaybook
            ? "Playbook state — what events.ndjson can and cannot say about the harness a phase ran on"
            : "claude-code · opencode · codex, side by side — same rows, no total";


    /// <summary>
    /// Re-queries whenever the workspace or the chosen provenance axis changes under this page.
    /// </summary>
    /// <remarks>
    /// REQ-UI-010 / ADR-016 — the Framework switch raises <c>ShellPreferences.Changed</c>; the page
    /// answers it by asking the engine again on the new axis rather than by filtering what it already
    /// rendered, because the two frameworks are separate provenance axes and never pool.
    /// </remarks>
    protected override void OnInitialized()
    {
        objShellState.Changed += OnShellChanged;
        objPreferences.Changed += OnShellChanged;
    }

    /// <summary>
    /// Resolves the signed-in user and builds the comparison on the selected framework.
    /// </summary>
    /// <remarks>
    /// ADR-016 — the framework is a query parameter, never a display filter. The header's Framework
    /// switch reloads the route, which brings the page back through here and re-queries the engine.
    /// </remarks>
    /// <returns>A task that completes when the three columns have their values.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (objIsLoaded || AuthenticationStateTask is null)
        {
            return;
        }

        var vState = await AuthenticationStateTask;
        objUserId = ShellIdentity.UserId(vState.User);

        if (objUserId is null)
        {
            objIsLoaded = true;
            return;
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Re-reads the comparison for the signed-in user on the selected framework.
    /// </summary>
    /// <returns>A task that completes when the page has its figures or its error.</returns>
    private async Task ReloadAsync()
    {
        if (objUserId is null)
        {
            return;
        }

        try
        {
            // ADR-016 — the framework is read afresh on every load, so a change of axis is a new query
            // against the engine, never a filter applied to figures already on screen.
            objComparison = await objExtraMetrics
                .CompareHarnessesAsync(objUserId.Value, objPreferences.Framework);
            objTokenRows = objComparison.Columns.Select(ToTokenRow).ToList();
            objChartRows = objTokenRows
                .Select(aRow => new HarnessTokenTotal(aRow.Harness, aRow.Tokens))
                .ToList();
            objLoadError = null;
        }
        catch (Exception vEx)
        {
            objComparison = new HarnessComparison([], 0, null, 0);
            objTokenRows = [];
            objChartRows = [];
            objLoadError = vEx.Message;
        }
        finally
        {
            objIsLoaded = true;
        }
    }

    /// <summary>
    /// Builds one harness column's key/value rows, in the order the mockup lists them.
    /// </summary>
    /// <param name="aColumn">The harness column the engine produced.</param>
    /// <returns>The rows; a harness with no records at all reads <c>—</c> throughout.</returns>
    private IReadOnlyList<ColumnRow> RowsFor(HarnessColumn aColumn)
    {
        var vIsEmpty = IsEmpty(aColumn);
        var vHarness = aColumn.Harness;

        return
        [
            new ColumnRow("Runs", CountText(vIsEmpty, aColumn.Runs), null, $"harness-{vHarness}-runs"),

            // REQ-UI-023 — the one cell the mockup marks `sm`: a three-command list is the longest text on
            // the page, and the approved design answers that with 13px type rather than with more rows.
            new ColumnRow(
                "Runs by cmd (top 3)",
                PairsText(aColumn.RunsByCmd, 3),
                null,
                $"harness-{vHarness}-cmds",
                null,
                null,
                true),
            new ColumnRow("Gate records", CountText(vIsEmpty, aColumn.GateRecords), null, $"harness-{vHarness}-gates"),
            // REQ-UI-023 — the mockup shows a pass-share bar and one percentage here, not every verdict.
            // The full breakdown stays available as the cell's tooltip; nothing is hidden, it is ranked.
            new ColumnRow(
                "Verdict mix",
                PairsText(aColumn.VerdictMix, int.MaxValue),
                null,
                $"harness-{vHarness}-verdicts",
                PassShareOf(aColumn.VerdictMix)),
            new ColumnRow("Sessions", CountText(vIsEmpty, aColumn.Sessions), null, $"harness-{vHarness}-sessions"),

            // REQ-UI-024 — the four token rows read in the mockup's compact notation (`18.4M`, `212k`).
            // Every one of them carries the exact count as its title, so an abbreviated cell is still a
            // quotable cell (BRD §1) and the export is untouched either way.
            new ColumnRow(
                "Tokens in",
                TokenText(vIsEmpty, aColumn.TokensIn),
                null,
                $"harness-{vHarness}-tokens-in",
                null,
                ExactTokenText(vIsEmpty, aColumn.TokensIn)),
            new ColumnRow(
                "Tokens out",
                TokenText(vIsEmpty, aColumn.TokensOut),
                null,
                $"harness-{vHarness}-tokens-out",
                null,
                ExactTokenText(vIsEmpty, aColumn.TokensOut)),
            new ColumnRow(
                "Cache read",
                TokenText(vIsEmpty, aColumn.TokensCacheRead),
                null,
                $"harness-{vHarness}-cache-read",
                null,
                ExactTokenText(vIsEmpty, aColumn.TokensCacheRead)),
            new ColumnRow(
                "Cache write",
                TokenText(vIsEmpty, aColumn.TokensCacheWrite),
                null,
                $"harness-{vHarness}-cache-write",
                null,
                ExactTokenText(vIsEmpty, aColumn.TokensCacheWrite)),

            // REQ-UI-024 — computed per harness, never pooled, and never a number below the minimum n.
            new ColumnRow(
                "Tokens per Verified REQ",
                aColumn.TokensPerVerifiedReq.Display(),
                aColumn.TokensPerVerifiedReq,
                $"harness-{vHarness}-tokens-per-verified"),

            // REQ-UI-025 — no dollar figure lives in a column; OpenCode's measured total is in its own
            // card below, and the other two say why they have none rather than showing a zero.
            new ColumnRow("Measured dollars", MeasuredDollarsText(vHarness), null, $"harness-{vHarness}-cost")
        ];
    }

    /// <summary>
    /// What a harness column says about measured dollars.
    /// </summary>
    /// <remarks>
    /// REQ-UI-025 / BRD-53 — no dollar figure appears in a column: Claude Code and Codex have none by
    /// design and say so rather than showing a zero, and OpenCode points at the one card that holds the
    /// measurement. When OpenCode captured no <c>cost_usd</c> at all the row says that too, so it never
    /// contradicts the card beside it.
    /// </remarks>
    /// <param name="aHarness">The harness key from the engine.</param>
    /// <returns>The line for the Measured dollars row.</returns>
    private string MeasuredDollarsText(string aHarness)
    {
        if (!string.Equals(aHarness, OpenCode, StringComparison.Ordinal))
        {
            return NotMeasured;
        }

        return objComparison.OpenCodeCostUsd is null
            ? "no cost_usd captured yet"
            : "measured — see the card below";
    }

    /// <summary>
    /// Tells whether a harness emitted nothing at all on this framework.
    /// </summary>
    /// <param name="aColumn">The harness column.</param>
    /// <returns><c>true</c> when it has no runs, no gate records and no sessions.</returns>
    private static bool IsEmpty(HarnessColumn aColumn) =>
        aColumn.Runs == 0 && aColumn.GateRecords == 0 && aColumn.Sessions == 0;

    /// <summary>
    /// Renders a count, or <c>—</c> when the harness emitted nothing.
    /// </summary>
    /// <remarks>
    /// ADR-017 — a harness with no records is shown, not hidden, and a zero would read as "we measured
    /// it and it was nothing" rather than "there was nothing to measure".
    /// </remarks>
    /// <param name="aIsEmpty">Whether the whole column is empty.</param>
    /// <param name="aValue">The count.</param>
    /// <returns>The grouped number, or the dash.</returns>
    private static string CountText(bool aIsEmpty, long aValue) =>
        aIsEmpty ? Dash : aValue.ToString("N0", CultureInfo.InvariantCulture);

    /// <summary>
    /// Renders a token count in the approved mockup's compact notation.
    /// </summary>
    /// <remarks>
    /// REQ-UI-024 — <c>docs/mockups/harness.html</c> prints these four rows as <c>18.4M</c>, <c>2.9M</c>,
    /// <c>41.2M</c>, <c>6.1M</c>, <c>212k</c>, <c>48k</c>, <c>318k</c>, <c>32k</c>: one decimal above a
    /// million, whole thousands below it. Billions follow the same rule one magnitude up, which the
    /// mockup has no example of but this data does (<c>2,811,924,108</c> cache reads).
    /// <para>
    /// Abbreviating is a <b>presentation</b> choice and it is never the only rendering: every cell built
    /// from this also carries <see cref="ExactTokenText"/> as its <c>title</c>, and the export path
    /// (<c>SnapshotJson</c>/<c>SnapshotMarkdown</c>) never passes through here at all, so REQ-FN-058
    /// key-for-key parity is unaffected.
    /// </para>
    /// </remarks>
    /// <param name="aIsEmpty">Whether the whole column is empty.</param>
    /// <param name="aValue">The token count.</param>
    /// <returns>The compact count, or the dash.</returns>
    private static string TokenText(bool aIsEmpty, long aValue)
    {
        if (aIsEmpty)
        {
            return Dash;
        }

        var vMagnitude = Math.Abs(aValue);

        if (vMagnitude >= 1_000_000_000L)
        {
            return (aValue / 1_000_000_000d).ToString("0.0", CultureInfo.InvariantCulture) + "B";
        }

        if (vMagnitude >= 1_000_000L)
        {
            return (aValue / 1_000_000d).ToString("0.0", CultureInfo.InvariantCulture) + "M";
        }

        if (vMagnitude >= 1_000L)
        {
            return (aValue / 1_000d).ToString("0", CultureInfo.InvariantCulture) + "k";
        }

        return aValue.ToString("N0", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// The exact token count an abbreviated cell keeps as its native tooltip (REQ-UI-024).
    /// </summary>
    /// <param name="aIsEmpty">Whether the whole column is empty.</param>
    /// <param name="aValue">The token count.</param>
    /// <returns>
    /// The grouped count, or <c>null</c> when there is nothing to disclose — an empty column, or a count
    /// small enough that the compact rendering already is the exact one.
    /// </returns>
    private static string? ExactTokenText(bool aIsEmpty, long aValue) =>
        aIsEmpty || Math.Abs(aValue) < 1_000L
            ? null
            : aValue.ToString("N0", CultureInfo.InvariantCulture) + " tokens";

    /// <summary>
    /// Groups the thousands of a figure's own rendered string without changing a digit of it.
    /// </summary>
    /// <remarks>
    /// REQ-UI-024 — the mockup prints <c>Tokens per Verified REQ</c> as <c>51,300</c>, grouped. The digits
    /// are taken from <see cref="Figure.Display"/> and only punctuated — never re-derived from the double
    /// and never re-rounded — so the cell cannot disagree with the exported
    /// <c>extras.harness.columns[*].tokens_per_verified_req</c>, which keeps its ungrouped form and stays
    /// reachable here as the cell's <c>title</c>.
    /// </remarks>
    /// <param name="aRendered">The figure's display string, e.g. <c>2377395.2</c>.</param>
    /// <returns>The same string with grouped thousands, e.g. <c>2,377,395.2</c>.</returns>
    private static string GroupedFigureText(string aRendered)
    {
        var vPoint = aRendered.IndexOf('.', StringComparison.Ordinal);
        var vWhole = vPoint < 0 ? aRendered : aRendered[..vPoint];
        var vFraction = vPoint < 0 ? string.Empty : aRendered[vPoint..];

        return long.TryParse(vWhole, NumberStyles.Integer, CultureInfo.InvariantCulture, out var vDigits)
            ? vDigits.ToString("N0", CultureInfo.InvariantCulture) + vFraction
            : aRendered;
    }

    /// <summary>
    /// The classes on a plain value cell.
    /// </summary>
    /// <remarks>
    /// REQ-UI-023 — <c>docs/mockups/harness.html</c> writes its key/value cells as <c>&lt;td class="r"&gt;</c>
    /// and adds <c>sm</c> to exactly one of them, the <c>Runs by cmd</c> list (<c>.sm{font-size:13px}</c>
    /// against the table's own 14px). That is the design's own answer to this cell being long, so it is
    /// applied here rather than letting the list take a third row.
    /// </remarks>
    /// <param name="aRow">The row being rendered.</param>
    /// <returns>The cell's class list.</returns>
    private static string ValueClassFor(ColumnRow aRow) =>
        aRow.IsSmall ? "tabular-nums tflens-kv-small" : "tabular-nums";

    /// <summary>
    /// Renders a label/count list such as the top commands or the verdict mix.
    /// </summary>
    /// <param name="aPairs">The pairs, busiest first.</param>
    /// <param name="aTake">How many to show.</param>
    /// <returns>A <c>label n · label n</c> line, or the dash when there are none.</returns>
    private static string PairsText(IReadOnlyList<KeyValuePair<string, int>> aPairs, int aTake) =>
        aPairs.Count == 0
            ? Dash
            : string.Join(" · ", aPairs.Take(aTake).Select(aPair => $"{aPair.Key} {aPair.Value}"));

    /// <summary>
    /// Renders a 0..1 share as a CSS width, invariant so a comma decimal can never reach the style.
    /// </summary>
    /// <param name="aShare">The share, 0..1.</param>
    /// <returns>A percentage string such as <c>78%</c>.</returns>
    private static string PercentCss(double aShare) =>
        (aShare * 100d).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    /// <summary>
    /// Renders a 0..1 share as the whole percentage the mockup prints beside the bar.
    /// </summary>
    /// <param name="aShare">The share, 0..1.</param>
    /// <returns>A percentage string such as <c>78%</c>.</returns>
    private static string PercentText(double aShare) =>
        Math.Round(aShare * 100d, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture) + "%";

    /// <summary>
    /// The share of a harness's gate verdicts that passed, for the <c>Verdict mix</c> bar (REQ-UI-023).
    /// </summary>
    /// <param name="aVerdicts">The verdict counts, as the engine produced them.</param>
    /// <returns>
    /// The pass share in 0..1, or <c>null</c> when there are no verdicts to take a share of — a harness
    /// that recorded nothing must read <c>—</c>, never <c>0% pass</c>, which would be a figure derived
    /// from an empty set (BRD §1, and the same rule <see cref="Figure"/> enforces elsewhere).
    /// </returns>
    private static double? PassShareOf(IReadOnlyList<KeyValuePair<string, int>> aVerdicts)
    {
        var vTotal = aVerdicts.Sum(aPair => aPair.Value);

        if (vTotal <= 0)
        {
            return null;
        }

        // "Passed" is the checklist's own terminal-success vocabulary; every other verdict is not a pass.
        var vPassed = aVerdicts
            .Where(aPair => string.Equals(aPair.Key, "Verified", StringComparison.OrdinalIgnoreCase))
            .Sum(aPair => aPair.Value);

        return (double)vPassed / vTotal;
    }

    /// <summary>
    /// Totals one harness's tokens for the supplementary chart and its text table.
    /// </summary>
    /// <param name="aColumn">The harness column.</param>
    /// <returns>The chart row.</returns>
    private static HarnessTokens ToTokenRow(HarnessColumn aColumn)
    {
        var vTotal = aColumn.TokensIn + aColumn.TokensOut + aColumn.TokensCacheRead + aColumn.TokensCacheWrite;

        return new HarnessTokens(
            aColumn.Harness,
            vTotal,
            IsEmpty(aColumn) && vTotal == 0 ? Dash : vTotal.ToString("N0", CultureInfo.InvariantCulture));
    }

    /// <summary>
    /// The sub-line under a harness name.
    /// </summary>
    /// <param name="aColumn">The harness column.</param>
    /// <returns>The product name plus its record count, or the honest "no records" line.</returns>
    private static string SubtitleFor(HarnessColumn aColumn)
    {
        var vRecords = aColumn.Runs + aColumn.GateRecords + aColumn.Sessions;

        return vRecords == 0
            ? $"{ProductNameFor(aColumn.Harness)} · no records"
            : $"{ProductNameFor(aColumn.Harness)} · {vRecords:N0} records";
    }

    /// <summary>
    /// The human name of a harness.
    /// </summary>
    /// <param name="aHarness">The harness key from the engine.</param>
    /// <returns>The product name shown under the column title.</returns>
    private static string ProductNameFor(string aHarness) => aHarness switch
    {
        "claude-code" => "Claude Code CLI",
        OpenCode => "OpenCode",
        "codex" => "Codex CLI",
        _ => aHarness
    };

    /// <summary>
    /// The accent chip colour for a harness, matching the chart's own series colours.
    /// </summary>
    /// <param name="aHarness">The harness key from the engine.</param>
    /// <returns>The scoped accent class.</returns>
    private static string AccentClassFor(string aHarness) => aHarness switch
    {
        "claude-code" => "tflens-accent-1",
        OpenCode => "tflens-accent-2",
        _ => "tflens-accent-3"
    };

    /// <summary>
    /// The bar colour for a harness, matching its column's accent chip.
    /// </summary>
    /// <param name="aHarness">The harness key from the engine.</param>
    /// <returns>The chart token the bar is painted with.</returns>
    private static string ChartColourFor(string aHarness) => aHarness switch
    {
        "claude-code" => ChartColor.Chart1,
        OpenCode => ChartColor.Chart2,
        _ => ChartColor.Chart3
    };

    /// <summary>Re-queries when the workspace changes under the page — a sync, for instance.</summary>
    private void OnShellChanged() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <summary>Unsubscribes so the circuit does not leak a handler per navigation.</summary>
    public void Dispose()
    {
        objShellState.Changed -= OnShellChanged;
        objPreferences.Changed -= OnShellChanged;
    }

    /// <summary>One key/value row inside a harness column.</summary>
    /// <param name="Label">The metric's name, shown in the left cell.</param>
    /// <param name="Text">The plain rendering of the value, also the column's sort key.</param>
    /// <param name="Value">The figure when the row carries one, so FigureText can refuse to print a number.</param>
    /// <param name="TestId">The row value's stable test id.</param>
    /// <param name="PassShare">
    /// Set only on the <c>Verdict mix</c> row (REQ-UI-023). When present the cell renders the mockup's
    /// pass-share bar and one percentage instead of the full verdict list; <c>null</c> everywhere else,
    /// and <c>null</c> too when the harness recorded no gates at all, so an empty column reads
    /// <c>—</c> rather than a confident <c>0% pass</c> drawn from nothing.
    /// </param>
    /// <param name="Exact">
    /// The precise value an abbreviated cell keeps as its native tooltip (REQ-UI-024). Set only on the
    /// four token rows, where <see cref="TokenText"/> rounds for the screen; <c>null</c> everywhere else,
    /// and <c>null</c> too when the compact rendering already is the exact one.
    /// </param>
    /// <param name="IsSmall">
    /// True on the one row the approved mockup marks <c>sm</c> — <c>Runs by cmd (top 3)</c>, whose value
    /// is a three-command list and the longest text on the page (REQ-UI-023).
    /// </param>
    private sealed record ColumnRow(
        string Label,
        string Text,
        Figure? Value,
        string TestId,
        double? PassShare = null,
        string? Exact = null,
        bool IsSmall = false);

    /// <summary>One bar of the tokens-by-harness chart, and one row of the text table beside it.</summary>
    /// <param name="Harness">The harness name.</param>
    /// <param name="Tokens">Input + output + cache read + cache write.</param>
    /// <param name="Display">The same total as text, or <c>—</c> when the harness emitted nothing.</param>
    private sealed record HarnessTokens(string Harness, long Tokens, string Display);

    /// <summary>
    /// The two-property projection the bar chart is given.
    /// </summary>
    /// <remarks>
    /// TR-005 — TrBlazeUI 2.0.0's chart types expose no <c>XValue</c>/<c>YValue</c> and infer the category
    /// and the series from the item type's properties, so this type carries those two and nothing else.
    /// </remarks>
    /// <param name="Harness">The category — the harness name on the x axis.</param>
    /// <param name="Tokens">The series — input + output + cache read + cache write.</param>
    private sealed record HarnessTokenTotal(string Harness, double Tokens);
}
