@*
    REQ-UI-011 / REQ-UI-012 / REQ-UI-013 / REQ-UI-040 / REQ-UI-041 — the Repos screen.

    The only screen that writes: add a source (fetched from a public repo, or imported from metric
    files), sync one, re-import one, remove one. Everything it reads is scoped to the signed-in user
    by parameter, never by filter (ADR-013).

    This screen is the GRID ONLY. Adding, re-importing and removing a source are their own ROUTES
    (REQ-UI-044, 2026-08-28): AddSource.razor at /repos/add and /repos/reimport/{Source},
    RemoveSource.razor at /repos/remove/{Source}. They were modal dialogs until the owner reported
    that adding and removing could leave the whole page dimmed and dead, and nine reproduction
    attempts in headless Chromium could not make that happen — an overlay whose failure mode cannot
    be reproduced from the harness cannot be signed off from it either. Routes have no backdrop to
    strand, no portal to miss, no scroll lock to leak, and no need for the Escape handling TrBlazeUI
    2.0.0 does not ship (TR-014). Do not move these flows back into a dialog.
*@
@page "/repos"
@using TfLens.Core.GitHub
@using TfLens.Core.Import
@using TfLens.Core.Repos
@implements IDisposable
@inject IRepoListReader objRepoListReader
@inject ITelemetryStore objStore
@inject IServiceProvider objServices
@inject ShellState objShellState
@inject ShellPreferences objPreferences
@inject ToastService objToastService
@inject NavigationManager objNavigation

<PageTitle>Repos · TfLens</PageTitle>

<div class="tflens-stack">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <TypographyH2>Repos</TypographyH2>
            <TypographyMuted>Sources you've added — fetched from a public repo, or imported from metric files</TypographyMuted>
        </div>
        <Button OnClick="GoToAddSource" data-testid="connect-repo">
            <LucideIcon Name="plus" Size="16" />
            Add source
        </Button>
    </div>

    <StatGroup Columns="3" data-testid="repos-kpis">
        <StatTile Title="Connected repos"
                  Value="@objRows.Count.ToString()"
                  Description="@SourceBreakdown"
                  IconName="git-branch"
                  Accent="StatAccent.Chart1"
                  Sparkline="@(objConnectedSeries.Count > 1 ? objConnectedSeries : null)"
                  SparklineLabel="sources connected, cumulative by day"
                  data-testid="kpi-repos" />
        <StatTile Title="Records synced"
                  Value="@objRows.Sum(aRow => aRow.RecordCount).ToString("N0")"
                  Description="across every stream of every source"
                  IconName="database"
                  Accent="StatAccent.Chart2"
                  Sparkline="@(objRecordSeries.IsPlottable ? objRecordSeries.Values : null)"
                  SparklineLabel="@RecordSeriesLabel"
                  data-testid="kpi-records" />
        <StatTile Title="Last successful sync"
                  Value="@RelativeTime.Describe(objShellState.LastSyncUtc, DateTimeOffset.UtcNow)"
                  Description="@LastSyncDetail"
                  IconName="clock"
                  Accent="StatAccent.Chart4"
                  data-testid="kpi-last-sync" />
    </StatGroup>

    @if (!objIsLoaded)
    {
        <Card>
            <CardContent Class="p-6">
                <div class="flex flex-col gap-3">
                    <Skeleton Class="h-4 w-full" />
                    <Skeleton Class="h-4 w-3/4" />
                    <Skeleton Class="h-4 w-1/2" />
                </div>
            </CardContent>
        </Card>
    }
    else if (objRows.Count == 0)
    {
        <Empty Title="No sources yet"
               Description="Fetch a public GitHub repo, or import the metric files from a private one."
               Size="EmptySize.Default"
               data-testid="repos-empty">
            <Icon>
                <LucideIcon Name="git-branch" Size="40" />
            </Icon>
            <ChildContent>
                <span class="flex flex-wrap items-center justify-center gap-2">
                    <Button OnClick="GoToFetchViaApi" data-testid="repos-empty-connect">
                        <LucideIcon Name="cloud-download" Size="16" />
                        Fetch via API
                    </Button>
                    <Button Variant="ButtonVariant.Outline"
                            OnClick="GoToImportFiles"
                            data-testid="repos-empty-import">
                        <LucideIcon Name="upload" Size="16" />
                        Import metric files
                    </Button>
                </span>
            </ChildContent>
        </Empty>
    }
    else
    {
        <Card>
            <CardHeader>
                @* REQ-UI-011 — the mockup puts one filter input on this row at 240px, right-aligned,
                   rather than the DataTable's own toolbar (a Search box plus Filter and Columns
                   buttons on a second row). ShowToolbar is off below and the grid is filtered here. *@
                <div class="flex w-full flex-wrap items-start justify-between gap-3">
                    <div>
                        <CardTitle>Connected repos</CardTitle>
                        <CardDescription>
                            Per-row Sync (fetched) or Re-import (imported), and Remove · a failed sync shows its reason on hover
                        </CardDescription>
                    </div>
                    <div class="tflens-repos-filter">
                        <Input Value="@objFilter"
                               ValueChanged="OnFilterChanged"
                               TValue="string"
                               Placeholder="Filter repos…"
                               data-testid="repos-filter" />
                    </div>
                </div>
            </CardHeader>
            <CardContent Class="pt-0">
                <DataTable TData="RepoListItem"
                           Data="@FilteredRows"
                           ShowToolbar="false"
                           ShowPagination="true"
                           InitialPageSize="10"
                           AriaLabel="Connected repos"
                           data-testid="repos-table">
                    <Columns>
                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Repo.Repo)" Header="Repo" Sortable Filterable>
                            <CellTemplate Context="vRow">
                                @if (ImportedSourceRules.IsImported(vRow.Repo.SourceKind))
                                {
                                    <span class="flex items-center gap-2">
                                        <LucideIcon Name="hard-drive" Size="14" Class="text-muted-foreground" />
                                        <span class="font-semibold">@vRow.Repo.Repo</span>
                                    </span>
                                }
                                else
                                {
                                    <a class="flex items-center gap-2 hover:underline"
                                       href="@($"https://github.com/{vRow.Repo.Repo}")"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        <LucideIcon Name="github" Size="14" Class="text-muted-foreground" />
                                        <span class="font-semibold">@vRow.Repo.Repo</span>
                                    </a>
                                }
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Repo.Branch)" Header="Branch" Sortable>
                            <CellTemplate Context="vRow">
                                <span class="font-mono text-xs">@BranchText(vRow)</span>
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Repo.Kind)" Header="Kind" Sortable>
                            <CellTemplate Context="vRow">
                                <Badge Variant="BadgeVariant.Secondary" Class="tflens-badge-info">@vRow.Repo.Kind</Badge>
                            </CellTemplate>
                        </DataTableColumn>

                        @* REQ-UI-041 / BRD-132 — the stored value is api|import; the badge word is Synced|Imported. *@
                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => SourceKinds.DisplayName(aRow.Repo.SourceKind))"
                                         Header="Source" Sortable>
                            <CellTemplate Context="vRow">
                                <Badge Variant="BadgeVariant.Secondary"
                                       Class="@(ImportedSourceRules.IsImported(vRow.Repo.SourceKind) ? string.Empty : "tflens-badge-info")"
                                       data-testid="@($"repo-source-{vRow.Repo.Name}")">
                                    @SourceKinds.DisplayName(vRow.Repo.SourceKind)
                                </Badge>
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Repo.IsPublic ? "public" : "private")" Header="Visibility">
                            <CellTemplate Context="vRow">
                                <Badge Variant="BadgeVariant.Outline">
                                    @if (!vRow.Repo.IsPublic)
                                    {
                                        <LucideIcon Name="lock" Size="11" />
                                    }
                                    @(vRow.Repo.IsPublic ? "public" : "private")
                                </Badge>
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Status)" Header="Status" Sortable>
                            <CellTemplate Context="vRow">
                                @if (objSyncingRepos.Contains(vRow.Repo.Repo))
                                {
                                    <span class="flex items-center gap-2">
                                        <Spinner Size="SpinnerSize.Small" />
                                        <span class="text-xs text-muted-foreground">syncing…</span>
                                    </span>
                                }
                                else if (vRow.LastError is not null)
                                {
                                    <Tooltip>
                                        <TooltipTrigger>
                                            <Badge Variant="BadgeVariant.Destructive"
                                                   data-testid="@($"repo-status-{vRow.Repo.Name}")">error</Badge>
                                        </TooltipTrigger>
                                        <TooltipContent>@vRow.LastError</TooltipContent>
                                    </Tooltip>
                                }
                                else
                                {
                                    <Badge Variant="BadgeVariant.Secondary"
                                           Class="@StatusToneOf(vRow)"
                                           data-testid="@($"repo-status-{vRow.Repo.Name}")">@StatusTextOf(vRow)</Badge>
                                }
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.LastSyncTs ?? string.Empty)"
                                         Header="Last sync / import" Sortable>
                            <CellTemplate Context="vRow">
                                <span class="text-muted-foreground">@LastActivityText(vRow)</span>
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="int"
                                         Property="@(aRow => aRow.RecordCount)" Header="Records" Sortable>
                            <CellTemplate Context="vRow">
                                <span class="tabular-nums">@vRow.RecordCount.ToString("N0")</span>
                            </CellTemplate>
                        </DataTableColumn>

                        <DataTableColumn TData="RepoListItem" TValue="string"
                                         Property="@(aRow => aRow.Repo.Name)" Header="Actions">
                            <CellTemplate Context="vRow">
                                <span class="flex items-center gap-1">
                                    @* REQ-UI-041 / BRD-135 — an imported source gets Re-import, never a Sync
                                       button that would do nothing: the runner skips it server-side. *@
                                    @if (ImportedSourceRules.CanSync(vRow.Repo.SourceKind))
                                    {
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="@($"Sync {vRow.Repo.Repo}")"
                                                Disabled="@objSyncingRepos.Contains(vRow.Repo.Repo)"
                                                OnClick="@(() => SyncRepoAsync(vRow))"
                                                data-testid="@($"repo-sync-{vRow.Repo.Name}")">
                                            @if (objSyncingRepos.Contains(vRow.Repo.Repo))
                                            {
                                                <Spinner Size="SpinnerSize.Small" />
                                            }
                                            else
                                            {
                                                <LucideIcon Name="refresh-cw" Size="14" />
                                            }
                                        </Button>
                                    }
                                    else
                                    {
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="@($"Re-import {vRow.Repo.Repo}")"
                                                OnClick="@(() => GoToReimport(vRow))"
                                                data-testid="@($"repo-reimport-{vRow.Repo.Name}")">
                                            <LucideIcon Name="upload" Size="14" />
                                        </Button>
                                    }
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.IconSmall"
                                            AriaLabel="@($"Remove {vRow.Repo.Repo}")"
                                            OnClick="@(() => GoToRemove(vRow))"
                                            data-testid="@($"repo-remove-{vRow.Repo.Name}")">
                                        <LucideIcon Name="trash-2" Size="14" />
                                    </Button>
                                </span>
                            </CellTemplate>
                        </DataTableColumn>
                    </Columns>
                </DataTable>
                <p class="mt-2 text-xs text-muted-foreground" data-testid="repos-source-note">
                    Imported sources have no Sync — they are re-imported, and the poller skips them.
                </p>
            </CardContent>
        </Card>
    }
</div>


@code {
    private readonly HashSet<string> objSyncingRepos = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<RepoListItem> objRows = [];

    /// <summary>
    /// Records-per-day history behind the Records-synced tile's sparkline (REQ-UI-011).
    /// </summary>
    /// <remarks>
    /// Scoped to the framework selected in the header, which is narrower than the tile's headline
    /// count (that spans every source of both frameworks). The mismatch is why the label below names
    /// the framework explicitly rather than leaving the reader to assume the line tracks the number
    /// above it — an unlabelled trend line invites exactly that reading.
    /// </remarks>
    private DailySeries objRecordSeries = DailySeries.Empty;

    /// <summary>
    /// Sources connected, cumulative by day — the Connected-repos tile's sparkline (REQ-UI-011).
    /// </summary>
    /// <remarks>
    /// Derived from each source's own <c>ConnectedTs</c>, which is stored, so this is real history
    /// and not a decorative curve. It is computed from the rows already on screen rather than with a
    /// second query. The third tile, Last successful sync, gets NO sparkline: only the latest sync
    /// per source is stored, so there is no history to plot, and drawing one would be the invented
    /// figure this product exists to prevent. That divergence from the mockup is deliberate.
    /// </remarks>
    private IReadOnlyList<double> objConnectedSeries = [];

    /// <summary>What the user has typed into the grid's filter box.</summary>
    private string objFilter = string.Empty;

    /// <summary>
    /// What the Records-synced sparkline actually plots, named on its face.
    /// </summary>
    /// <remarks>
    /// The series is one framework's records; the tile's headline counts every source of both. Saying
    /// so is what stops the line being read as the trend of the number above it.
    /// </remarks>
    private string RecordSeriesLabel =>
        $"{objRecordSeries.Label} — {objPreferences.Framework} sources only";
    private bool objIsLoaded;
    private int? objUserId;

    /// <summary>The signed-in principal, cascaded by <c>AddCascadingAuthenticationState</c>.</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The rows the grid shows — every row, or those matching the filter box.
    /// </summary>
    /// <remarks>
    /// The mockup puts one filter input on the card header rather than using the DataTable's own
    /// toolbar, so the filtering is done here. Repo, kind, framework and source are all matched,
    /// which is what a reader typing "playbook" or "imported" expects.
    /// </remarks>
    private IReadOnlyList<RepoListItem> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(objFilter))
            {
                return objRows;
            }

            var vNeedle = objFilter.Trim();

            return objRows
                .Where(aRow =>
                    Contains(aRow.Repo.Repo, vNeedle)
                    || Contains(aRow.Repo.Kind, vNeedle)
                    || Contains(aRow.Repo.Framework, vNeedle)
                    || Contains(aRow.Repo.Branch, vNeedle)
                    || Contains(SourceKinds.DisplayName(aRow.Repo.SourceKind), vNeedle)
                    || Contains(StatusTextOf(aRow), vNeedle))
                .ToList();
        }
    }

    /// <summary>
    /// Case-insensitive substring match that tolerates a null field.
    /// </summary>
    /// <param name="aValue">The field being searched.</param>
    /// <param name="aNeedle">What the user typed.</param>
    /// <returns>True when the field carries the needle.</returns>
    private static bool Contains(string? aValue, string aNeedle) =>
        aValue is not null && aValue.Contains(aNeedle, StringComparison.OrdinalIgnoreCase);

    /// <summary>Records what the user typed and re-renders the grid.</summary>
    /// <param name="aFilter">The new filter text.</param>
    private void OnFilterChanged(string? aFilter) => objFilter = aFilter ?? string.Empty;

    /// <summary>The sub-line under the repo count — how the sources split by origin and framework.</summary>
    private string SourceBreakdown
    {
        get
        {
            var vImported = objRows.Count(aRow => ImportedSourceRules.IsImported(aRow.Repo.SourceKind));
            var vSynced = objRows.Count - vImported;
            var vTechieFlow = objRows.Count(aRow => aRow.Repo.Framework == FrameworkNames.TechieFlow);
            var vPlaybook = objRows.Count(aRow => aRow.Repo.Framework == FrameworkNames.Playbook);

            return $"{vSynced} {SourceKinds.ApiLabel.ToLowerInvariant()} · "
                + $"{vImported} {SourceKinds.ImportLabel.ToLowerInvariant()} · "
                + $"{vTechieFlow} techieflow · {vPlaybook} playbook";
        }
    }

    /// <summary>The sub-line under the last-sync tile.</summary>
    private string LastSyncDetail
    {
        get
        {
            var vErrors = objRows.Count(aRow => aRow.LastError is not null);
            return vErrors == 0
                ? $"{objRows.Count} sources · no sync errors"
                : $"{objRows.Count} sources · {vErrors} with errors";
        }
    }

    /// <summary>Re-renders when the shell reloads the workspace under this page.</summary>
    protected override void OnInitialized()
    {
        objShellState.Changed += OnShellChanged;
    }

    /// <summary>
    /// Resolves the signed-in user and loads their sources.
    /// </summary>
    /// <returns>A task that completes when the grid has its rows.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (objIsLoaded || AuthenticationStateTask is null)
        {
            return;
        }

        var vState = await AuthenticationStateTask;
        objUserId = ShellIdentity.UserId(vState.User);

        if (objUserId is null)
        {
            objIsLoaded = true;
            return;
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Re-reads the user's sources and keeps the shell's badge and header in step.
    /// </summary>
    /// <returns>A task that completes when the grid and the shell agree.</returns>
    private async Task ReloadAsync()
    {
        if (objUserId is null)
        {
            return;
        }

        objRows = await objRepoListReader.ListWithCountsAsync(objUserId.Value);
        await objShellState.RefreshAsync(objUserId.Value);

        // REQ-UI-011 — the Records-synced tile states a count of records, so its sparkline plots
        // exactly that: records per day, from the stored history, on the same DailySeries the
        // Coverage, Three-questions and Routing tiles already use. The mockup gives all three tiles
        // a trend line; the other two do NOT get one, because "Connected repos" and "Last successful
        // sync" have no stored history and a line drawn through invented points is precisely the
        // plausible-looking fabrication this product exists to prevent (see DailyCount's remarks).
        // IsPlottable keeps it off screen until there is enough real history to mean something.
        objRecordSeries = await objStore.ReadDailySeriesAsync(
            objUserId.Value, objPreferences.Framework, StreamKind.Gates);

        objConnectedSeries = BuildConnectedSeries(objRows);
        objIsLoaded = true;
    }

    /// <summary>
    /// Syncs one repository from its row action.
    /// </summary>
    /// <param name="aRow">The row whose repository to sync.</param>
    /// <returns>A task that completes when the row shows the new counts.</returns>
    private async Task SyncRepoAsync(RepoListItem aRow)
    {
        if (!ImportedSourceRules.CanSync(aRow.Repo.SourceKind))
        {
            objToastService.Show(ImportedSourceRules.CannotSyncMessage, "Imported source");
            return;
        }

        var vRunner = objServices.GetService<IRepoSyncRunner>();

        if (vRunner is null || objUserId is null)
        {
            objToastService.Error("Sync is not available in this build.", "Sync");
            return;
        }

        objSyncingRepos.Add(aRow.Repo.Repo);
        StateHasChanged();

        try
        {
            var vResult = await vRunner.SyncRepoAsync(objUserId.Value, aRow.Repo.Repo);

            if (vResult.Outcome == SyncOutcome.Error)
            {
                objToastService.Error($"{aRow.Repo.Repo} — {vResult.Error}", "Sync failed");
            }
            else
            {
                objToastService.Success(
                    $"{aRow.Repo.Repo} — {vResult.Outcome.ToString().ToLowerInvariant()} ({vResult.RecordsWritten:N0} records)",
                    "Sync");
            }
        }
        catch (GitHubRateLimitException vEx)
        {
            objToastService.Error(vEx.Message, "Sync failed");
        }
        catch (Exception vEx)
        {
            objToastService.Error(vEx.Message, "Sync failed");
        }
        finally
        {
            objSyncingRepos.Remove(aRow.Repo.Repo);
            await ReloadAsync();
        }
    }

    /// <summary>
    /// The Branch cell — an imported source was never read from a branch.
    /// </summary>
    /// <param name="aRow">The grid row.</param>
    /// <returns>The branch, or an em dash.</returns>
    private static string BranchText(RepoListItem aRow) =>
        ImportedSourceRules.IsImported(aRow.Repo.SourceKind) || string.IsNullOrWhiteSpace(aRow.Repo.Branch)
            ? "—"
            : aRow.Repo.Branch;

    /// <summary>
    /// The Status badge's word — an imported source is "imported", never "synced" (BRD-135).
    /// </summary>
    /// <param name="aRow">The grid row.</param>
    /// <returns>The status word.</returns>
    private static string StatusTextOf(RepoListItem aRow) =>
        ImportedSourceRules.IsImported(aRow.Repo.SourceKind) && aRow.Status != RepoSyncStatuses.Pending
            ? "imported"
            : aRow.Status;

    /// <summary>
    /// The Last-sync-or-import cell — it reads last <i>import</i> for an imported row (REQ-UI-041).
    /// </summary>
    /// <param name="aRow">The grid row.</param>
    /// <returns>How long ago the source last took data on.</returns>
    private static string LastActivityText(RepoListItem aRow) =>
        ImportedSourceRules.IsImported(aRow.Repo.SourceKind)
            ? RelativeTime.Describe(aRow.Repo.LastImportTs, DateTimeOffset.UtcNow)
            : RelativeTime.Describe(RelativeTime.Parse(aRow.LastSyncTs), DateTimeOffset.UtcNow);

    /// <summary>
    /// The status badge's tone — the mockup's success / warning / plain, which TrBlazeUI has no
    /// variant for (TR-016).
    /// </summary>
    /// <param name="aRow">The grid row.</param>
    /// <returns>The tone class, or an empty string for a status that carries no tone.</returns>
    private static string StatusToneOf(RepoListItem aRow)
    {
        var vStatus = StatusTextOf(aRow);

        if (vStatus.Contains("stale", StringComparison.OrdinalIgnoreCase))
        {
            return "tflens-badge-warning";
        }

        return vStatus is RepoSyncStatuses.Pending
            ? string.Empty
            : "tflens-badge-success";
    }

    /// <summary>
    /// Builds the cumulative connected-sources series from the rows already loaded.
    /// </summary>
    /// <param name="aRows">The user's sources.</param>
    /// <returns>One point per day a source was connected, running total, oldest first.</returns>
    private static IReadOnlyList<double> BuildConnectedSeries(IReadOnlyList<RepoListItem> aRows)
    {
        var vDays = aRows
            .Select(aRow => RelativeTime.Parse(aRow.Repo.ConnectedTs))
            .Where(aTs => aTs is not null)
            .Select(aTs => aTs!.Value.UtcDateTime.Date)
            .GroupBy(aDay => aDay)
            .OrderBy(aGroup => aGroup.Key)
            .ToList();

        var vRunning = 0d;

        return vDays.Select(aGroup => vRunning += aGroup.Count()).ToList();
    }

    /// <summary>Re-renders when the shell reloads the workspace.</summary>
    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Opens the Add-source page on its default (Fetch via API) mode.</summary>
    private void GoToAddSource() => objNavigation.NavigateTo("/repos/add");

    /// <summary>Opens the Add-source page straight on the Fetch-via-API mode.</summary>
    private void GoToFetchViaApi() => objNavigation.NavigateTo($"/repos/add/{SourceKinds.Api}");

    /// <summary>Opens the Add-source page straight on the Import-metric-files mode.</summary>
    private void GoToImportFiles() => objNavigation.NavigateTo($"/repos/add/{SourceKinds.Import}");

    /// <summary>
    /// Sends the user to the re-import page for one imported source.
    /// </summary>
    /// <remarks>
    /// The name carries a slash, so it is escaped once here and unescaped once by the page. Both
    /// halves are in this pair of methods so a reader can see the round trip in one place.
    /// </remarks>
    /// <param name="aRow">The imported row whose bundle is being replaced.</param>
    private void GoToReimport(RepoListItem aRow) =>
        objNavigation.NavigateTo($"/repos/reimport/{Uri.EscapeDataString(aRow.Repo.Repo)}");

    /// <summary>
    /// Sends the user to the remove confirmation for one source.
    /// </summary>
    /// <param name="aRow">The row the user asked to remove.</param>
    private void GoToRemove(RepoListItem aRow) =>
        objNavigation.NavigateTo($"/repos/remove/{Uri.EscapeDataString(aRow.Repo.Repo)}");

    /// <summary>Unsubscribes the shell handler so it does not leak.</summary>
    public void Dispose() => objShellState.Changed -= OnShellChanged;
}
