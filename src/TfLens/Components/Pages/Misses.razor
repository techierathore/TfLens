    private static string EscapeShareDetail(MissSegmentFigures aSegment) =>
        $"found_by owner or production, over {aSegment.Misses} misses — NOT the gates-derived escape rate on Gate outcomes";

    /// <summary>The sub-line under the rework-tokens tile, which names the records behind it.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The sub-line.</returns>
    private static string SoleTokensDetail(MissSegmentFigures aSegment) =>
        $"output tokens per miss, over cost_attribution: sole fixes only ({aSegment.Cost.SoleRecords} of {aSegment.MissFixes})";

    /// <summary>The OpenCode row of the segment's money, or <c>null</c> when the harness emitted none.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The OpenCode row.</returns>
    private static MissHarnessCost? OpenCodeRow(MissSegmentFigures aSegment) =>
        aSegment.Cost.ByHarness.FirstOrDefault(aRow =>
            string.Equals(aRow.Harness, OpenCodeHarness, StringComparison.OrdinalIgnoreCase));

    /// <summary>Measured OpenCode dollars, or an em dash — absent cost is never <c>$0.00</c>.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The display string.</returns>
    private static string MeasuredUsdDisplay(MissSegmentFigures aSegment) =>
        OpenCodeRow(aSegment)?.MeasuredUsdTotal is { } vUsd
            ? vUsd.ToString("C2", CultureInfo.GetCultureInfo("en-US"))
            : Missing;

    /// <summary>The sub-line under the measured-USD tile, which names its harness.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The sub-line.</returns>
    private static string MeasuredUsdDetail(MissSegmentFigures aSegment)
    {
        var vRow = OpenCodeRow(aSegment);

        return vRow is null || vRow.MeasuredUsdRecords == 0
            ? "opencode · measured — no OpenCode fix record carries cost_usd yet; the only measured dollars in the product"
            : $"opencode · measured — Σ cost_usd over {vRow.MeasuredUsdRecords} records; the only measured dollars in the product";
    }

    /// <summary>The <c>n of N misses assessed</c> line the failed-practice card carries on its face.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The denominator sentence.</returns>
    private static string AssessedLine(MissSegmentFigures aSegment) =>
        $"{aSegment.WhyMissedEligibility.Assessed} of {aSegment.WhyMissedEligibility.Eligible} misses assessed";

    /// <summary>The footer that separates "not assessed" from "predates the field" (BRD-117).</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The footer sentence.</returns>
    private static string WhyMissedFooter(MissSegmentFigures aSegment)
    {
        var vEligibility = aSegment.WhyMissedEligibility;
        var vUnassessed = Math.Max(0, vEligibility.Eligible - vEligibility.Assessed);
        var vSince = vEligibility.Since is { Length: > 0 } vDate ? $" (added {vDate})" : string.Empty;

        // Eligible and Assessed are DIFFERENT numbers and must never be described as each other:
        // Eligible = misses written on or after the field's floor, so they COULD carry it;
        // Assessed  = misses that actually DO carry it, which is the distribution's real denominator.
        // Calling Eligible "the misses that carry the field" (as this line did until 2026-08-28)
        // overstates the denominator whenever some eligible miss left the field null — which is the
        // normal case — and contradicts the badge directly above it. REQ-NFR-013 clause 3 requires the
        // denominator to be printed on its face; printing the wrong one is the same defect wearing a
        // number.
        var vHead = vEligibility.Assessed == aSegment.Misses
            ? $"Denominator is {vEligibility.Assessed} — every miss here carries the field."
            : $"Denominator is {vEligibility.Assessed} — the misses that carry the field, not the "
              + $"{aSegment.Misses} in this segment.";

        var vFloor = vEligibility.PredatesField == 0
            ? $"No miss here predates the field{vSince}."
            : $"A further {vEligibility.PredatesField} predate the field{vSince} and leave this denominator entirely "
              + "rather than being backfilled with a value nobody assessed at the time.";

        return $"{vHead} why_missed is optional and null means not assessed — never a zero in some category. "
               + $"Of the {vEligibility.Eligible} eligible to carry it, {vUnassessed} carry no assessment. {vFloor}";
    }

    /// <summary>The <c>n of N sorted</c> line the whose-gap card carries on its face (BRD-172).</summary>
    /// <remarks>
    /// <c>N</c> is <see cref="FieldEligibility.Eligible"/> — the misses that <i>could</i> carry a
    /// <c>sort</c> — and never the miss count. A <c>sort</c> figure expressed as a percentage of all
    /// misses is the wrong number this whole shape exists to refuse.
    /// </remarks>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The denominator sentence.</returns>
    private static string SortedLine(MissSegmentFigures aSegment) =>
        $"{aSegment.SortN} of {aSegment.SortEligibility.Eligible} sorted";

    /// <summary>The share column's header, which names the denominator the bars are read against.</summary>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The header text.</returns>
    private static string SortShareHeader(MissSegmentFigures aSegment) =>
        aSegment.SortN == 1 ? "Share of the 1 answered" : $"Share of the {aSegment.SortN} answered";

    /// <summary>
    /// The line that states the records written before <c>sort</c> existed, apart (BRD-172).
    /// </summary>
    /// <remarks>
    /// In those words — <i>predating the field</i>, never <i>unsorted</i>. A record from before the
    /// question was asked is not a record that declined to answer it, and the two are never added
    /// together. The unanswered count is stated beside it, and the two remain separate figures.
    /// </remarks>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The footer sentence.</returns>
    private static string SortPredatesLine(MissSegmentFigures aSegment)
    {
        var vEligibility = aSegment.SortEligibility;
        var vUnanswered = Math.Max(0, vEligibility.Eligible - vEligibility.Assessed);
        var vSince = vEligibility.Since is { Length: > 0 } vDate ? $" ({vDate})" : string.Empty;

        var vFloor = vEligibility.PredatesField == 0
            ? $"No miss here predates the field{vSince}."
            : $"{vEligibility.PredatesField} {(vEligibility.PredatesField == 1 ? "miss predates" : "misses predate")} "
              + $"the field{vSince} — written before sort existed, and reported here rather than counted "
              + "as records that declined to answer. A record from before the question was asked is not a "
              + "record that declined to answer it, and the two are never added together.";

        var vUnrecognised = aSegment.SortUnrecognised == 0
            ? string.Empty
            : $" {aSegment.SortUnrecognised} carry a value outside the four; each keeps its own row rather "
              + "than being coerced into the nearest legal one.";

        return $"The denominator is {vEligibility.Eligible}. {vFloor} Of those eligible to carry it, "
               + $"{vUnanswered} carry no answer.{vUnrecognised}";
    }

    /// <summary>The line that says how many answers arrived on a later <c>miss-amend</c> (BRD-176).</summary>
    /// <returns>The footer sentence.</returns>
    private string SortAmendedLine()
    {
        var vAmended = SegmentOf(objSelectedType).AmendedValues.GetValueOrDefault(MissSorts.Field);

        return vAmended == 0
            ? "No answer here arrived on a later miss-amend. An amend completes a record and never edits it, "
              + "so a stored miss row still carries null wherever one did."
            : $"{vAmended} of the answers arrived later, by a miss-amend folded in at read time. The stored "
              + "miss rows still carry null — an amend completes a record and never edits it.";
    }

    /// <summary>
    /// The eligibility half of the <c>what</c> note (BRD-173, BRD-117).
    /// </summary>
    /// <remarks>
    /// The same floor as <c>sort</c>: a miss written before 2026-09-07 had no sentence to leave empty, so
    /// it says it predates the field rather than reading as a record whose owner said nothing.
    /// </remarks>
    /// <param name="aSegment">The selected segment.</param>
    /// <returns>The sentence.</returns>
    private string WhatEligibilityLine(MissSegmentFigures aSegment)
    {
        var vWith = SegmentMisses.Count(aMiss => aMiss.What is { Length: > 0 });
        var vPredates = SegmentMisses.Count(aMiss =>
            aMiss.What is null
            && !LateGateCoverageCalculator.IsEligibleForField(MissAmendFolder.WhatField, aMiss.Ts));

        return $"{vWith} of {aSegment.Misses} misses here carry one; {vPredates} predate the field "
               + "(2026-09-07) and say so rather than showing a blank.";
    }

    /// <summary>The order the four review phases are listed in; an unknown phase sorts last.</summary>
    /// <param name="aPhase">The stored <c>phase</c> value.</param>
    /// <returns>Its index in the closed vocabulary, or the vocabulary's length.</returns>
    private static int PhaseOrder(string aPhase)
    {
        var vIndex = MissReviewPhases.All.ToList().IndexOf(aPhase);
        return vIndex < 0 ? MissReviewPhases.All.Count : vIndex;
    }

    /// <summary>
    /// The line naming the review phases no record has arrived for (BRD-175).
    /// </summary>
    /// <remarks>
    /// A phase with no record does <b>not</b> get a row of <c>not available</c>s: an invented row reads
    /// as a review that happened and cost nothing. The absence is stated in a sentence instead.
    /// </remarks>
    /// <returns>The sentence.</returns>
    private string ReviewPhasesLine()
    {
        var vSeen = ReviewRows
            .Select(aRow => aRow.Phase)
            .ToHashSet(StringComparer.Ordinal);

        var vMissing = MissReviewPhases.All
            .Where(aPhase => !vSeen.Contains(aPhase))
            .ToList();

        var vBase = ReviewRows.Count == 1
            ? "One review record in this segment; each row is one record, never a total over several."
            : $"{ReviewRows.Count} review records in this segment; each row is one record, never a total over several.";

        return vMissing.Count == 0
            ? $"{vBase} All four review phases have a record."
            : $"{vBase} No record has arrived for {string.Join(", ", vMissing)} — an absence of records, "
              + "which is why there is no row for it rather than a row of zeros.";
    }

    /// <summary>
    /// One copied review cost cell — the token window, and the measured dollars only when the record
    /// carries them.
    /// </summary>
    /// <remarks>
    /// An absent figure reads <c>not available</c>, never <c>0</c>: the record names the run, so a zero
    /// would read as a run that cost nothing rather than as a window the emitter could not copy.
    /// </remarks>
    /// <param name="aTokens">Output tokens the emitter copied, or <c>null</c>.</param>
    /// <param name="aUsd">Measured dollars the emitter copied, or <c>null</c>.</param>
    /// <returns>The cell content.</returns>
    private RenderFragment RenderReviewCost(int? aTokens, decimal? aUsd) =>
        @<text>
            @if (aTokens is { } vTokens)
            {
                <span class="tabular-nums">@vTokens.ToString("N0", CultureInfo.InvariantCulture)</span>
                @if (aUsd is { } vUsd)
                {
                    <span class="ml-1 text-xs text-muted-foreground">@vUsd.ToString("C2", CultureInfo.GetCultureInfo("en-US"))</span>
                }
            }
            else if (aUsd is { } vOnlyUsd)
            {
                <span class="tabular-nums">@vOnlyUsd.ToString("C2", CultureInfo.GetCultureInfo("en-US"))</span>
            }
            else
            {
                <span class="text-xs italic text-muted-foreground">@NotAvailable</span>
            }
        </text>;

    /// <summary>
    /// The <c>what</c> cell of a detail row — the owner's own sentence, or a statement of its absence.
    /// </summary>
    /// <remarks>
    /// This is the only string on this page that came out of a stream as prose (BRD-173, BRD-84). It is
    /// rendered verbatim; nothing is truncated, reworded or joined to anything else.
    /// </remarks>
    /// <param name="aMiss">The folded miss.</param>
    /// <returns>The sentence, or the reason there is none.</returns>
    private static string WhatOf(MissRecord aMiss)
    {
        if (aMiss.What is { Length: > 0 } vWhat)
        {
            return vWhat;
        }

        return LateGateCoverageCalculator.IsEligibleForField(MissAmendFolder.WhatField, aMiss.Ts)
            ? "No description recorded on this miss."
            : "No description — this record predates the field (7 September 2026).";
    }

    /// <summary>
    /// The whose-gap cell of a detail row, in words (BRD-171).
    /// </summary>
    /// <remarks>
    /// The raw token never reaches the page. A stored value outside the four is shown <b>as it stands</b>
    /// and named as unrecognised rather than coerced to the nearest legal one (BRD-170).
    /// </remarks>
    /// <param name="aMiss">The folded miss.</param>
    /// <returns>The English, or the reason there is none.</returns>
    private static string WhoseGapOf(MissRecord aMiss)
    {
        if (aMiss.Sort is { Length: > 0 } vSort)
        {
            return SortVocabulary.TryGetValue(vSort, out var vWording)
                ? vWording.Answer
                : $"{vSort} — not one of the four";
        }

        return LateGateCoverageCalculator.IsEligibleForField(MissSorts.Field, aMiss.Ts)
            ? "not sorted"
            : "predates the field";
    }

    /// <summary>The breakdown of the excluded records by confidence value, or empty when there are none.</summary>
    /// <param name="aTaint">The segment's attribution split.</param>
    /// <returns>A parenthesised breakdown, or an empty string.</returns>
    private static string ExcludedBreakdown(MissAttributionSet aTaint) =>
        aTaint.ExcludedByConfidence.Count == 0
            ? string.Empty
            : " (" + string.Join(", ", aTaint.ExcludedByConfidence.Select(aRow => $"{aRow.Confidence}: {aRow.Records}")) + ")";

    /// <summary>How many open misses carry a <c>deferred</c> verdict, which stays open by design.</summary>
    /// <returns>The count.</returns>
    private int DeferredCount()
    {
        var vLatest = LatestFixByMiss();

        return SegmentMisses.Count(aMiss =>
            vLatest.TryGetValue(LinkKey(aMiss.Repo, aMiss.MissId), out var vFix)
            && string.Equals(vFix.VerdictAfter, "deferred", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>The fix records the rate card may price — never OpenCode's, whose dollars are measured.</summary>
    /// <returns>The estimable fixes.</returns>
    private IReadOnlyList<MissFixRecord> EstimableFixes() =>
        SegmentFixes
            .Where(aFix => !string.Equals(aFix.Harness, OpenCodeHarness, StringComparison.OrdinalIgnoreCase)
                           && !string.Equals(aFix.TokensScope, NoTokenScope, StringComparison.OrdinalIgnoreCase)
                           && (aFix.TokensIn is not null || aFix.TokensOut is not null
                               || aFix.TokensCacheRead is not null || aFix.TokensCacheWrite is not null))
            .ToList();

    /// <summary>The latest fix per miss, keyed the way the engine keys a miss.</summary>
    /// <returns>One fix record per miss that has any.</returns>
    private Dictionary<string, MissFixRecord> LatestFixByMiss()
    {
        var vLatest = new Dictionary<string, MissFixRecord>(StringComparer.Ordinal);

        foreach (var vFix in objPeriodFixes.Where(aFix => aFix.Backfilled != true))
        {
            var vKey = LinkKey(vFix.Repo, vFix.MissId);

            if (!vLatest.TryGetValue(vKey, out var vCurrent)
                || string.CompareOrdinal(vFix.Ts, vCurrent.Ts) > 0)
            {
                vLatest[vKey] = vFix;
            }
        }

        return vLatest;
    }

    /// <summary>The key a miss and its fixes are joined on — repository plus miss id.</summary>
    /// <param name="aRepo">The source repository.</param>
    /// <param name="aMissId">The miss id.</param>
    /// <returns>The join key.</returns>
    private static string LinkKey(string aRepo, string aMissId) => $"{aRepo}{aMissId}";

    /// <summary>The origin cell of a detail row — phase and agent, or a plain statement that neither is named.</summary>
    /// <param name="aMiss">The folded miss.</param>
    /// <returns>The cell text.</returns>
    private static string OriginOf(MissRecord aMiss)
    {
        var vPhase = aMiss.OriginPhase;
        var vAgent = aMiss.OriginAgent;

        if (vPhase is null && vAgent is null)
        {
            return "not named";
        }

        return vAgent is null ? vPhase! : $"{vPhase ?? "not named"} · {vAgent}";
    }

    /// <summary>The found-by cell, which names the gate when a gate caught it.</summary>
    /// <param name="aMiss">The folded miss.</param>
    /// <returns>The cell text.</returns>
    private static string FoundByOf(MissRecord aMiss) =>
        aMiss.FoundBy is null
            ? Missing
            : aMiss.FoundGate is { Length: > 0 } vGate ? $"{aMiss.FoundBy} · {vGate}" : aMiss.FoundBy;

    /// <summary>
    /// The status of one miss.
    /// </summary>
    /// <remarks>
    /// Reads the latest fix's verdict, exactly as <see cref="MissFigures"/> does: <c>wont-fix</c> is its
    /// own state and <c>deferred</c> is open (BRD-120). A miss with no fix at all is open.
    /// </remarks>
    /// <param name="aFix">The latest fix for the miss, or <c>null</c>.</param>
    /// <returns>The status word shown in the row.</returns>
    private static string StatusOf(MissFixRecord? aFix) => aFix?.VerdictAfter ?? "open";

    /// <summary>The token cell of a detail row; an unattributable fix shows an em dash, never a zero.</summary>
    /// <param name="aFix">The latest fix for the miss, or <c>null</c>.</param>
    /// <returns>The cell text.</returns>
    private static string TokensOf(MissFixRecord? aFix)
    {
        if (aFix is null
            || string.Equals(aFix.TokensScope, NoTokenScope, StringComparison.OrdinalIgnoreCase)
            || aFix.TokensOut is null)
        {
            return Missing;
        }

        return aFix.TokensOut.Value.ToString("N0", CultureInfo.InvariantCulture);
    }

    /// <summary>The field names inside an overflow payload — names only, never values (SCHEMA.md §9).</summary>
    /// <param name="aOverflow">The stored overflow JSON, or <c>null</c>.</param>
    /// <returns>The property names, sorted.</returns>
    private static IReadOnlyList<string> OverflowNames(string? aOverflow)
    {
        if (string.IsNullOrWhiteSpace(aOverflow))
        {
            return [];
        }

        try
        {
            return JsonNode.Parse(aOverflow) is JsonObject vObject
                ? vObject.Select(aPair => aPair.Key).OrderBy(aKey => aKey, StringComparer.Ordinal).ToList()
                : [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    /// <summary>The percentage a share bar fills, clamped so a rounding artefact cannot overflow the track.</summary>
    /// <param name="aCount">The bucket's count.</param>
    /// <param name="aDenominator">The distribution's own denominator.</param>
    /// <returns>A value between 0 and 100.</returns>
    private static double SharePercent(int aCount, int aDenominator) =>
        aDenominator <= 0 ? 0d : Math.Clamp(aCount * 100d / aDenominator, 0d, 100d);

    /// <summary>Shrinks a headline that is a sentence rather than a number, so it fits its tile.</summary>
    /// <param name="aFigure">The figure being rendered.</param>
    /// <returns>The extra classes, or an empty string.</returns>
    private static string SmallWhenNoNumber(Figure aFigure) =>
        aFigure.HasValue ? string.Empty : "text-base font-normal";

    /// <summary>Re-loads when the header Framework switch changes the axis (ADR-016).</summary>
    private void OnPreferencesChanged() =>
        InvokeAsync(async () =>
        {
            if (objLoadedFramework != objPreferences.Framework)
            {
                await LoadAsync();
            }

            StateHasChanged();
        });

    /// <summary>Unsubscribes so the circuit does not leak a handler per navigation.</summary>
    public void Dispose()
    {
        objPreferences.Changed -= OnPreferencesChanged;
    }

    /// <summary>One choice in the period filter.</summary>
    /// <param name="Key">The stored value.</param>
    /// <param name="Label">What the select shows.</param>
    /// <param name="Days">How many days back the window reaches, or <c>null</c> for all history.</param>
    /// <param name="Badge">The short form shown in the badge beside the select.</param>
    private sealed record PeriodOption(string Key, string Label, int? Days, string Badge);

    /// <summary>One row of the origin-phase × miss-class cross-tab.</summary>
    /// <param name="Phase">The originating phase.</param>
    /// <param name="Counts">Misses per miss class.</param>
    /// <param name="Total">Misses attributed to the phase.</param>
    /// <param name="Runs">Runs of that phase in the window, or <c>null</c> when none were observed.</param>
    /// <param name="Rate">Misses per run, or <c>null</c> when the engine reported no rate for the phase.</param>
    private sealed record OriginRow(
        string Phase,
        IReadOnlyDictionary<string, int> Counts,
        int Total,
        int? Runs,
        Figure? Rate)
    {
        /// <summary>The count in one class column.</summary>
        /// <param name="aClass">The miss class.</param>
        /// <returns>The count, or zero.</returns>
        public int CountOf(string aClass) => Counts.GetValueOrDefault(aClass);
    }

    /// <summary>One row of the failed-practice distribution.</summary>
    /// <param name="Practice">The <c>why_missed</c> value.</param>
    /// <param name="Count">Records carrying it.</param>
    /// <param name="Share">Its share of the assessed denominator, as the reference prints it.</param>
    /// <param name="SharePercent">The same share as a bar width.</param>
    private sealed record PracticeRow(string Practice, int Count, string Share, double SharePercent);

    /// <summary>The English and the fixed remedy one <c>sort</c> value is rendered as.</summary>
    /// <param name="Answer">Whose gap it was, in words — never the raw value.</param>
    /// <param name="Response">The one fixed response that answer names.</param>
    private sealed record SortWording(string Answer, string Response);

    /// <summary>One row of the whose-gap distribution.</summary>
    /// <param name="Answer">Whose gap it was, in words.</param>
    /// <param name="Count">Records carrying it.</param>
    /// <param name="Share">Its share of the answered denominator, as the engine prints it.</param>
    /// <param name="SharePercent">The same share as a bar width.</param>
    /// <param name="Response">The fixed response that answer names.</param>
    private sealed record SortRow(string Answer, int Count, string Share, double SharePercent, string Response);

    /// <summary>One row of the review-cost band — every figure exactly as the record carries it.</summary>
    /// <param name="Phase">The review phase.</param>
    /// <param name="Corrections">Corrections the owner gave, or <c>null</c> when not captured.</param>
    /// <param name="TokensProduce">Output tokens of the produce run, or <c>null</c>.</param>
    /// <param name="CostProduceUsd">Measured produce dollars, or <c>null</c>.</param>
    /// <param name="TokensCorrect">Output tokens of the correction run, or <c>null</c>.</param>
    /// <param name="CostCorrectUsd">Measured correction dollars, or <c>null</c>.</param>
    private sealed record ReviewRow(
        string Phase,
        int? Corrections,
        int? TokensProduce,
        decimal? CostProduceUsd,
        int? TokensCorrect,
        decimal? CostCorrectUsd)
    {
        /// <summary>
        /// The corrections' token window as a share of the produce window, or <c>null</c>.
        /// </summary>
        /// <remarks>
        /// A <b>ratio of the two copied figures</b>, not a third cost and not a re-derivation of either:
        /// it is the arithmetic a reader would otherwise do in their head, and it refuses to appear at
        /// all unless both figures are present. BRD-175's rule stands — TfLens computes no review cost.
        /// </remarks>
        public string? CorrectionShare =>
            TokensProduce is { } vProduce and > 0 && TokensCorrect is { } vCorrect
                ? ((double)vCorrect / vProduce).ToString("P0", CultureInfo.InvariantCulture)
                : null;
    }

    /// <summary>One row of a per-origin distribution.</summary>
    /// <param name="Key">The model or agent name.</param>
    /// <param name="Count">Linked misses naming it.</param>
    /// <param name="Share">Its share, as the reference prints it.</param>
    /// <param name="Dominant">The commonest miss class for it, or an em dash.</param>
    private sealed record OriginCountRow(string Key, int Count, string Share, string Dominant);

    /// <summary>One row of the per-miss detail table.</summary>
    /// <param name="MissId">The miss id.</param>
    /// <param name="ReqId">The REQ it was found against.</param>
    /// <param name="MissClass">What kind of miss it was.</param>
    /// <param name="Severity">Owner-visible impact.</param>
    /// <param name="Origin">Origin phase and agent.</param>
    /// <param name="Confidence">The <c>origin_confidence</c> the emitter derived.</param>
    /// <param name="FoundBy">Who or what found it.</param>
    /// <param name="Status">The latest verdict, or <c>open</c>.</param>
    /// <param name="Tokens">Output tokens of the fix window, or an em dash.</param>
    /// <param name="Attribution">The fix's <c>cost_attribution</c>, or empty.</param>
    /// <param name="What">The record's own one sentence, or a statement that it carries none.</param>
    /// <param name="HasWhat">True when the sentence is the owner's own rather than this page's.</param>
    /// <param name="WhoseGap">The <c>sort</c> answer in words, never the raw value.</param>
    /// <param name="HasSort">True when the record carries a recognised <c>sort</c>.</param>
    private sealed record MissRow(
        string MissId,
        string ReqId,
        string MissClass,
        string Severity,
        string Origin,
        string Confidence,
        string FoundBy,
        string Status,
        string Tokens,
        string Attribution,
        string What,
        bool HasWhat,
        string WhoseGap,
        bool HasSort)
    {
        /// <summary>The badge style for the severity — always beside its own word, never colour alone.</summary>
        public BadgeVariant SeverityVariant => Severity switch
        {
            "blocker" => BadgeVariant.Destructive,
            "major" => BadgeVariant.Default,
            _ => BadgeVariant.Secondary
        };

        /// <summary>The badge style for the status — always beside its own word, never colour alone.</summary>
        public BadgeVariant StatusVariant => Status switch
        {
            "Verified" => BadgeVariant.Default,
            MissFigures.WontFixVerdict => BadgeVariant.Secondary,
            _ => BadgeVariant.Outline
        };
    }
}
