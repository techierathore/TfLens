@*
    REQ-UI-034 — tokens per observed model on the Playbook axis.

    The only cross-engine dimension `events.ndjson` carries is `model` (PlaybookWireFields.Model): a turn
    record names the `providerID/modelID` it ran on. These are Playbook events only — no TechieFlow run
    record is in scope — so this table can never pool the two axes (SCHEMA.md §11).

    `docs/mockups/harness-playbook.html` draws this card as a bar row with the value above each bar, so
    that is what `ChartContainer` + `BarChart` render here. The chart is supplementary: every value it
    draws is also a cell of the table above it, which docs/TfLens-UIDesign.md §Library gaps requires of
    every chart in this app independently of what the charting API can do.
*@
@using System.Globalization
@using ApexCharts
@using TrBlazeUI.Components.Chart

@if (Models.Count == 0)
{
    <Empty Title="No model recorded yet"
           Description="No Playbook turn event carries a model field, so there is nothing to total per model."
           Size="EmptySize.Small"
           data-testid="pb-model-tokens-empty">
        <Icon>
            <LucideIcon Name="database" Size="32" />
        </Icon>
    </Empty>
}
else
{
    <div class="tflens-stack">
        <div class="overflow-x-auto">
            <DataTable TData="ModelTokens"
                       Data="@Models"
                       ShowToolbar="false"
                       ShowPagination="false"
                       AriaLabel="Playbook tokens by observed model"
                       data-testid="pb-model-tokens">
                <Columns>
                    <DataTableColumn TData="ModelTokens" TValue="string"
                                     Property="@(aRow => aRow.Model)" Header="model" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="font-mono text-xs">@vRow.Model</span>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="ModelTokens" TValue="long"
                                     Property="@(aRow => aRow.TokensIn)" Header="in" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="tabular-nums">@Tokens(vRow.TokensIn)</span>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="ModelTokens" TValue="long"
                                     Property="@(aRow => aRow.TokensOut)" Header="out" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="tabular-nums">@Tokens(vRow.TokensOut)</span>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="ModelTokens" TValue="long"
                                     Property="@(aRow => aRow.TokensCacheRead)" Header="cache read" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="tabular-nums">@Tokens(vRow.TokensCacheRead)</span>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="ModelTokens" TValue="long"
                                     Property="@(aRow => aRow.TokensCacheWrite)" Header="cache write" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="tabular-nums">@Tokens(vRow.TokensCacheWrite)</span>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="ModelTokens" TValue="long"
                                     Property="@(aRow => aRow.Total)" Header="total" Sortable>
                        <CellTemplate Context="vRow">
                            <span class="font-semibold tabular-nums">@Tokens(vRow.Total)</span>
                        </CellTemplate>
                    </DataTableColumn>
                </Columns>
            </DataTable>
        </div>

        @* `Bare="true"`: this sits inside the caller's `Card`, and the container's own card chrome
           would draw a second bordered panel inside it. *@
        <div class="pb-chart" data-testid="pb-model-tokens-bars">
            <ChartContainer Bare="true">
                @* The `Items`/`XValue`/`YValue` shorthand: since TrBlazeUI 2.0.6 its built-in series
                   carries `ShowDataLabels` (TR-037), so the value above each bar — which the mockup
                   draws — paints. *@
                <BarChart TItem="ModelTokens"
                          Items="@Models"
                          XValue="@(aRow => ShortModel(aRow.Model))"
                          YValue="@(aRow => (decimal?)aRow.Total)"
                          Height="220px"
                          ShowLegend="false"
                          ShowDataLabels="true"
                          Options="@objChartOptions"
                          OptionsConfigurator="@(aOptions => aOptions.DataLabels.Formatter = TokenLabelFormatter)" />
            </ChartContainer>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The JavaScript the bars' value labels are rendered with — the browser-side twin of
    /// <see cref="Tokens"/>.
    /// </summary>
    /// <remarks>
    /// ApexCharts renders its data labels in the browser, so this has to be expressed as JavaScript
    /// rather than as C#. It abbreviates only above a million, where a grouped figure would be too wide
    /// for one bar; below that it prints the same grouped number the table does, because a bar reading
    /// <c>3k</c> over a table row reading <c>2,850</c> looks like two different measurements. The
    /// Playbook axis totals per observed model, which is a smaller figure than the per-harness totals
    /// on the TechieFlow axis, so most bars here fall under that threshold.
    /// </remarks>
    private const string TokenLabelFormatter = """
        function (aValue) {
            if (aValue === null || aValue === undefined) { return ''; }
            var vMagnitude = Math.abs(aValue);
            if (vMagnitude >= 1e9) { return (aValue / 1e9).toFixed(1) + 'B'; }
            if (vMagnitude >= 1e6) { return (aValue / 1e6).toFixed(1) + 'M'; }
            return aValue.toLocaleString('en-US');
        }
        """;

    /// <summary>The per-model token totals the Playbook builder observed, largest first.</summary>
    [Parameter]
    public IReadOnlyList<ModelTokens> Models { get; set; } = [];

    /// <summary>
    /// What this chart sets that <c>BarChart</c>'s own defaults do not.
    /// </summary>
    /// <remarks>
    /// <c>docs/mockups/harness-playbook.html</c> draws no y axis and no gridlines and prints the value
    /// above each bar. Everything left null — the toolbar, the transparent background, the x-axis label
    /// styling, the <c>--chart-1 … --chart-5</c> colour list — the wrapper still fills in.
    /// <c>Distributed</c> gives each model its own colour out of that list, which is how the mockup
    /// paints the row; the rest of the <c>Bar</c> block restates the wrapper's own defaults, because
    /// setting <c>PlotOptions</c> at all means the wrapper no longer supplies them.
    /// </remarks>
    private readonly ApexChartOptions<ModelTokens> objChartOptions = new()
    {
        Grid = new Grid
        {
            Show = false,
            Xaxis = new GridXAxis { Lines = new Lines { Show = false } },
            Yaxis = new GridYAxis { Lines = new Lines { Show = false } }
        },
        Yaxis = [new YAxis { Show = false }],
        DataLabels = new DataLabels
        {
            Enabled = true,
            OffsetY = -20,
            Style = new DataLabelsStyle
            {
                FontSize = "12px",
                FontWeight = "600",
                Colors = ["var(--foreground)"]
            }
        },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                Horizontal = false,
                BorderRadius = 4,
                ColumnWidth = "70%",
                Distributed = true,
                DataLabels = new PlotOptionsBarDataLabels { Position = BarDataLabelPosition.Top }
            }
        }
    };

    /// <summary>
    /// The category a bar is labelled with — the model id without its provider prefix.
    /// </summary>
    /// <remarks>
    /// A wire model reads <c>providerID/modelID</c>, which is too long to sit under a bar. The whole
    /// value is never lost: the table above prints it in full, in its own <c>model</c> column.
    /// </remarks>
    /// <param name="aModel">The model as the events carried it.</param>
    /// <returns>The segment after the last slash, or the whole value when it carries none.</returns>
    private static string ShortModel(string aModel) => aModel.Split('/')[^1];

    /// <summary>
    /// Renders a token count in full, so a bar always has an exact text twin.
    /// </summary>
    /// <param name="aTokens">The token count.</param>
    /// <returns>The grouped number.</returns>
    private static string Tokens(long aTokens) => aTokens.ToString("N0", CultureInfo.InvariantCulture);
}
