    /// <summary>Every miss in the window, folded, one row each.</summary>
    private IReadOnlyList<DetailRow> DetailRows =>
        objReport.Misses
            .OrderByDescending(aMiss => aMiss.Ts, StringComparer.Ordinal)
            .Select(aMiss =>
            {
                var vFix = LatestFix(aMiss);

                return new DetailRow(
                    aMiss.MissId,
                    aMiss.ItemId ?? Missing,
                    aMiss.ReqId ?? Missing,
                    aMiss.MissClass ?? ClassNotRecorded,
                    aMiss.Severity ?? Missing,
