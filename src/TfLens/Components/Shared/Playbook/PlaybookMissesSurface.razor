    private IReadOnlyList<OriginRow> OriginRows
    {
        get
        {
            var vRows = new List<OriginRow>();

            foreach (var vGroup in objReport.Attribution.Attributed
                         .GroupBy(aMiss => aMiss.OriginPhase ?? PhaseNotNamed, StringComparer.Ordinal)
                         .OrderBy(aGroup => aGroup.Key, StringComparer.Ordinal))
            {
                var vCounts = vGroup
                    .GroupBy(aMiss => aMiss.MissClass ?? ClassNotRecorded, StringComparer.Ordinal)
                    .ToDictionary(aInner => aInner.Key, aInner => aInner.Count(), StringComparer.Ordinal);

                var vExecutions = Runs.Count(aRun =>
                    string.Equals(aRun.Cmd, vGroup.Key, StringComparison.Ordinal));

                vRows.Add(new OriginRow(
                    vGroup.Key,
                    vCounts,
                    vGroup.Count(),
                    Runs.Count == 0 ? null : vExecutions,
                    PerHundred(vGroup.Count(), vExecutions)));
