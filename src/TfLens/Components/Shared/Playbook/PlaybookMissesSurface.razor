    /// <summary>The footer that separates "not assessed" from "predates the field" (BRD-166).</summary>
    private string WhyMissedFooter
    {
        get
        {
            var vEligibility = objReport.WhyMissedEligibility;
            var vUnassessed = Math.Max(0, vEligibility.Eligible - vEligibility.Assessed);
            var vSince = vEligibility.Since is { Length: > 0 } vDate ? $" (added {vDate})" : string.Empty;

            var vFloor = vEligibility.PredatesField == 0
                ? $"No miss here predates the field{vSince}."
                : $"A further {vEligibility.PredatesField} predate the field{vSince} and leave this "
                  + "denominator entirely rather than being backfilled with a value nobody assessed at the time.";

            return $"Denominator is {vEligibility.Assessed}, not {MissCount} — the misses that carry the "
                   + "field. why_missed is optional and null means not assessed, never a zero in some "
                   + $"category. Of the {vEligibility.Eligible} eligible to carry it, {vUnassessed} carry "
                   + $"no assessment. {vFloor}";
        }
    }

    /// <summary>The two found-axis distributions, zipped into one table and never summed.</summary>
    private IReadOnlyList<FoundAxisRow> FoundAxisRows
    {
        get
        {
            // The process axis comes off the report, which is the only place it is computed. The
            // assertion axis is counted here and kept in its OWN columns: the report type deliberately
            // has no member that could hold it, because a process gate and an assertion gate are two
            // different measurements and must never share a column (BRD-165).
            var vProcess = objReport.ByFoundPhaseGate;
            var vAssertion = AssertionGateCounts;
            var vRows = new List<FoundAxisRow>();

            for (var vIndex = 0; vIndex < Math.Max(vProcess.Count, vAssertion.Count); vIndex++)
            {
                vRows.Add(new FoundAxisRow(
                    vIndex < vProcess.Count ? vProcess[vIndex].Key : null,
                    vIndex < vProcess.Count ? vProcess[vIndex].Count : null,
                    vIndex < vAssertion.Count ? vAssertion[vIndex].Key : null,
                    vIndex < vAssertion.Count ? vAssertion[vIndex].Value : null));
            }

            return vRows;
        }
    }

    /// <summary>Misses per TechieFlow <b>assertion</b> gate — its own axis, never the process one.</summary>
    private IReadOnlyList<KeyValuePair<string, int>> AssertionGateCounts =>
        objReport.Misses
            .Where(aMiss => !string.IsNullOrEmpty(aMiss.FoundGate))
            .GroupBy(aMiss => aMiss.FoundGate!, StringComparer.Ordinal)
            .OrderByDescending(aGroup => aGroup.Count())
            .ThenBy(aGroup => aGroup.Key, StringComparer.Ordinal)
            .Select(aGroup => new KeyValuePair<string, int>(aGroup.Key, aGroup.Count()))
            .ToList();

    /// <summary>Misses carrying no process gate — a count in its own right, never a bucket.</summary>
    private int NoPhaseGateCount => MissCount - objReport.ByFoundPhaseGate.Sum(aRow => aRow.Count);

    /// <summary>Misses carrying no assertion gate; on this axis that is the normal case.</summary>
    private int NoGateCount => MissCount - AssertionGateCounts.Sum(aRow => aRow.Value);

    /// <summary>Misses carrying no <c>item_id</c>.</summary>
    private int NoItemIdCount => MissCount - objReport.ByItemId.Sum(aRow => aRow.Count);

    /// <summary>Misses by observed origin model, with a per-execution rate where runs exist.</summary>
    private IReadOnlyList<ModelRow> ModelRows =>
        objReport.Attribution.ByOriginModel
            .Select(aRow =>
            {
                var vExecutions = Runs.Count(aRun =>
                    string.Equals(aRun.Model, aRow.Key, StringComparison.Ordinal));

                return new ModelRow(
                    aRow.Key,
                    aRow.Count,
                    Runs.Count == 0 ? null : vExecutions,
                    PerHundred(aRow.Count, vExecutions));
            })
            .ToList();

    /// <summary>
    /// Misses by origin tier, over attributed records only.
    /// </summary>
    /// <remarks>
    /// The tier has no column: it is a producer field the normalizer preserves verbatim in the record's
    /// overflow, exactly as the source window and the data-quality block are. It is read back here under
    /// the same guard the model band uses, so a tier bucket rests on the same eligible set as the band
    /// beside it.
    /// </remarks>
    private IReadOnlyList<TierRow> TierRows
    {
        get
        {
            var vRows = new List<TierRow>();
            var vTiered = objReport.Attribution.Attributed
                .Select(aMiss => (Miss: aMiss, Tier: OverflowText(aMiss.Overflow, OriginTierKey)))
                .Where(aPair => aPair.Tier is not null)
                .ToList();

            foreach (var vGroup in vTiered
                         .GroupBy(aPair => aPair.Tier!, StringComparer.Ordinal)
                         .OrderByDescending(aGroup => aGroup.Count())
                         .ThenBy(aGroup => aGroup.Key, StringComparer.Ordinal))
            {
                var vDominant = vGroup
                    .Where(aPair => aPair.Miss.MissClass is not null)
                    .GroupBy(aPair => aPair.Miss.MissClass!, StringComparer.Ordinal)
                    .OrderByDescending(aInner => aInner.Count())
                    .ThenBy(aInner => aInner.Key, StringComparer.Ordinal)
                    .Select(aInner => aInner.Key)
                    .FirstOrDefault() ?? Missing;

                vRows.Add(new TierRow(
                    vGroup.Key,
                    vGroup.Count(),
                    Share(vGroup.Count(), vTiered.Count),
                    vDominant));
            }

            return vRows;
        }
    }

    /// <summary>Attributed records carrying no tier — stated, never folded into a named tier.</summary>
    private int TierMissing =>
        objReport.Attribution.Attributed.Count(aMiss => OverflowText(aMiss.Overflow, OriginTierKey) is null);

