    /// <summary>Recomputes the report and the lifecycle reads whenever the window changes.</summary>
    protected override void OnParametersSet()
    {
        // Read() folds the amendments itself and then applies the Playbook's own guards, in that order.
        // Nothing on this surface re-derives a guarded figure from the raw records (REQ-NFR-013).
        objReport = PlaybookMissNormalizer.Read(FrameworkNames.Playbook, Misses, Fixes, Amends);
        objFixesByMiss = FixesByMiss(Fixes);

        var vOpen = 0;
        var vClosed = 0;
        var vReopened = 0;
        var vDeclined = 0;
        var vHours = new List<double>();
        var vRework = new List<double>();

        foreach (var vMiss in objReport.Misses)
        {
            var vFixes = FixesFor(vMiss);
            var vLatest = LatestFix(vMiss);
            var vVerdict = vLatest?.VerdictAfter;

            if (vFixes.Count > 0)
            {
                vRework.Add(vFixes.Count);
            }

            if (vFixes.Any(aFix => aFix.Reopened == true))
            {
                vReopened++;
            }

            if (string.Equals(vVerdict, MissFigures.WontFixVerdict, StringComparison.Ordinal))
            {
                vDeclined++;
                continue;
            }

            if (string.Equals(vVerdict, MissFigures.VerifiedVerdict, StringComparison.Ordinal))
            {
                vClosed++;

                if (vLatest is not null && HoursBetween(vMiss.Ts, vLatest.Ts) is { } vElapsed)
                {
                    vHours.Add(vElapsed);
                }

                continue;
            }

            vOpen++;
        }

        Lifecycle = new LifecycleCounts(vOpen, vClosed, vReopened, vDeclined);
        ClosureHours = vHours;
        ReworkCounts = vRework;
    }

    /// <summary>Indexes the fix records by the miss they name.</summary>
    /// <param name="aFixes">The window's fix records.</param>
    /// <returns>The index, keyed by repository and miss id.</returns>
    private static Dictionary<string, List<MissFixRecord>> FixesByMiss(IEnumerable<MissFixRecord> aFixes)
    {
        var vIndex = new Dictionary<string, List<MissFixRecord>>(StringComparer.Ordinal);

        foreach (var vFix in aFixes)
        {
            var vKey = LinkKey(vFix.Repo, vFix.MissId);

            if (!vIndex.TryGetValue(vKey, out var vBucket))
            {
                vBucket = [];
                vIndex[vKey] = vBucket;
            }

            vBucket.Add(vFix);
        }

        return vIndex;
    }

    /// <summary>The fix records that name one miss.</summary>
    /// <param name="aMiss">The miss.</param>
    /// <returns>Its fixes, or an empty list.</returns>
    private IReadOnlyList<MissFixRecord> FixesFor(MissRecord aMiss) =>
        objFixesByMiss.TryGetValue(LinkKey(aMiss.Repo, aMiss.MissId), out var vFixes) ? vFixes : [];

    /// <summary>The latest fix for a miss, by timestamp then by attempt — the same read as the engine's.</summary>
    /// <param name="aMiss">The miss.</param>
    /// <returns>The latest fix, or <c>null</c> when no fix has touched it.</returns>
    private MissFixRecord? LatestFix(MissRecord aMiss) =>
        FixesFor(aMiss)
            .OrderBy(aFix => aFix.Ts, StringComparer.Ordinal)
            .ThenBy(aFix => aFix.FixAttempt ?? 0)
            .LastOrDefault();

    /// <summary>The lifecycle word one miss is in, as the detail table prints it (BRD-120).</summary>
    /// <param name="aMiss">The miss.</param>
    /// <returns>The state word.</returns>
    private string StateOf(MissRecord aMiss)
    {
        var vVerdict = LatestFix(aMiss)?.VerdictAfter;

        if (string.Equals(vVerdict, MissFigures.WontFixVerdict, StringComparison.Ordinal))
        {
            return DeclinedState;
        }

        if (string.Equals(vVerdict, MissFigures.VerifiedVerdict, StringComparison.Ordinal))
        {
            return ClosedState;
        }

        return FixesFor(aMiss).Any(aFix => aFix.Reopened == true) ? ReopenedState : OpenState;
    }

    /// <summary>The origin cell — the phase, or a plain statement that none is named.</summary>
    /// <param name="aMiss">The folded miss.</param>
    /// <returns>The cell text.</returns>
    private static string OriginOf(MissRecord aMiss) => aMiss.OriginPhase ?? PhaseNotNamed;

    /// <summary>The repair-token cell; an unattributable fix shows an em dash, never a zero.</summary>
    /// <param name="aFix">The latest fix, or <c>null</c>.</param>
    /// <returns>The cell text.</returns>
    private static string TokensOf(MissFixRecord? aFix) =>
        aFix?.TokensOut is { } vTokens
            ? vTokens.ToString("N0", CultureInfo.InvariantCulture)
            : Missing;

    /// <summary>The link key, scoped to the repository exactly as the folder scopes it.</summary>
    /// <param name="aRepo"><c>owner/name</c> of the repository.</param>
    /// <param name="aMissId">The miss id, unique only within the app that minted it.</param>
    /// <returns>The composite key.</returns>
    private static string LinkKey(string aRepo, string aMissId) => aRepo + " " + aMissId;

    /// <summary>Hours between two ISO-8601 stamps, or <c>null</c> when either cannot be read.</summary>
    /// <param name="aFrom">The earlier stamp.</param>
    /// <param name="aTo">The later stamp.</param>
    /// <returns>The elapsed hours, or <c>null</c> when the pair cannot be measured.</returns>
    private static double? HoursBetween(string? aFrom, string? aTo)
    {
        if (!DateTimeOffset.TryParse(aFrom, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var vFrom)
            || !DateTimeOffset.TryParse(aTo, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var vTo))
        {
            return null;
        }

        var vHours = (vTo - vFrom).TotalHours;
        return vHours < 0 ? null : vHours;
    }

    /// <summary>The nearest-rank percentile of a sample.</summary>
    /// <param name="aValues">The sample.</param>
    /// <param name="aFraction">The percentile as a fraction, e.g. <c>0.90</c>.</param>
    /// <returns>The value, or <c>null</c> on an empty sample.</returns>
    private static double? Percentile(IReadOnlyList<double> aValues, double aFraction)
    {
        if (aValues.Count == 0)
        {
            return null;
        }

        var vSorted = aValues.OrderBy(aX => aX).ToList();
        var vRank = (int)Math.Ceiling(aFraction * vSorted.Count) - 1;

        return vSorted[Math.Clamp(vRank, 0, vSorted.Count - 1)];
    }

    /// <summary>One point of a duration sample, refused below the minimum-n floor.</summary>
    /// <param name="aValues">The sample, in hours.</param>
    /// <param name="aPointOf">Reads the point — a median or a percentile.</param>
    /// <returns>The figure, or an honest refusal.</returns>
    private static Figure Hours(IReadOnlyList<double> aValues, Func<IReadOnlyList<double>, double?> aPointOf)
    {
        if (aValues.Count == 0)
        {
            return Figure.NotApplicable();
        }

        if (aValues.Count < MetricsConstants.MinN)
        {
            return Figure.InsufficientData(aValues.Count);
        }

        return aPointOf(aValues) is { } vPoint ? Rounded(vPoint, aValues.Count) : Figure.NotApplicable();
    }

    /// <summary>A value rounded to one decimal place, carried with the records behind it.</summary>
    /// <param name="aValue">The value.</param>
    /// <param name="aRecords">The supporting records.</param>
    /// <returns>The figure.</returns>
    private static Figure Rounded(double aValue, int aRecords)
    {
        var vValue = Math.Round(aValue, 1, MidpointRounding.ToEven);
        return Figure.Value(vValue, aRecords, vValue.ToString(CultureInfo.InvariantCulture));
    }

    /// <summary>A percentage share, or an honest refusal — the same three cases the engine uses.</summary>
    /// <param name="aNumerator">The numerator.</param>
    /// <param name="aDenominator">The denominator — the figure's supporting records.</param>
    /// <returns><c>NotApplicable</c> on a zero denominator, <c>InsufficientData</c> below the floor, else the share.</returns>
    private static Figure Share(int aNumerator, int aDenominator)
    {
        if (aDenominator == 0)
        {
            return Figure.NotApplicable();
        }

        return aDenominator < MetricsConstants.MinN
            ? Figure.InsufficientData(aDenominator)
            : Figure.Value(
                100.0 * aNumerator / aDenominator,
                aDenominator,
                MetricsConstants.Pct(aNumerator, aDenominator));
    }

    /// <summary>Misses per hundred executions, or a refusal when there is no denominator to divide by.</summary>
    /// <param name="aMisses">Misses attributed to the key.</param>
    /// <param name="aExecutions">Executions observed for the key.</param>
    /// <returns>The rate, or a figure that cannot be read as a number.</returns>
    private static Figure PerHundred(int aMisses, int aExecutions)
    {
        if (aExecutions == 0)
        {
            return Figure.NotApplicable();
        }

        if (aExecutions < MetricsConstants.MinN)
        {
            return Figure.InsufficientData(aExecutions);
        }

        var vRate = Math.Round(100.0 * aMisses / aExecutions, 1, MidpointRounding.ToEven);
        return Figure.Value(vRate, aExecutions, vRate.ToString(CultureInfo.InvariantCulture));
    }

    /// <summary>The percentage a share bar fills, clamped so a rounding artefact cannot overflow the track.</summary>
    /// <param name="aCount">The bucket's count.</param>
    /// <param name="aDenominator">The distribution's own denominator.</param>
    /// <returns>A value between 0 and 100.</returns>
    private static double SharePercent(int aCount, int aDenominator) =>
        aDenominator <= 0 ? 0d : Math.Clamp(aCount * 100d / aDenominator, 0d, 100d);

    /// <summary>A guard's refusals, rendered as the reader is shown them.</summary>
    /// <param name="aRefusals">The refusals by reason.</param>
    /// <returns>The joined phrase.</returns>
    private static string Refusals(IReadOnlyList<PlaybookGuardRefusal> aRefusals) =>
        string.Join(", ", aRefusals.Select(aRow => $"{aRow.Records} {aRow.Reason}"));

    /// <summary>The parenthesised breakdown beside an exclusion count, or an empty string at zero.</summary>
    /// <param name="aRefusals">The refusals by reason.</param>
    /// <returns>The breakdown, or an empty string.</returns>
    private static string RefusalBreakdown(IReadOnlyList<PlaybookGuardRefusal> aRefusals) =>
        aRefusals.Count == 0 ? string.Empty : " (" + Refusals(aRefusals) + ")";

    /// <summary>The newest timestamp in a stream, or <c>null</c> when it holds none.</summary>
    /// <param name="aStamps">The stream's timestamps.</param>
    /// <returns>The date part of the newest stamp, or <c>null</c>.</returns>
    private static string? Newest(IEnumerable<string?> aStamps)
    {
        var vNewest = aStamps
            .Where(aStamp => !string.IsNullOrEmpty(aStamp))
            .OrderBy(aStamp => aStamp, StringComparer.Ordinal)
            .LastOrDefault();

        return vNewest is null ? null : vNewest.Length >= 10 ? vNewest[..10] : vNewest;
    }

    /// <summary>
    /// Reads one string property out of a record's preserved overflow JSON.
    /// </summary>
    /// <remarks>
    /// Values only for the fields the contract names — SCHEMA.md §9 keeps undocumented payloads off
    /// every screen, and <c>origin_tier</c> is a documented producer field with no column of its own.
    /// </remarks>
    /// <param name="aOverflowJson">The record's overflow JSON, or <c>null</c>.</param>
    /// <param name="aName">The property to read.</param>
    /// <returns>The value, or <c>null</c> when it is absent, blank or unreadable.</returns>
    private static string? OverflowText(string? aOverflowJson, string aName)
    {
        if (string.IsNullOrWhiteSpace(aOverflowJson))
        {
            return null;
        }

        try
        {
            using var vDocument = JsonDocument.Parse(aOverflowJson);

            if (vDocument.RootElement.ValueKind != JsonValueKind.Object
                || !vDocument.RootElement.TryGetProperty(aName, out var vValue)
                || vValue.ValueKind != JsonValueKind.String)
            {
                return null;
            }

            var vText = vValue.GetString();
            return string.IsNullOrWhiteSpace(vText) ? null : vText;
        }
        catch (JsonException)
        {
            // A record TfLens cannot read is a record TfLens cannot vouch for: it falls out of the tier
            // band and is counted as tier-missing, never guessed at.
            return null;
        }
    }

    /// <summary>A count, rendered the way every count on this surface is.</summary>
    /// <param name="aCount">The count.</param>
    /// <returns>The display string.</returns>
    private static string Text(int aCount) => aCount.ToString("N0", CultureInfo.InvariantCulture);

    /// <summary>Keeps a refusal-to-answer from being rendered at headline size.</summary>
    /// <param name="aFigure">The figure about to be rendered.</param>
    /// <returns>The shrinking classes when the figure carries no number, otherwise <c>null</c>.</returns>
    private static string? SmallWhenNoNumber(Figure aFigure) =>
        aFigure.HasValue ? null : "text-base font-normal";

    /// <summary>One band, described for an axis that holds no records yet.</summary>
    /// <param name="Band">The band's name.</param>
    /// <param name="Detail">What it renders once records arrive.</param>
    private sealed record PlannedBand(string Band, string Detail);

    /// <summary>The lifecycle counts, which are four figures and never one (BRD-167).</summary>
    /// <param name="Open">Misses whose latest verdict leaves them outstanding; deferred is inside this.</param>
    /// <param name="Closed">Misses whose latest verdict is <c>Verified</c>.</param>
    /// <param name="Reopened">Misses a later escape re-opened at least once.</param>
    /// <param name="Declined">Misses declined as <c>wont-fix</c> — never folded into open.</param>
    private sealed record LifecycleCounts(int Open, int Closed, int Reopened, int Declined);

    /// <summary>One row of the origin-phase × miss-class cross-tab.</summary>
    /// <param name="Phase">The originating command phase.</param>
    /// <param name="Counts">Misses per miss class.</param>
    /// <param name="Total">Misses attributed to the phase.</param>
    /// <param name="Executions">Executions of that phase in the window, or <c>null</c> when none are held.</param>
    /// <param name="Rate">Misses per hundred executions, or a refusal.</param>
    private sealed record OriginRow(
        string Phase,
        IReadOnlyDictionary<string, int> Counts,
        int Total,
        int? Executions,
        Figure Rate)
    {
        /// <summary>The count in one class column.</summary>
        /// <param name="aClass">The miss class.</param>
        /// <returns>The count, or zero.</returns>
        public int CountOf(string aClass) => Counts.GetValueOrDefault(aClass);
    }

    /// <summary>One row of the failed-practice distribution.</summary>
    /// <param name="Practice">The <c>why_missed</c> value.</param>
    /// <param name="Count">Records carrying it.</param>
    /// <param name="Share">Its share of the assessed denominator, as the engine prints it.</param>
    /// <param name="SharePercent">The same share as a bar width.</param>
    private sealed record PracticeRow(string Practice, int Count, string Share, double SharePercent);

    /// <summary>One row of the two found-axis columns; the halves are independent by design.</summary>
    /// <param name="PhaseGate">The Playbook process gate, or <c>null</c> when that column has run out.</param>
    /// <param name="PhaseGateCount">Misses that process gate caught.</param>
    /// <param name="Gate">The TechieFlow assertion gate, or <c>null</c> when that column has run out.</param>
    /// <param name="GateCount">Misses that assertion gate caught.</param>
    private sealed record FoundAxisRow(string? PhaseGate, int? PhaseGateCount, string? Gate, int? GateCount);

    /// <summary>One row of the origin-model band.</summary>
    /// <param name="Key">The observed model.</param>
    /// <param name="Count">Attributed misses naming it.</param>
    /// <param name="Executions">Executions observed for it, or <c>null</c> when none are held.</param>
    /// <param name="Rate">Misses per hundred executions, or a refusal.</param>
    private sealed record ModelRow(string Key, int Count, int? Executions, Figure Rate);

    /// <summary>One row of the origin-tier band.</summary>
    /// <param name="Key">The tier the producer recorded.</param>
    /// <param name="Count">Attributed misses carrying it.</param>
    /// <param name="Share">Its share of the tiered records, or a refusal.</param>
    /// <param name="Dominant">The commonest miss class for it, or an em dash.</param>
    private sealed record TierRow(string Key, int Count, Figure Share, string Dominant);

    /// <summary>One diagnostic row.</summary>
    /// <param name="Key">The stable id fragment for the row's test id.</param>
    /// <param name="Label">What the row is called.</param>
    /// <param name="Count">How many records it names.</param>
    /// <param name="Note">Why the count exists.</param>
    private sealed record DiagnosticRow(string Key, string Label, int Count, string Note);

    /// <summary>One stream-health row.</summary>
    /// <param name="Kind">The record kind.</param>
    /// <param name="Records">Records held, or <c>null</c> for a stream TfLens never stores.</param>
    /// <param name="Newest">The newest date held, or <c>null</c>.</param>
    private sealed record StreamRow(string Kind, int? Records, string? Newest)
    {
        /// <summary>The record count, or an em dash — absence, never a zero.</summary>
        public string RecordsText =>
            Records is { } vRecords ? vRecords.ToString("N0", CultureInfo.InvariantCulture) : "—";

        /// <summary>The newest date, or an em dash.</summary>
        public string NewestText => Newest ?? "—";

        /// <summary>
        /// What the state badge says.
        /// </summary>
        /// <remarks>
        /// One or two words on purpose. The mockup writes the whole sentence inside the badge, which
        /// wraps into an unreadable pill at 390px; the sentence is carried by the card's footer
        /// instead, where it reads as prose at both widths.
        /// </remarks>
        public string State => Records is null
            ? "transient"
            : Records > 0 ? "imported" : "none held";

        /// <summary>The badge tone, which never reads as a score.</summary>
        public string BadgeClass => Records is > 0 ? "tflens-badge-success" : string.Empty;
    }

    /// <summary>One row of the per-miss detail table.</summary>
    /// <param name="MissId">The miss id.</param>
    /// <param name="ItemId">The Playbook requirement axis.</param>
    /// <param name="ReqId">The TechieFlow requirement axis — empty on a Playbook row.</param>
    /// <param name="MissClass">What kind of miss it was.</param>
    /// <param name="Severity">Owner-visible impact.</param>
    /// <param name="Origin">The originating command phase.</param>
    /// <param name="Confidence">The <c>origin_confidence</c> the emitter derived.</param>
    /// <param name="FoundBy">Who or what found it.</param>
    /// <param name="FoundPhaseGate">The Playbook process gate that caught it.</param>
    /// <param name="State">The lifecycle word.</param>
    /// <param name="Tokens">Output tokens of the repair window, or an em dash.</param>
    /// <param name="Attribution">The fix's <c>cost_attribution</c>, or empty.</param>
    private sealed record DetailRow(
        string MissId,
        string ItemId,
        string ReqId,
        string MissClass,
        string Severity,
        string Origin,
        string Confidence,
        string FoundBy,
        string FoundPhaseGate,
        string State,
        string Tokens,
        string Attribution)
    {
        /// <summary>The badge style for the severity — always beside its own word, never colour alone.</summary>
        public BadgeVariant SeverityVariant => Severity switch
        {
            "blocker" => BadgeVariant.Destructive,
            "major" => BadgeVariant.Default,
            _ => BadgeVariant.Secondary
        };

        /// <summary>The badge style for the lifecycle word — always beside the word itself.</summary>
        public BadgeVariant StateVariant => State switch
        {
            ClosedState => BadgeVariant.Default,
            DeclinedState => BadgeVariant.Secondary,
            _ => BadgeVariant.Outline
        };
    }
}
