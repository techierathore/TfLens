    /// <summary>The execution rows the table shows, after the eleven row-level filters.</summary>
    private IReadOnlyList<PbExecutionRow> FilteredExecutions
    {
        get
        {
            if (objReport is null)
            {
                return [];
            }

            // REQ-FN-099 / BRD-158 — the model filter goes through the report's own WhereModel, which
            // matches ANY models[] member. Filtering on the dominant label would make a mixed-model
            // execution disappear from the very comparison it belongs in.
            var vModel = ValueOf("model");

            var vRows = string.Equals(vModel, AllKey, StringComparison.Ordinal)
                ? objReport.Executions
                : objReport.WhereModel(vModel);

            return vRows.Where(Matches).Select(aView => new PbExecutionRow(aView)).ToList();
        }
    }

    /// <summary>The execution whose detail panel is open, defaulting to the first row shown.</summary>
    private PhaseExecutionView? SelectedExecution
    {
        get
        {
            var vRows = FilteredExecutions;

            return vRows.FirstOrDefault(aRow => string.Equals(
                       aRow.Id, objSelectedExecutionId, StringComparison.Ordinal))?.View
                   ?? vRows.FirstOrDefault()?.View;
        }
    }

