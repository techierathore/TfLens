    /// <summary>The model-mix rows, with token and turn share taken over the same cohort.</summary>
    private IReadOnlyList<ModelRow> ModelRows
    {
        get
        {
            if (objReport is null)
            {
                return [];
            }

            var vModels = objReport.Models;
            var vTokens = vModels.Sum(aModel => aModel.TokensIn + aModel.TokensOut);
            var vTurns = vModels.Sum(aModel => aModel.Turns);

            return vModels
                .Select(aModel => new ModelRow(
                    aModel.Model,
                    vTokens <= 0 ? 0d : (double)(aModel.TokensIn + aModel.TokensOut) / vTokens,
                    vTurns <= 0 ? 0d : (double)aModel.Turns / vTurns,
                    aModel.Executions,
                    aModel.MeasuredCostUsd))
                .OrderByDescending(aRow => aRow.TokenShare)
                .ThenBy(aRow => aRow.Model, StringComparer.Ordinal)
                .ToList();
        }
    }

    /// <summary>
    /// Reads the phase report for the signed-in user, once per user.
    /// </summary>
    /// <returns>A task that completes when the surface knows what state it is in.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (UserId is null)
        {
            objIsLoaded = true;
            return;
        }

        if (objIsLoaded && objLoadedUserId == UserId)
        {
            return;
        }

        objLoadedUserId = UserId;
        await ReloadAsync();
    }

    /// <summary>
    /// Re-reads the report, narrowed to the selected repository when one is chosen.
    /// </summary>
    /// <remarks>
    /// The repository is a query parameter of the engine, never a display filter: narrowing what is
    /// already on screen would leave every cohort count describing the wider set (ADR-016).
    /// </remarks>
    /// <returns>A task that completes when the surface has its figures or its error.</returns>
    private async Task ReloadAsync()
    {
        if (UserId is null)
        {
            objIsLoaded = true;
            return;
        }

        try
        {
            objRepos = await objRepoListReader.ListWithCountsAsync(UserId.Value);

            var vRepo = ValueOf(RepoFilterKey);

            objReport = await objReportBuilder.BuildPhaseReportAsync(
                UserId.Value,
                string.Equals(vRepo, AllKey, StringComparison.Ordinal) ? null : vRepo);

            objLoadError = null;
        }
        catch (Exception vEx)
        {
            objReport = null;
            objLoadError = vEx.Message;
        }
        finally
        {
            objIsLoaded = true;
        }
    }

    /// <summary>
    /// Applies one filter, re-querying the engine only for the repository.
    /// </summary>
    /// <param name="aKey">The filter's key.</param>
    /// <param name="aValue">The chosen option.</param>
    /// <returns>A task that completes when the surface has been updated.</returns>
    private async Task OnFilterChangedAsync(string aKey, string? aValue)
    {
        objFilters[aKey] = string.IsNullOrWhiteSpace(aValue) ? AllKey : aValue;
        objSelectedExecutionId = null;

        if (string.Equals(aKey, RepoFilterKey, StringComparison.Ordinal))
        {
            await ReloadAsync();
        }
    }

    /// <summary>
    /// Clears every filter and re-reads the whole workspace.
    /// </summary>
    /// <returns>A task that completes when the surface has been rebuilt.</returns>
    private async Task ResetFiltersAsync()
    {
        objFilters.Clear();
        objSelectedExecutionId = null;
        await ReloadAsync();
    }

    /// <summary>Opens one execution's detail panel.</summary>
    /// <param name="aExecutionId">The execution to expand.</param>
    private void SelectExecution(string aExecutionId) => objSelectedExecutionId = aExecutionId;

    /// <summary>Tells whether one execution's detail panel is the open one.</summary>
    /// <param name="aExecutionId">The execution id.</param>
    /// <returns><c>true</c> when that row is expanded.</returns>
    private bool IsSelected(string aExecutionId) =>
        string.Equals(SelectedExecution?.PhaseExecutionId, aExecutionId, StringComparison.Ordinal);

    /// <summary>The current value of one filter, defaulting to its "all" option.</summary>
    /// <param name="aKey">The filter's key.</param>
    /// <returns>The chosen option key.</returns>
    private string ValueOf(string aKey) =>
        objFilters.TryGetValue(aKey, out var vValue) ? vValue : AllKey;

    /// <summary>
    /// Builds an option list from the distinct values a column actually carries.
    /// </summary>
    /// <param name="aAllLabel">The label of the leading "all" option.</param>
    /// <param name="aValues">Every observed value, blanks and duplicates included.</param>
    /// <returns>The option list, alphabetically after the "all" option.</returns>
    private static IReadOnlyList<FilterOption> Options(string aAllLabel, IEnumerable<string?> aValues)
    {
        var vOptions = new List<FilterOption> { new(AllKey, aAllLabel) };

        vOptions.AddRange(aValues
            .Where(aValue => !string.IsNullOrWhiteSpace(aValue))
            .Select(aValue => aValue!)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(aValue => aValue, StringComparer.Ordinal)
            .Select(aValue => new FilterOption(aValue, aValue)));

        return vOptions;
    }

    /// <summary>
    /// Judges one execution against the row-level filters.
    /// </summary>
    /// <param name="aView">The execution row.</param>
    /// <returns><c>true</c> when every active filter admits it.</returns>
    private bool Matches(PhaseExecutionView aView) =>
        MatchesText(ValueOf("command-phase"), aView.CommandPhase)
        && MatchesText(ValueOf("project-type"), aView.ProjectType)
        && MatchesText(ValueOf("verdict"), aView.GateVerdictSnapshot)
        && MatchesCompleteness(aView)
        && MatchesCoverage(aView)
        && MatchesFanout(aView)
        && MatchesPeriod(aView);

    /// <summary>Tells whether a text filter admits a value.</summary>
    /// <param name="aFilter">The chosen option key.</param>
    /// <param name="aValue">The row's value.</param>
    /// <returns><c>true</c> when the filter is "all" or the value matches it.</returns>
    private static bool MatchesText(string aFilter, string? aValue) =>
        string.Equals(aFilter, AllKey, StringComparison.Ordinal)
        || string.Equals(aFilter, aValue, StringComparison.Ordinal);

    /// <summary>Tells whether the complete/incomplete filter admits a row.</summary>
    /// <param name="aView">The execution row.</param>
    /// <returns><c>true</c> when the filter admits it.</returns>
    private bool MatchesCompleteness(PhaseExecutionView aView) => ValueOf("completeness") switch
    {
        "complete" => aView.IsComplete == true,
        "incomplete" => aView.IsComplete != true,
        _ => true
    };

    /// <summary>Tells whether the active-coverage filter admits a row.</summary>
    /// <param name="aView">The execution row.</param>
    /// <returns><c>true</c> when the filter admits it.</returns>
    private bool MatchesCoverage(PhaseExecutionView aView) => ValueOf("coverage") switch
    {
        PlaybookPhaseVocabulary.CoverageComplete =>
            string.Equals(aView.ActiveCoverage, PlaybookPhaseVocabulary.CoverageComplete, StringComparison.Ordinal),
        PlaybookPhaseVocabulary.CoveragePartial =>
            string.Equals(aView.ActiveCoverage, PlaybookPhaseVocabulary.CoveragePartial, StringComparison.Ordinal),
        "none" => aView.ActiveCoverage is not PlaybookPhaseVocabulary.CoverageComplete
                                       and not PlaybookPhaseVocabulary.CoveragePartial,
        _ => true
    };

    /// <summary>
    /// Tells whether the has-sub-agents filter admits a row.
    /// </summary>
    /// <remarks>
    /// A window that never read the sub-agent transcripts reports <c>null</c>, not zero, so it is
    /// admitted by neither branch of the filter rather than counted as having none.
    /// </remarks>
    /// <param name="aView">The execution row.</param>
    /// <returns><c>true</c> when the filter admits it.</returns>
    private bool MatchesFanout(PhaseExecutionView aView) => ValueOf("fanout") switch
    {
        "has" => aView.Fanout.Spawned is > 0,
        "none" => aView.Fanout.Spawned == 0,
        _ => true
    };

    /// <summary>Tells whether the date-range filter admits a row; filtering is UTC, only display is local.</summary>
    /// <param name="aView">The execution row.</param>
    /// <returns><c>true</c> when the filter admits it.</returns>
    private bool MatchesPeriod(PhaseExecutionView aView)
    {
        var vPeriod = ValueOf("period");

        if (string.Equals(vPeriod, AllKey, StringComparison.Ordinal)
            || !int.TryParse(vPeriod, NumberStyles.Integer, CultureInfo.InvariantCulture, out var vDays))
        {
            return true;
        }

        return TryUtc(aView.StartedAtUtc, out var vStarted)
               && vStarted >= DateTimeOffset.UtcNow.AddDays(-vDays);
    }

    /// <summary>Parses a stored instant as UTC.</summary>
    /// <param name="aText">The instant text.</param>
    /// <param name="aMoment">The parsed instant.</param>
    /// <returns><c>true</c> when the text parsed.</returns>
    private static bool TryUtc(string? aText, out DateTimeOffset aMoment) =>
        DateTimeOffset.TryParse(
            aText, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out aMoment);

    /// <summary>
    /// Builds one active-versus-wall row for a command phase.
    /// </summary>
    /// <param name="aCommandPhase">The command that ran.</param>
    /// <param name="aViews">Its non-quarantined executions.</param>
    /// <returns>The row, refusing a number wherever the coverage does not support one.</returns>
    private static ActiveRow ActiveRowOf(string aCommandPhase, IReadOnlyList<PhaseExecutionView> aViews)
    {
        var vWallValues = aViews
            .Select(aView => aView.ElapsedMs.TryGetValue(out var vMs) ? vMs : (double?)null)
            .Where(aMs => aMs is not null)
            .Select(aMs => aMs!.Value)
            .ToList();

        var vWall = MetricsConstants.Median(vWallValues) is { } vWallMedian
            ? PhaseValue.Comparative(vWallMedian, vWallValues.Count, DurationText(vWallMedian))
            : PhaseValue.Unavailable();

        var vCompleteValues = aViews
            .Where(aView => string.Equals(
                aView.ActiveCoverage, PlaybookPhaseVocabulary.CoverageComplete, StringComparison.Ordinal))
            .Select(aView => aView.ObservedActiveMs.TryGetValue(out var vMs) ? vMs : (double?)null)
            .Where(aMs => aMs is not null)
            .Select(aMs => aMs!.Value)
            .ToList();

        if (vCompleteValues.Count > 0)
        {
            var vActiveMedian = MetricsConstants.Median(vCompleteValues)!.Value;
            var vActive = PhaseValue.Comparative(
                vActiveMedian, vCompleteValues.Count, DurationText(vActiveMedian));

            var vShare = vWall.TryGetValue(out var vWallMs) && vActive.TryGetValue(out var vActiveMs)
                         && vWallMs > 0d
                ? vActiveMs / vWallMs
                : (double?)null;

            return new ActiveRow(aCommandPhase, vWall, vActive, vActive.Display(), vShare);
        }

        // BRD-156 — partial coverage is a lower bound and never a comparison; each value is at most the
        // true one, so the median of them is at most the true median and may be stated as one.
        var vPartialValues = aViews
            .Where(aView => string.Equals(
                aView.ActiveCoverage, PlaybookPhaseVocabulary.CoveragePartial, StringComparison.Ordinal))
            .Select(aView => aView.ObservedActiveMs.TryGetValue(out var vMs) ? vMs : (double?)null)
            .Where(aMs => aMs is not null)
            .Select(aMs => aMs!.Value)
            .ToList();

        return MetricsConstants.Median(vPartialValues) is { } vPartialMedian
            ? new ActiveRow(
                aCommandPhase,
                vWall,
                null,
                PlaybookPhaseVocabulary.LowerBoundPrefix + DurationText(vPartialMedian),
                null)
            : new ActiveRow(aCommandPhase, vWall, null, Dash, null);
    }

    /// <summary>The key/value rows of the per-model panel.</summary>
    /// <param name="aView">The expanded execution.</param>
    /// <returns>The rows.</returns>
    private static IReadOnlyList<PanelRow> ModelPanelRows(PhaseExecutionView aView) =>
    [
        new("Dominant model label", aView.DominantModelLabel ?? PlaybookPhaseVocabulary.Unavailable),
        new("Turns", aView.Turns?.ToString("N0", CultureInfo.InvariantCulture) ?? Dash),
        new("Input", NullableTokenText(aView.TokensInput)),
        new("Cache read", NullableTokenText(aView.TokensCacheRead)),
        new("Cache write", NullableTokenText(aView.TokensCacheWrite)),
        new("Output", NullableTokenText(aView.TokensOutput)),
        new("Reasoning", NullableTokenText(aView.TokensReasoning)),
        new(PlaybookPhaseVocabulary.ObservedActiveLabel, ActiveTextOf(aView) ?? aView.ObservedActiveMs.Display()),
        new(aView.AssistantElapsed.Label, aView.AssistantElapsed.Text),
        new(aView.ToolElapsed.Label, aView.ToolElapsed.Text),
        new("Measured provider cost", CostTextOf(aView.Cost))
    ];

    /// <summary>
    /// The five data-quality explanations every expanded row carries.
    /// </summary>
    /// <param name="aView">The expanded execution.</param>
    /// <returns>The rows.</returns>
    private static IReadOnlyList<PanelRow> QualityPanelRows(PhaseExecutionView aView) =>
    [
        new("Window completion",
            aView.IsComplete == true
                ? "complete — the window closed and reported an elapsed time"
                : $"incomplete · end_reason {aView.EndReason ?? PlaybookPhaseVocabulary.Unavailable} — a window "
                  + "that ended at EOF has no end timestamp and no elapsed time at all, so it is visible here "
                  + "and absent from every duration figure",
            aView.IsComplete != true),
        new("Active timestamps",
            aView.ActiveCoverage switch
            {
                PlaybookPhaseVocabulary.CoverageComplete =>
                    "complete — every interval in the window was observable",
                PlaybookPhaseVocabulary.CoveragePartial =>
                    "partial — missing assistant or tool timestamps downgrade the figure to an explicit "
                    + "lower bound, and it enters no comparison",
                _ => "unavailable — no observable active interval, so there is no figure at all rather than a zero"
            },
            aView.ActiveCoverage is not PlaybookPhaseVocabulary.CoverageComplete),
        new("Unpaired tools",
            "A tool call with no matching result is excluded from the active-interval union and never "
            + "estimated. The producer publishes the union rather than the components, which is why "
            + "assistant and tool interval sums are shown above as diagnostic text and are never added.",
            false),
        new("Tier",
            "missing — the report's execution view publishes no tier, so this execution leaves every "
            + "per-tier cohort rather than joining a default one",
            true),
        new("Provider cost",
            aView.Cost.Caveat
            ?? $"cost_status: {aView.Cost.Status ?? PlaybookPhaseVocabulary.Unavailable} — provider-reported "
               + "and stored as a fixed-precision decimal. A zero-unverified cost is excluded from every "
               + "measured total and is never shown as free.",
            !aView.Cost.IsMeasured),
        new("Provenance",
            $"token_status {aView.TokenStatus ?? PlaybookPhaseVocabulary.Unavailable} · attempt snapshot "
            + $"{aView.AttemptSnapshot?.ToString(CultureInfo.InvariantCulture) ?? Dash} · verdict snapshot "
            + $"{aView.GateVerdictSnapshot ?? PlaybookPhaseVocabulary.Unavailable} · project type "
            + $"{aView.ProjectType ?? PlaybookPhaseVocabulary.Unavailable}",
            false)
    ];

    /// <summary>
    /// Flattens the session tree in reading order, keeping each session's depth.
    /// </summary>
    /// <remarks>
    /// BRD-159 — a grandchild is emitted beneath its parent and exactly once; the tree the engine built
    /// already places every session in one position, so this walk cannot duplicate one.
    /// </remarks>
    /// <param name="aNodes">The nodes at this level.</param>
    /// <param name="aDepth">How deep they sit.</param>
    /// <returns>The flattened rows.</returns>
    private static IReadOnlyList<TreeRow> Flatten(IReadOnlyList<PhaseSubagentNode> aNodes, int aDepth)
    {
        var vRows = new List<TreeRow>();

        foreach (var vNode in aNodes)
        {
            vRows.Add(new TreeRow(vNode, aDepth));
            vRows.AddRange(Flatten(vNode.Children, aDepth + 1));
        }

        return vRows;
    }

    /// <summary>Tells whether the producer named the child's agent type.</summary>
    /// <param name="aAgent">The agent display string.</param>
    /// <returns><c>true</c> when it is a real name rather than the refusal.</returns>
    private static bool IsNamed(string aAgent) =>
        !string.Equals(aAgent, PlaybookPhaseVocabulary.Unavailable, StringComparison.Ordinal);

    /// <summary>The tree indent for one depth.</summary>
    /// <param name="aDepth">How deep the session sits.</param>
    /// <returns>A CSS padding declaration.</returns>
    private static string IndentCss(int aDepth) =>
        "padding-left:" + (aDepth * 22).ToString(CultureInfo.InvariantCulture) + "px";

    /// <summary>The arrow a nested session carries.</summary>
    /// <param name="aDepth">How deep the session sits.</param>
    /// <returns>The marker, or an empty string at the root.</returns>
    private static string Marker(int aDepth) => aDepth == 0 ? string.Empty : "↳ ";

    /// <summary>The bar's height as a share of the tallest one.</summary>
    /// <param name="aValue">This bar's value.</param>
    /// <param name="aMax">The tallest bar's value.</param>
    /// <returns>A CSS height declaration.</returns>
    private static string BarHeightCss(double aValue, double aMax) =>
        "height:" + (aMax <= 0d ? "0" : (100d * aValue / aMax).ToString("0.##", CultureInfo.InvariantCulture))
        + "%";

    /// <summary>One stacked leg's height inside its bar.</summary>
    /// <param name="aValue">The leg's tokens.</param>
    /// <param name="aTotal">The bar's total.</param>
    /// <returns>A CSS height declaration.</returns>
    private static string LegHeightCss(long aValue, long aTotal) =>
        "height:" + (aTotal <= 0L ? "0" : (100d * aValue / aTotal).ToString("0.##", CultureInfo.InvariantCulture))
        + "%";

    /// <summary>Renders a 0..1 share as a CSS width, invariant so a comma decimal cannot reach the style.</summary>
    /// <param name="aShare">The share, 0..1.</param>
    /// <returns>A CSS width declaration.</returns>
    private static string PercentCss(double aShare) =>
        "width:" + (aShare * 100d).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    /// <summary>Renders a 0..1 share as a whole percentage.</summary>
    /// <param name="aShare">The share, 0..1.</param>
    /// <returns>The percentage text.</returns>
    private static string PercentText(double aShare) =>
        Math.Round(aShare * 100d, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture) + "%";

    /// <summary>Reads a count out of a figure, or zero height when it refuses to be a number.</summary>
    /// <param name="aValue">The figure.</param>
    /// <returns>The number to draw, which is only ever a bar height and never a printed figure.</returns>
    private static double CountOf(PhaseValue aValue) => aValue.TryGetValue(out var vCount) ? vCount : 0d;

    /// <summary>
    /// The caption BRD-161 asks for: this figure's own cohort, then every exclusion beside it.
    /// </summary>
    /// <param name="aFigure">The figure the tile renders.</param>
    /// <returns>The <c>n of N eligible</c> line with the exclusions that produced it.</returns>
    private string CaptionOf(PhaseFigure aFigure)
    {
        if (objReport is null)
        {
            return aFigure.Caption;
        }

        var vExclusions = string.Join(
            " · ", aFigure.Exclusions.Select(aExclusion => $"{aExclusion.Explanation} ({aExclusion.Records})"));

        return $"{aFigure.N} of {objReport.Quality.Records} eligible"
               + (vExclusions.Length == 0 ? string.Empty : " · " + vExclusions);
    }

    /// <summary>
    /// Re-notates a measured duration the way the approved design draws it.
    /// </summary>
    /// <param name="aValue">The figure.</param>
    /// <returns>The duration text, or <c>null</c> when the figure carries no number to re-notate.</returns>
    private static string? DurationOf(PhaseValue aValue) =>
        aValue.TryGetValue(out var vMs) ? DurationText(vMs) : null;

    /// <summary>
    /// The active-time cell of one execution, keeping the producer's lower-bound marker.
    /// </summary>
    /// <remarks>
    /// BRD-156 — a partial-coverage figure is published with the "at least" prefix, and re-notating the
    /// number must not drop it. Unavailable coverage carries no number here and none is invented.
    /// </remarks>
    /// <param name="aView">The execution row.</param>
    /// <returns>The text, or <c>null</c> when there is no measured figure.</returns>
    private static string? ActiveTextOf(PhaseExecutionView aView)
    {
        if (!aView.ObservedActiveMs.TryGetValue(out var vMs))
        {
            return null;
        }

        var vPrefix = string.Equals(
            aView.ActiveCoverage, PlaybookPhaseVocabulary.CoveragePartial, StringComparison.Ordinal)
            ? PlaybookPhaseVocabulary.LowerBoundPrefix
            : string.Empty;

        return vPrefix + DurationText(vMs);
    }

    /// <summary>
    /// One execution's cost cell — the provider's dollars only when they are measured.
    /// </summary>
    /// <remarks>
    /// BRD-160 — anything else prints the producer's status, never <c>$0</c> and never "free". Only the
    /// currency symbol differs from the engine's own rendering; the digits are the engine's.
    /// </remarks>
    /// <param name="aCost">The execution's cost view.</param>
    /// <returns>The cell text.</returns>
    private static string CostTextOf(PhaseCostView aCost) =>
        aCost.IsMeasured && aCost.Usd is not null
            ? aCost.Usd.Value.ToString("C4", Money)
            : aCost.Display();

    /// <summary>Renders a duration in the approved design's notation.</summary>
    /// <param name="aMilliseconds">The duration.</param>
    /// <returns>Text such as <c>11m 20s</c>.</returns>
    private static string DurationText(double aMilliseconds)
    {
        var vSpan = TimeSpan.FromMilliseconds(aMilliseconds);

        if (vSpan.TotalHours >= 1d)
        {
            return $"{(int)vSpan.TotalHours}h {vSpan.Minutes:00}m";
        }

        return vSpan.TotalMinutes >= 1d
            ? $"{(int)vSpan.TotalMinutes}m {vSpan.Seconds:00}s"
            : $"{vSpan.TotalSeconds.ToString("0.#", CultureInfo.InvariantCulture)}s";
    }

    /// <summary>Renders a token count in the approved design's compact notation.</summary>
    /// <param name="aTokens">The count.</param>
    /// <returns>Text such as <c>676.3M</c> or <c>412k</c>.</returns>
    private static string TokenText(long aTokens)
    {
        var vMagnitude = Math.Abs(aTokens);

        if (vMagnitude >= 1_000_000_000L)
        {
            return (aTokens / 1_000_000_000d).ToString("0.0", CultureInfo.InvariantCulture) + "B";
        }

        if (vMagnitude >= 1_000_000L)
        {
            return (aTokens / 1_000_000d).ToString("0.0", CultureInfo.InvariantCulture) + "M";
        }

        return vMagnitude >= 1_000L
            ? (aTokens / 1_000d).ToString("0", CultureInfo.InvariantCulture) + "k"
            : aTokens.ToString("N0", CultureInfo.InvariantCulture);
    }

    /// <summary>Renders a token count the producer may not have carried at all.</summary>
    /// <param name="aTokens">The count, or <c>null</c> when none was reported.</param>
    /// <returns>The compact count, or the dash — never a zero standing in for an absence.</returns>
    private static string NullableTokenText(long? aTokens) => aTokens is null ? Dash : TokenText(aTokens.Value);

    /// <summary>Renders a provider dollar figure, or the dash when none was reported.</summary>
    /// <param name="aUsd">The dollars, or <c>null</c>.</param>
    /// <returns>The formatted amount, or the dash.</returns>
    private static string DollarText(decimal? aUsd) =>
        aUsd is null ? Dash : aUsd.Value.ToString("C4", Money);

    /// <summary>Renders one execution's start instant.</summary>
    /// <param name="aView">The execution row.</param>
    /// <returns>The instant as stored, or the dash.</returns>
    private static string StartedText(PhaseExecutionView aView) =>
        TryUtc(aView.StartedAtUtc, out var vStarted)
            ? vStarted.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
            : Dash;


    /// <summary>One filter and the options it offers.</summary>
    /// <param name="Key">The filter's key, which is also its test id suffix.</param>
    /// <param name="Value">The chosen option key.</param>
    /// <param name="Options">Every option, the "all" one first.</param>
    private sealed record FilterSpec(string Key, string Value, IReadOnlyList<FilterOption> Options)
    {
        /// <summary>The label of one option key, for the closed trigger (TR-020).</summary>
        /// <param name="aValue">The option key.</param>
        /// <returns>The label, or the key when no option carries it.</returns>
        public string LabelOf(string? aValue) =>
            Options.FirstOrDefault(aOption => string.Equals(aOption.Key, aValue, StringComparison.Ordinal))?.Label
            ?? aValue
            ?? string.Empty;
    }

    /// <summary>One option of one filter.</summary>
    /// <param name="Key">The stored value.</param>
    /// <param name="Label">What the reader sees.</param>
    private sealed record FilterOption(string Key, string Label);

    /// <summary>One row of the executions table.</summary>
    /// <param name="View">The engine's own view of the execution.</param>
    private sealed record PbExecutionRow(PhaseExecutionView View)
    {
        /// <summary>The producer's stable id for the execution.</summary>
        public string Id => View.PhaseExecutionId;

        /// <summary>The command that ran.</summary>
        public string CommandPhase => View.CommandPhase ?? PlaybookPhaseVocabulary.Unavailable;

        /// <summary>The start instant, as stored.</summary>
        public string StartedText => PlaybookEffortSurface.StartedText(View);

        /// <summary>The output-token cell, which is the dash when the producer carried none.</summary>
        public string OutTokensText => NullableTokenText(View.TokensOutput);

        /// <summary>The data-quality badge text.</summary>
        public string QualityText
        {
            get
            {
                if (View.IsQuarantined)
                {
                    return "quarantined";
                }

                if (View.IsComplete != true)
                {
                    return "incomplete · " + (View.EndReason ?? PlaybookPhaseVocabulary.Unavailable);
                }

                return string.Equals(
                    View.ActiveCoverage, PlaybookPhaseVocabulary.CoverageComplete, StringComparison.Ordinal)
                    ? "complete"
                    : "active coverage: " + (View.ActiveCoverage ?? PlaybookPhaseVocabulary.Unavailable);
            }
        }

        /// <summary>The reason codes under a quarantined row's badge, or <c>null</c> on a clean row.</summary>
        public string? QualityDetail =>
            View.QuarantineReasons.Count == 0
                ? null
                : string.Join(" · ", View.QuarantineReasons.Select(aReason => aReason.Code));

        /// <summary>Which badge variant the data-quality cell uses.</summary>
        public BadgeVariant QualityVariant
        {
            get
            {
                if (View.IsQuarantined)
                {
                    return BadgeVariant.Destructive;
                }

                return View.IsComplete == true
                       && string.Equals(
                           View.ActiveCoverage,
                           PlaybookPhaseVocabulary.CoverageComplete,
                           StringComparison.Ordinal)
                    ? BadgeVariant.Secondary
                    : BadgeVariant.Outline;
            }
        }
    }

    /// <summary>One bar of the tokens-by-command-phase chart.</summary>
    /// <param name="Group">The engine's command-phase group.</param>
    private sealed record TokenBar(PhaseCommandGroup Group)
    {
        /// <summary>The command that ran.</summary>
        public string CommandPhase => Group.CommandPhase;

        /// <summary>The five legs, in stacking order.</summary>
        public IReadOnlyList<TokenLeg> Legs =>
        [
            new("input", LegOf(Group.Tokens.Input), "pb-leg-1"),
            new("cache read", LegOf(Group.Tokens.CacheRead), "pb-leg-3"),
            new("cache write", LegOf(Group.Tokens.CacheWrite), "pb-leg-4"),
            new("output", LegOf(Group.Tokens.Output), "pb-leg-2"),
            new("reasoning", LegOf(Group.Tokens.Reasoning), "pb-leg-5")
        ];

        /// <summary>The bar's total, which is what its height is drawn from.</summary>
        public long Total => Legs.Sum(aLeg => aLeg.Tokens);

        /// <summary>Reads one leg's tokens, treating a refusal as nothing to draw rather than as a figure.</summary>
        /// <param name="aValue">The leg.</param>
        /// <returns>The tokens, or zero height.</returns>
        private static long LegOf(PhaseValue aValue) => aValue.TryGetValue(out var vTokens) ? (long)vTokens : 0L;
    }

    /// <summary>One stacked leg of a token bar.</summary>
    /// <param name="Label">The leg's name.</param>
    /// <param name="Tokens">Its tokens.</param>
    /// <param name="CssClass">The scoped class carrying its colour.</param>
    private sealed record TokenLeg(string Label, long Tokens, string CssClass);

    /// <summary>One bucket of the duration histogram.</summary>
    /// <param name="Label">The bucket's range.</param>
    /// <param name="Count">Closed windows inside it.</param>
    private sealed record DurationBucket(string Label, int Count);

    /// <summary>One bar of the fan-out chart.</summary>
    /// <param name="Label">The bar's name.</param>
    /// <param name="Count">Its height.</param>
    /// <param name="Text">The figure printed above it, refusals included.</param>
    /// <param name="CssClass">The scoped class carrying its colour.</param>
    private sealed record FanoutBar(string Label, double Count, string Text, string CssClass);

    /// <summary>One bar of the measured-cost chart.</summary>
    /// <param name="Model">The model the dollars belong to.</param>
    /// <param name="Amount">The measured dollars.</param>
    /// <param name="Text">The amount as printed.</param>
    private sealed record CostBar(string Model, double Amount, string Text);

    /// <summary>One row of the active-versus-wall table.</summary>
    /// <param name="CommandPhase">The command that ran.</param>
    /// <param name="Wall">Median wall clock over its closed windows.</param>
    /// <param name="Active">Median active time, or <c>null</c> when the coverage supports no figure.</param>
    /// <param name="ActiveText">What the active cell prints — a figure, a lower bound, or the dash.</param>
    /// <param name="Share">Active as a share of wall clock, only where both are exact.</param>
    private sealed record ActiveRow(
        string CommandPhase,
        PhaseValue Wall,
        PhaseValue? Active,
        string ActiveText,
        double? Share)
    {
        /// <summary>The share cell's text, or the reason there is none.</summary>
        public string ShareText => Share is { } vShare
            ? PercentText(vShare)
            : Active is null
                ? "coverage: " + PlaybookPhaseVocabulary.CoveragePartial + " or unavailable"
                : Dash;
    }

    /// <summary>One row of the model-mix table.</summary>
    /// <param name="Model">The model, exactly as the producer named it.</param>
    /// <param name="TokenShare">Its share of the cohort's tokens, 0..1.</param>
    /// <param name="TurnShare">Its share of the cohort's turns, 0..1.</param>
    /// <param name="Executions">Executions it appeared in.</param>
    /// <param name="CostUsd">Its measured dollars, or <c>null</c> when none were complete.</param>
    private sealed record ModelRow(
        string Model,
        double TokenShare,
        double TurnShare,
        int Executions,
        decimal? CostUsd)
    {
        /// <summary>The token share as a percentage.</summary>
        public string TokenShareText => PercentText(TokenShare);

        /// <summary>The turn share as a percentage.</summary>
        public string TurnShareText => PercentText(TurnShare);

        /// <summary>Whether the model reported any complete dollars.</summary>
        public bool HasCost => CostUsd is not null;

        /// <summary>The measured dollars, or the dash — never a zero standing in for an absence.</summary>
        public string CostText => DollarText(CostUsd);
    }

    /// <summary>One key/value row of a detail panel.</summary>
    /// <param name="Label">The fact's name.</param>
    /// <param name="Text">What the producer reported, or why it reported nothing.</param>
    /// <param name="IsRefused">True when the row states an absence rather than a value.</param>
    private sealed record PanelRow(string Label, string Text, bool IsRefused = false);

    /// <summary>One session of the flattened sub-agent tree.</summary>
    /// <param name="Node">The session.</param>
    /// <param name="Depth">How deep it sits beneath the root.</param>
    private sealed record TreeRow(PhaseSubagentNode Node, int Depth);

    /// <summary>One row of the five-states reference table.</summary>
    /// <param name="Name">The state's name.</param>
    /// <param name="Description">What that state shows.</param>
    /// <param name="ActiveName">The state the page is currently in.</param>
    private sealed record StateRow(string Name, string Description, string ActiveName)
    {
        /// <summary>Whether this is the state the page is in.</summary>
        public bool IsActive => string.Equals(Name, ActiveName, StringComparison.Ordinal);
    }
}
