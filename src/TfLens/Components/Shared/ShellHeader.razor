@*
    The app shell's header — REQ-UI-007, REQ-UI-008, REQ-UI-009, REQ-UI-010.

    Left to right: the sidebar trigger, the "section › page" breadcrumb, the Framework switch (report
    routes only), then a spacer and the right-hand cluster — Sync now with its last-sync badge, the theme
    toggle and the user menu. It wraps rather than overflows at narrow widths, so nothing overlaps or
    leaves the viewport on a phone.

    REQ-UI-010, fixed 2026-08-29: at desktop widths the row must NOT wrap. It did — the six report
    routes render the Framework switch, and trigger (28) + breadcrumb (213) + switch (268) + the
    right-hand cluster (533) + four 12px gaps needs 1090px in the 1024px bar left by the sidebar, so
    the whole right-hand cluster dropped to a second line and the header stood 105px tall against the
    mockups' 64. The breadcrumb is the only genuinely elastic item here, so it is the one that gives:
    it carries `min-width: 0` and its list wraps internally to two lines exactly as
    `docs/mockups/coverage.html` draws it, while the header itself is `nowrap` from 64rem up. Nothing
    is truncated and nothing shrinks below its content on a phone, where wrapping is still correct.
*@
@implements IDisposable
@inject NavigationManager objNavigation

<header class="tflens-header flex min-h-16 flex-wrap items-center gap-3 border-b bg-background px-4 py-2" data-testid="app-header">
    <SidebarTrigger data-testid="sidebar-trigger" />

    <div class="tflens-header-crumb">
        <Breadcrumb>
            <BreadcrumbList>
                <BreadcrumbItem>
                    <span class="text-muted-foreground">@Section</span>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem>
                    <BreadcrumbPage>@Page</BreadcrumbPage>
                </BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>
    </div>

    @if (ShowsFrameworkSwitch)
    {
        <FrameworkSwitch />
    }

    <div class="tflens-header-spacer flex-1"></div>

    <div class="tflens-header-right flex items-center gap-3">
        <SyncNowButton UserId="@UserId" />
        <ThemeToggle TestId="theme-toggle" Id="header-theme-toggle" />
        <UserMenu DisplayName="@DisplayName" Email="@Email" Initials="@Initials" />
    </div>
</header>

@code {
    private string objRelativePath = string.Empty;

    /// <summary>The signed-in user id, handed down so the header's controls agree on the user.</summary>
    [Parameter]
    public int? UserId { get; set; }

    /// <summary>The signed-in user's display name.</summary>
    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    /// <summary>The signed-in user's email.</summary>
    [Parameter]
    public string Email { get; set; } = string.Empty;

    /// <summary>The signed-in user's avatar initials.</summary>
    [Parameter]
    public string Initials { get; set; } = "?";

    /// <summary>The breadcrumb's section, from the current route.</summary>
    private string Section => ShellNavigation.Breadcrumb(objRelativePath).Section;

    /// <summary>The breadcrumb's page, from the current route.</summary>
    private string Page => ShellNavigation.Breadcrumb(objRelativePath).Page;

    /// <summary>True on the five report routes, where the Framework switch belongs (REQ-UI-010).</summary>
    private bool ShowsFrameworkSwitch => ShellNavigation.ShowsFrameworkSwitch(objRelativePath);

    /// <summary>Tracks the route so the breadcrumb and the Framework switch follow navigation.</summary>
    protected override void OnInitialized()
    {
        objRelativePath = objNavigation.ToBaseRelativePath(objNavigation.Uri);
        objNavigation.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// Re-reads the route when the user navigates.
    /// </summary>
    /// <param name="aSender">The navigation manager.</param>
    /// <param name="aArgs">The new location.</param>
    private void OnLocationChanged(object? aSender, LocationChangedEventArgs aArgs)
    {
        objRelativePath = objNavigation.ToBaseRelativePath(aArgs.Location);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Unsubscribes so the circuit does not leak a handler per navigation.</summary>
    public void Dispose()
    {
        objNavigation.LocationChanged -= OnLocationChanged;
    }
}
