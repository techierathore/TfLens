@*
    REQ-UI-008 — the header user menu.

    The only sign-out control in the app: there is deliberately no bare sign-out button anywhere else.
    The trigger is the avatar's initials + display name + a chevron; the menu carries the email as its
    label, then Profile, Manage repos, a separator and Sign out.
*@

<DropdownMenu>
    <DropdownMenuTrigger AsChild="true">
        <Button Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Small"
                Class="gap-2"
                AriaLabel="Account menu"
                data-testid="user-menu">
            <Avatar Size="AvatarSize.Small">
                <AvatarFallback>@Initials</AvatarFallback>
            </Avatar>
            <span class="hidden md:flex" data-testid="user-menu-name">@DisplayName</span>
            <LucideIcon Name="chevron-down" Size="14" />
        </Button>
    </DropdownMenuTrigger>
    <DropdownMenuContent Align="PopoverAlign.End" Class="min-w-[12rem]">
        <div data-testid="user-menu-content">
            <DropdownMenuLabel>
                <span class="text-xs font-normal text-muted-foreground" data-testid="user-menu-email">@Email</span>
            </DropdownMenuLabel>
            <DropdownMenuItem OnClick="@(() => NavigateTo("/profile"))">
                <span class="flex items-center gap-2" data-testid="user-menu-profile">
                    <LucideIcon Name="user" Size="16" />
                    Profile
                </span>
            </DropdownMenuItem>
            <DropdownMenuItem OnClick="@(() => NavigateTo("/repos"))">
                <span class="flex items-center gap-2" data-testid="user-menu-repos">
                    <LucideIcon Name="git-branch" Size="16" />
                    Manage repos
                </span>
            </DropdownMenuItem>
            <DropdownMenuSeparator />
            <DropdownMenuItem OnClick="OnSignOutAsync">
                <span class="flex items-center gap-2" data-testid="user-menu-signout">
                    <LucideIcon Name="log-out" Size="16" />
                    Sign out
                </span>
            </DropdownMenuItem>
        </div>
    </DropdownMenuContent>
</DropdownMenu>

@* Sign-out has to be a POST to a real HTTP endpoint: the auth cookie can only be cleared on a real
   response, which an interactive circuit does not have. It is a POST rather than a GET so it carries
   the antiforgery token — a GET sign-out can be triggered by any third-party page embedding
   <img src="/signout">, which would log the user out unbidden. The form is hidden and submitted from
   the menu item. *@
<form id="@SignOutFormId" method="post" action="/auth/logout" class="hidden">
    <AntiforgeryToken />
</form>

@code {
    /// <summary>The signed-in user's display name, shown beside the avatar.</summary>
    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    /// <summary>The signed-in user's email, shown as the menu's label.</summary>
    [Parameter]
    public string Email { get; set; } = string.Empty;

    /// <summary>The avatar's initials.</summary>
    [Parameter]
    public string Initials { get; set; } = "?";

    [Inject]
    private NavigationManager objNavigation { get; set; } = default!;

    /// <summary>
    /// Navigates to one of the two in-app menu destinations.
    /// </summary>
    /// <param name="aHref">The route to open.</param>
    private void NavigateTo(string aHref) => objNavigation.NavigateTo(aHref);

    [Inject]
    private IJSRuntime objJsRuntime { get; set; } = default!;

    /// <summary>Id of the hidden form posted to the sign-out endpoint.</summary>
    private const string SignOutFormId = "tf-signout-form";

    /// <summary>
    /// Signs the user out by posting the hidden form to <c>/auth/logout</c>.
    /// </summary>
    /// <remarks>
    /// This previously navigated to <c>/signout</c>, which nothing ever mapped — only
    /// <c>POST /auth/logout</c> exists. The user was sent to a dead route, the cookie survived, and they
    /// stayed signed in; because this is the only sign-out control in the app, sign-out did not work at
    /// all. Posting the real form calls <c>AuthService.SignOutAsync</c>, which revokes the AppManager
    /// refresh token, deletes the server-side session row and clears the cookie.
    /// </remarks>
    /// <returns>A task that completes once the browser has been told to post.</returns>
    private async Task OnSignOutAsync() =>
        await objJsRuntime.InvokeVoidAsync("tflens.submitForm", SignOutFormId);
}
