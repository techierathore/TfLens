@*
    One KPI tile — the "StatTile" the UI design calls for.

    TrBlazeUI 2.0.0 (the latest published package) does not ship Components/Stat, so this reproduces
    the documented StatTile shape on the library's own Card composition — see TR-001 in
    docs/TfLens-TrBlazeUI-Feedback.md. Drop this shim the moment the library ships the real one.
*@

<Card Class="@CardClass" @attributes="AdditionalAttributes">
    <CardHeader Class="flex flex-row items-center justify-between gap-2 pb-2">
        <span class="tflens-stat-title">
            <CardTitle Class="text-sm font-medium text-muted-foreground">@Title</CardTitle>
            @if (TitleAdornment is not null)
            {
                @TitleAdornment
            }
        </span>
        @if (!string.IsNullOrWhiteSpace(IconName))
        {
            <span class="tflens-stat-chip @AccentClass">
                <LucideIcon Name="@IconName" Size="16" />
            </span>
        }
    </CardHeader>
    <CardContent Class="pt-0">
        <div class="text-2xl font-bold tracking-tight tabular-nums" data-slot="stat-value">
            @if (ValueContent is not null)
            {
                @ValueContent
            }
            else
            {
                @Value
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Description) || DescriptionContent is not null)
        {
            <p class="mt-1 text-xs text-muted-foreground">
                @if (DescriptionContent is not null)
                {
                    @DescriptionContent
                }
                else
                {
                    @Description
                }
            </p>
        }
        @if (Sparkline is { Count: > 1 })
        {
            @* The mockups put a small trend line in every KPI tile (UI Design §Design system:
               "A small trend line uses --chart-1 colour"). It was missing from every tile on every
               page, which is a large part of why the built screens read as flatter than the design.
               It is decoration, not a figure: no axis, no value, and it is omitted entirely rather
               than drawn flat when there are fewer than two points to plot. *@
            <svg class="tflens-spark @AccentClass" viewBox="0 0 100 24" preserveAspectRatio="none"
                 role="img" aria-label="@SparklineLabel" data-testid="stat-sparkline"
                 data-points="@Sparkline.Count" focusable="false">
                <title>@SparklineLabel</title>
                <polyline points="@SparkPoints" fill="none" stroke="currentColor"
                          stroke-width="1.6" vector-effect="non-scaling-stroke"
                          stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        }
    </CardContent>
</Card>

@code {
    /// <summary>The metric's name, shown small above the value.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>The headline value, rendered large.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Optional content rendered beside the title — a provenance badge, never a second figure.
    /// </summary>
    /// <remarks>
    /// Added 2026-08-29 for REQ-UI-036, whose mockup puts an `opencode · measured` badge on the face of
    /// the one tile carrying measured dollars. A tile whose number means something different from its
    /// neighbours has to say so where the number is read, not only in the description below it.
    /// </remarks>
    [Parameter]
    public RenderFragment? TitleAdornment { get; set; }

    /// <summary>A rich headline value, used instead of <see cref="Value"/> when supplied.</summary>
    [Parameter]
    public RenderFragment? ValueContent { get; set; }

    /// <summary>The muted sub-line under the value.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>A rich sub-line, used instead of <see cref="Description"/> when supplied.</summary>
    [Parameter]
    public RenderFragment? DescriptionContent { get; set; }

    /// <summary>Lucide icon name shown in the tile's accent chip, kebab-case.</summary>
    [Parameter]
    public string? IconName { get; set; }

    /// <summary>Which chart colour the accent chip uses.</summary>
    [Parameter]
    public StatAccent Accent { get; set; } = StatAccent.Chart1;

    /// <summary>
    /// Optional trend points for the tile's sparkline, oldest first.
    /// </summary>
    /// <remarks>
    /// Purely decorative — the tile states its figure in text and the sparkline carries no axis and no
    /// label, so it can never be read as a number. Fewer than two points renders nothing at all rather
    /// than a misleading flat line.
    /// </remarks>
    [Parameter]
    public IReadOnlyList<double>? Sparkline { get; set; }

    /// <summary>
    /// A sentence naming exactly what the sparkline plots, e.g. "gates records per day, last 14 days".
    /// </summary>
    /// <remarks>
    /// Required whenever <see cref="Sparkline"/> is supplied, and surfaced as both the SVG title and its
    /// accessible label. An unlabelled trend line invites the reader to assume it tracks the headline
    /// figure; saying what it actually counts is what keeps it honest.
    /// </remarks>
    [Parameter]
    public string? SparklineLabel { get; set; }

    /// <summary>Anything else the caller sets — <c>data-testid</c> above all — lands on the card.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>How many columns the enclosing <c>StatGroup</c> shows; zero when the tile stands alone.</summary>
    [CascadingParameter(Name = "StatGroupColumns")]
    private int GroupColumns { get; set; }

    /// <summary>Extra classes for the tile's card — used to ring the one measured tile (REQ-UI-036).</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>The card's classes — full height, plus its responsive span inside a StatGroup.</summary>
    private string CardClass
    {
        get
        {
            var vSpan = GroupColumns switch
            {
                0 => "h-full",
                <= 2 => "h-full trblazeui-col-12 trblazeui-col-md-6",
                3 => "h-full trblazeui-col-12 trblazeui-col-md-4",
                _ => "h-full trblazeui-col-12 trblazeui-col-md-6 trblazeui-col-lg-3"
            };

            return string.IsNullOrWhiteSpace(Class) ? vSpan : $"{vSpan} {Class}";
        }
    }

    /// <summary>
    /// The sparkline polyline, normalised into the 100&#215;24 viewBox.
    /// </summary>
    /// <remarks>A flat series is drawn along the middle rather than divided by a zero range.</remarks>
    private string SparkPoints
    {
        get
        {
            var vPoints = Sparkline!;
            var vMin = vPoints.Min();
            var vRange = vPoints.Max() - vMin;
            var vStep = 100d / (vPoints.Count - 1);

            return string.Join(' ', vPoints.Select((aValue, aIndex) =>
            {
                var vX = (aIndex * vStep).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                var vNormalised = vRange <= 0 ? 0.5d : (aValue - vMin) / vRange;
                // SVG y grows downward, so the highest value must sit nearest the top.
                var vY = (22d - (vNormalised * 20d)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                return $"{vX},{vY}";
            }));
        }
    }

    /// <summary>The scoped class carrying the accent colour for the chip.</summary>
    private string AccentClass => Accent switch
    {
        StatAccent.Chart2 => "tflens-accent-2",
        StatAccent.Chart3 => "tflens-accent-3",
        StatAccent.Chart4 => "tflens-accent-4",
        StatAccent.Chart5 => "tflens-accent-5",
        StatAccent.Destructive => "tflens-accent-danger",
        _ => "tflens-accent-1"
    };
}
