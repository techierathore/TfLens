# ============================================================================================
# DEPLOYMENT ONLY — this file is read by `docker compose`, NOT by TfLens.
#
# There is no .env loader in Program.cs. `dotnet run` and Visual Studio F5 never open this file,
# so editing it does nothing for local development.
#
#   Local development (F5 / dotnet run)  ->  USER SECRETS  (including TfLens:DbConnection, which
#                                            has NO default — point it at your own PostgreSQL server)
#       Visual Studio: right-click the TfLens project > Manage User Secrets
#       Shell:         dotnet user-secrets set "TfLens:AppManagerApiKey" "..." --project src/TfLens
#       Template:      src/TfLens/secrets.example.json
#       See docs/TfLens-DevGuide.md "Running TfLens locally".
#
#   Deployment (docker compose)          ->  THIS FILE
#       Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# The one value needed even for a local `docker compose up -d postgres` is TfLensDbPassword:
# Compose interpolates it into the postgres service before any container starts, and Compose can
# only read it from here or the shell — it cannot read secrets.json.
#
# Every name is PascalCase with no separators (Coding Standards §Environment Variables).
# ============================================================================================

# Required for `docker compose` ONLY. PostgreSQL password for the compose `postgres` service, which
# Compose interpolates into BOTH that service and the app's TfLensDbConnection, so the two always agree.
#
# This has nothing to do with local development any more (changed 2026-08-29). TfLens no longer carries
# a fallback connection string in source: `dotnet run` / F5 read TfLens:DbConnection from USER SECRETS
# and refuse to start without it. Point that at whatever PostgreSQL server you already run — TfLens
# does not start a database for you and no longer assumes one.
TfLensDbPassword=tflensdev   # NFR-003-OK: not a secret — the throwaway credential for a container published on 127.0.0.1 by docker-compose.override.yml, used only when you run the full stack with `docker compose up`.

# Optional pair. AppManager resolves the application from the `applicationId` in every request body,
# so these may be left unset — but they must be supplied WHOLE or not at all: a key without its
# secret is rejected with INVALID_API_KEY on every call.
TfLensAppManagerApiKey=
TfLensAppManagerApiSecret=

# Optional. Raises the GitHub rate limit from 60/hour to 5,000/hour. Grants no extra repo access.
TfLensGitHubToken=

# Non-secret overrides.
TfLensAppManagerBaseUrl=https://appmgrapi.techierathore.com
TfLensPollIntervalMinutes=15
TfLensHostPort=8080
