# TfLens local/compose settings. Copy to `.env` and fill in — `.env` is never committed.
# Every name is PascalCase with no separators (Coding Standards §Environment Variables).

# Required. PostgreSQL password used by the compose `postgres` service and the connection string.
TfLensDbPassword=change-me

# Optional pair. AppManager resolves the application from the `applicationId` in every request body,
# so these may be left unset — but they must be supplied WHOLE or not at all: a key without its
# secret is rejected with INVALID_API_KEY on every call.
TfLensAppManagerApiKey=
TfLensAppManagerApiSecret=

# Optional. Raises the GitHub rate limit from 60/hour to 5,000/hour. Grants no extra repo access.
TfLensGitHubToken=

# Non-secret overrides.
TfLensAppManagerBaseUrl=https://appmgrapi.techierathore.com
TfLensPollIntervalMinutes=15
TfLensHostPort=8080
