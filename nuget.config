<?xml version="1.0" encoding="utf-8"?>
<!--
  TfLens package sources.

  ============================================================================
  NO CREDENTIALS ARE COMMITTED IN THIS FILE. Do not add any. (REQ-NFR-025)
  ============================================================================
  Anything placed in <packageSourceCredentials> here is published to every
  clone and every fork of this repository.

  TrBlazeUI comes from the owner's PRIVATE GitHub Packages feed, the same as
  every other techierathore application (TechieBlog's NuGet.Config is the
  pattern); nuget.org is for external packages. Restored from the GitHub feed
  again since 2026-09-15 (TrBlazeUI 2.0.7).

  To restore on your machine, store YOUR OWN token in your USER-level NuGet
  config, which lives outside the repository and merges with this file. The
  source name must be TrBlazeUI so the credential matches the entry below:

      dotnet nuget add source https://nuget.pkg.github.com/techierathore/index.json
        with the options: name TrBlazeUI, username (your GitHub username),
        password (a PAT with read:packages), and store-password-in-clear-text.
        Each option takes the usual double-dash prefix, which cannot be written
        literally here because XML forbids a double dash inside a comment.

  The Docker image does NOT read this file. The Dockerfile writes a throwaway
  config from the nuget_pat BuildKit secret, which the deploy workflow fills
  from the TrBlazeUiPackagesToken repository secret.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="TrBlazeUI" value="https://nuget.pkg.github.com/techierathore/index.json" />
  </packageSources>
</configuration>
